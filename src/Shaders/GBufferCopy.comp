#version 450

// task_manager/mrt-1 campaign, PHASE4 - the "GBufferValidation" debug
// tool's own "second pass reads one of the N outputs back" half (proving
// a later pass reading one of N MRT outputs is barrier-synchronized
// automatically, cross-pass, with zero new barrier code - see
// PHASE4_GBUFFER_VALIDATION_PASS_AND_SHADER.md). A deliberately TRIVIAL
// compute copy (imageLoad-via-sampler -> imageStore, no actual processing)
// - mirrors Shaders/BoxBlur.comp's own "deliberately simple, non-
// production" scope exactly, just doing a copy instead of a blur.
//
// Binding convention (see Vulkan/DescriptorSetLayoutBuilder.h): binding 0
// is the read-only Texture (GBufferAlbedo) input, binding 1 is the
// RWTexture (GBufferVisualized) output - MUST match
// src/Editor/GBufferValidation.cpp's own DescriptorSetLayoutBuilder calls
// exactly.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D srcAlbedo;
layout(binding = 1, rgba8) uniform writeonly image2D dstVisualized;

layout(push_constant) uniform PushConstants {
    uint width;
    uint height;
} pc;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(pc.width) || coord.y >= int(pc.height)) {
        return;
    }
    vec2 uv = (vec2(coord) + 0.5) / vec2(float(pc.width), float(pc.height));
    vec4 color = texture(srcAlbedo, uv);
    imageStore(dstVisualized, coord, color);
}
