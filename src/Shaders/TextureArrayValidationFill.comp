#version 450

// task_manager/better-render-pass-7 campaign (better-render-pass-3 campaign,
// BLOCK5 - Array/Cubemap Texture Resources), PHASE5
// (PHASE5_MANUAL_TIER2_VERIFICATION_AND_LIVE_SMOKE_TEST.md) - Pass A of
// src/Editor/TextureArrayValidation.h/.cpp: writes 4 distinct solid colors
// into the 4 layers of a real, pooled TextureArray resource
// ("ManualVerifyArray") - proves a compute shader can imageStore into a
// specific array layer, and that all 4 layers are genuinely distinct,
// non-aliased memory (not a Tier-1 automated test - a manual/Tier-2 live
// smoke test only, per the source document's own Section 6 item 2).
//
// Binding convention: binding 0 is the RWTexture2DArray output
// ("ManualVerifyArray") - a single dispatch covers the whole 64x64x4
// volume, one invocation per (x, y, layer) triple, with
// gl_GlobalInvocationID.z selecting which layer (and therefore which solid
// color) this invocation writes.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2DArray dstArray;

void main()
{
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    ivec3 size = imageSize(dstArray);
    if (coord.x >= size.x || coord.y >= size.y || coord.z >= size.z) {
        // The dispatch's own ceiling-division group count can legitimately
        // cover more threads than there are real texels/layers - see
        // ComputeDispatch.h's own header comment. Those extra invocations
        // simply do nothing.
        return;
    }

    vec4 color;
    if (coord.z == 0) {
        color = vec4(1.0, 0.0, 0.0, 1.0); // layer 0: red
    } else if (coord.z == 1) {
        color = vec4(0.0, 1.0, 0.0, 1.0); // layer 1: green
    } else if (coord.z == 2) {
        color = vec4(0.0, 0.0, 1.0, 1.0); // layer 2: blue
    } else {
        color = vec4(1.0, 1.0, 0.0, 1.0); // layer 3: yellow
    }

    imageStore(dstArray, coord, color);
}
