#version 450

// task_manager/better-render-pass-7 campaign (better-render-pass-3 campaign,
// BLOCK5 - Array/Cubemap Texture Resources), PHASE5
// (PHASE5_MANUAL_TIER2_VERIFICATION_AND_LIVE_SMOKE_TEST.md) - Pass B of
// src/Editor/TextureArrayValidation.h/.cpp: copies ONE layer of the
// "ManualVerifyArray" TextureArray into a plain, separately registered 2D
// RenderTexture output, so it becomes GET /get_texture-capturable with zero
// further networking changes - TextureArray itself can NEVER be fetched that
// way directly (no RenderGraphDebugTextureRegistry counterpart exists for
// that kind, a locked MVP decision - see AGENTS.md's "Named Texture Capture"
// and this phase's own strategy document). Mirrors
// AtmosphereAerialPerspectiveVolumeDebugSlice.comp's own CONFIRMED precedent
// for "extract one slice of a multi-layer GPU image into a plain 2D
// texture", adapted for a 2D array (image2DArray/imageLoad) instead of a
// true 3D volume (sampler3D/texture()).
//
// Binding convention: binding 0 is the READ-ONLY TextureArray input (bound
// as a storage image, not a combined image sampler - RenderGraph's own
// PassContext::resolveTextureArray() exposes no sampler for a pooled
// TextureArray today, see RenderGraph.h's own doc comment - a raw texel
// fetch via imageLoad is sufficient here anyway, since every layer this
// harness ever produces is a flat solid color with nothing to filter),
// binding 1 is the output image2D.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0, rgba8) uniform readonly image2DArray srcArray;
layout(binding = 1, rgba8) uniform writeonly image2D dstLayer;

layout(push_constant) uniform PushConstants {
    uint layerIndex;
} pc;

void main()
{
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 destSize = imageSize(dstLayer);
    if (coord.x >= destSize.x || coord.y >= destSize.y) {
        // The dispatch's own ceiling-division group count can legitimately
        // cover more threads than there are real texels - see
        // ComputeDispatch.h's own header comment. Those extra invocations
        // simply do nothing.
        return;
    }

    vec4 color = imageLoad(srcArray, ivec3(coord, int(pc.layerIndex)));
    imageStore(dstLayer, coord, color);
}
