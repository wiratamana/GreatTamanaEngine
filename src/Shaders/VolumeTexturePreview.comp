#version 450

// network-impl-6 campaign, Phase 3
// (task_manager/network-impl-6/PHASE3_VOLUME_RAYMARCH_PREVIEW_RENDERER.md) -
// the "Volume mode" raymarch preview Unity's own Texture3D inspector uses,
// built for an LLM/AI agent fetching it over HTTP (GET /get_texture) rather
// than a human-facing Editor panel - see PHASE0_MASTER_STRATEGY.md for the
// full campaign writeup. One invocation per output pixel; front-to-back
// alpha-composited raymarch through a fixed-camera, origin-centered proxy
// box (see src/Renderer/VolumeTexturePreviewMath.h - the CPU oracle this
// shader's own IntersectRayBox() below must always be checked BY HAND
// against, mirroring AtmosphereMath.h's own "CPU oracle is right by
// definition" rule - see AGENTS.md, "Atmosphere Scattering").
//
// atmosphere-scattering-2 campaign, Phase 4
// (task_manager/atmosphere-scattering-2/PHASE4_ATMOSPHERE_AWARE_VOLUME_DEBUG_PREVIEW.md)
// - `pc.interpretationMode` selects between this shader's original, generic
// "alpha = density, rgb = color" interpretation (mode 0, UNCHANGED default
// behavior for every non-atmosphere volume) and a second, atmosphere-aware
// interpretation (mode 1, auto-selected server-side by
// Application.cpp based on the requested texture_name) specifically for the
// Aerial Perspective volume: its `alpha` is TRANSMITTANCE (how much light
// SURVIVES - the opposite polarity of a density) and its `rgb` is raw HDR
// in-scattered luminance (tiny; needs exposure + tonemap to be legible at
// all) - see main()'s own branch below for the exact math.
//
// BINDING CONVENTION (matches
// src/Renderer/VolumeTexturePreviewRenderer.cpp exactly - see
// Vulkan/DescriptorSetLayoutBuilder.h's own documented "read-only Texture
// first, RWTexture output last" ordering): binding 0 = the live volume
// texture (read-only combined image sampler), binding 1 = the persistent
// 256x256 RGBA8 output image.
//
// local_size_x/y = 16 - matches this codebase's other 2D-output compute
// passes (e.g. src/Shaders/AtmosphereAerialPerspectiveVolumeDebugSlice.comp)
// - MUST match VolumeTexturePreviewRenderer.h's own kLocalSizeX/kLocalSizeY
// constants exactly.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler3D volumeTex;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// MUST match VolumeTexturePreviewRenderer.cpp's own PushConstants struct -
// every vec3 starts at a 16-byte-aligned offset, std140-style (see that
// file's own doc comment). `interpretationMode`/`aerialPreviewExposure` were
// appended at the tail by atmosphere-scattering-2's Phase 4 - every field
// above them keeps its exact pre-Phase-4 offset.
layout(push_constant) uniform PushConstants {
    vec3 eyePosition;
    float tanHalfFovY;
    vec3 forward;
    float densityScale;
    vec3 right;
    int stepCount;
    vec3 up;
    float _padding0;
    vec3 boxHalfExtents;
    float _padding1;
    int interpretationMode;
    float aerialPreviewExposure;
    int shapeMode; // 0 = box (IntersectRayBox), 1 = frustum (IntersectRayFrustum) - atmosphere-scattering-3, Phase 3.
} pc;

// Dark gray, so white/bright smoke-like content stays readable - the
// how-to reference material's own recommendation
// (task_manager/network-impl-6/how-to-instruction.txt).
const vec3 kBackgroundColor = vec3(0.2, 0.2, 0.2);

// A direct GLSL transcription of VolumeTexturePreviewMath.cpp's own
// IntersectRayBox() (the CPU oracle) - box centered at the origin,
// boxMin = -boxHalfExtents, boxMax = +boxHalfExtents. Deliberately NOT
// epsilon-guarded against a zero ray-direction component (relies on
// IEEE-754 1.0/0.0 == +inf behaving correctly in the min/max slab logic
// below, exactly like the CPU oracle) - if this GLSL ever disagrees with
// the CPU oracle, THIS is what needs fixing, never the reverse (see
// AGENTS.md, "Atmosphere Scattering", for the identical precedent this
// rule is modeled on).
bool IntersectRayBox(vec3 rayOrigin, vec3 rayDirection, vec3 boxHalfExtents, out float tEnter, out float tExit)
{
    vec3 boxMin = -boxHalfExtents;
    vec3 boxMax = boxHalfExtents;

    vec3 invDir = 1.0 / rayDirection;
    vec3 t0 = (boxMin - rayOrigin) * invDir;
    vec3 t1 = (boxMax - rayOrigin) * invDir;

    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    tExit = min(min(tMax.x, tMax.y), tMax.z);

    return tExit >= max(tEnter, 0.0);
}

// atmosphere-scattering-3 campaign, Phase 3
// (task_manager/atmosphere-scattering-3/PHASE3_FRUSTUM_SHAPED_RAYMARCH_PROXY.md)
// - a direct GLSL transcription of VolumeTexturePreviewMath.cpp's own
// FrustumProxy/IntersectRayFrustum()/MapFrustumLocalPositionToUvw() (the CPU
// oracle) - used ONLY for the Aerial Perspective preview (pc.shapeMode == 1).
// The frustum's own parameters are packed into a plain vec3, REUSING
// pc.boxHalfExtents (see PushConstants' own doc comment on the C++ side for
// why): x = farHalfWidth, y = farHalfHeight, z = halfDepth - NOTE this is a
// DIFFERENT order than FrustumProxy's own C++ struct field declaration order
// (halfDepth, farHalfWidth, farHalfHeight) - there is no named struct on this
// side to catch a mix-up by construction, so this ordering must be kept in
// sync BY HAND with VolumeTexturePreviewRenderer.cpp's own packing.

// Stands in for +/-infinity without relying on a literal-zero GLSL division
// (unlike IntersectRayBox() above, which legitimately needs 1.0/rayDirection
// to produce a real IEEE-754 infinity for its own slab method) - comfortably
// larger than any ray-parameter t value this feature's small, fixed-size
// proxy shapes could ever produce.
const float kFloatMax = 3.402823466e+38;

struct HalfSpacePlane {
    vec3 normal;
    float constant; // Half-space is "inside" where dot(normal, pos) + constant <= 0.
};

// Mirrors VolumeTexturePreviewMath.cpp's own ClipRayAgainstHalfSpace() (an
// anonymous-namespace helper on the CPU side) exactly - clips the running
// [tEnter, tExit] range against ONE half-space.
bool ClipRayAgainstHalfSpace(vec3 rayOrigin, vec3 rayDirection, HalfSpacePlane plane, inout float tEnter, inout float tExit)
{
    float denom = dot(plane.normal, rayDirection);
    float originValue = dot(plane.normal, rayOrigin) + plane.constant;
    const float kEpsilon = 1e-8;

    if (abs(denom) < kEpsilon) {
        return originValue <= 0.0;
    }

    float t = -originValue / denom;
    if (denom > 0.0) {
        tExit = min(tExit, t);
    } else {
        tEnter = max(tEnter, t);
    }
    return tEnter <= tExit;
}

bool IntersectRayFrustum(vec3 rayOrigin, vec3 rayDirection, vec3 frustumParams, out float tEnter, out float tExit)
{
    float farHalfWidth = frustumParams.x;
    float farHalfHeight = frustumParams.y;
    float halfDepth = frustumParams.z;

    tEnter = -kFloatMax;
    tExit = kFloatMax;

    // Near/far caps - axis-aligned in Z only.
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, 0.0, -1.0), -halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, 0.0, 1.0), -halfDepth), tEnter, tExit)) {
        return false;
    }

    // Four tapering side walls - see MapFrustumLocalPositionToUvw() below /
    // the CPU oracle's own comment for the kx/ky taper-rate derivation.
    float kx = farHalfWidth / (2.0 * halfDepth);
    float ky = farHalfHeight / (2.0 * halfDepth);

    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(1.0, 0.0, -kx), -kx * halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(-1.0, 0.0, -kx), -kx * halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, 1.0, -ky), -ky * halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, -1.0, -ky), -ky * halfDepth), tEnter, tExit)) {
        return false;
    }

    return tExit >= max(tEnter, 0.0);
}

// Mirrors VolumeTexturePreviewMath.cpp's own MapFrustumLocalPositionToUvw()
// exactly - maps a point already known to be inside (or on the boundary of)
// the frustum to normalized [0,1]^3 texture space.
vec3 MapFrustumLocalPositionToUvw(vec3 localPos, vec3 frustumParams)
{
    float farHalfWidth = frustumParams.x;
    float farHalfHeight = frustumParams.y;
    float halfDepth = frustumParams.z;

    float w = (localPos.z + halfDepth) / (2.0 * halfDepth);
    float kx = farHalfWidth / (2.0 * halfDepth);
    float ky = farHalfHeight / (2.0 * halfDepth);
    const float kMinCrossSection = 1e-5;
    float halfWidthAtZ = max(kx * (localPos.z + halfDepth), kMinCrossSection);
    float halfHeightAtZ = max(ky * (localPos.z + halfDepth), kMinCrossSection);

    float u = (localPos.x / halfWidthAtZ) * 0.5 + 0.5;
    float v = (localPos.y / halfHeightAtZ) * 0.5 + 0.5;
    return vec3(u, v, w);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(outputImage);
    if (pixel.x >= outSize.x || pixel.y >= outSize.y) {
        return;
    }

    vec2 ndc = (vec2(pixel) + 0.5) / vec2(outSize) * 2.0 - 1.0; // [-1, 1], y NOT flipped since this is a compute image write, not a rasterized clip-space position.
    float aspect = float(outSize.x) / float(outSize.y);

    vec3 rayDir = normalize(
        pc.forward
        + pc.right * (ndc.x * pc.tanHalfFovY * aspect)
        + pc.up * (-ndc.y * pc.tanHalfFovY)); // -ndc.y so pixel row 0 (top) maps to +up, matching normal image-row-0-is-top convention.

    float tEnter;
    float tExit;
    bool hit;
    if (pc.shapeMode == 1) {
        hit = IntersectRayFrustum(pc.eyePosition, rayDir, pc.boxHalfExtents, tEnter, tExit);
    } else {
        hit = IntersectRayBox(pc.eyePosition, rayDir, pc.boxHalfExtents, tEnter, tExit);
    }
    if (!hit) {
        imageStore(outputImage, pixel, vec4(kBackgroundColor, 1.0));
        return;
    }
    tEnter = max(tEnter, 0.0);

    float rayLength = tExit - tEnter;
    float stepLength = rayLength / float(pc.stepCount);
    float t = tEnter + 0.5 * stepLength;

    vec4 accum = vec4(0.0);
    for (int i = 0; i < pc.stepCount; ++i) {
        vec3 localPos = pc.eyePosition + rayDir * t; // Local space, box spans [-boxHalfExtents, +boxHalfExtents] (or frustum-local space when pc.shapeMode == 1).
        vec3 uvw;
        if (pc.shapeMode == 1) {
            uvw = MapFrustumLocalPositionToUvw(localPos, pc.boxHalfExtents);
        } else {
            uvw = (localPos / pc.boxHalfExtents) * 0.5 + 0.5; // -> [0, 1]^3 texture space.
        }

        vec4 s = texture(volumeTex, uvw);
        float density;
        vec3 color;
        if (pc.interpretationMode == 1) {
            // Atmosphere Aerial Perspective volume (atmosphere-scattering-2
            // campaign, Phase 4): s.a is TRANSMITTANCE (how much light
            // survives - opposite polarity of a density), s.rgb is raw HDR
            // in-scattered luminance (tiny; needs exposure + tonemap to be
            // legible at all). See this campaign's
            // PHASE4_ATMOSPHERE_AWARE_VOLUME_DEBUG_PREVIEW.md.
            density = 1.0 - s.a; // "haze amount" - 0 where fully transparent/no haze, ->1 where opaque/heavy haze.
            vec3 exposed = s.rgb * pc.aerialPreviewExposure;
            color = exposed / (exposed + vec3(1.0)); // Simple fixed Reinhard tonemap - keeps arbitrarily bright HDR input in [0,1) without hard clipping.
        } else {
            // Generic interpretation - network-impl-6's own original, UNCHANGED behavior.
            density = s.a;
            color = s.rgb;
        }
        float alpha = 1.0 - exp(-density * pc.densityScale * stepLength);

        accum.rgb += (1.0 - accum.a) * color * alpha;
        accum.a += (1.0 - accum.a) * alpha;

        if (accum.a > 0.995) {
            break;
        }
        t += stepLength;
    }

    vec3 finalColor = accum.rgb + (1.0 - accum.a) * kBackgroundColor;
    imageStore(outputImage, pixel, vec4(finalColor, 1.0));
}
