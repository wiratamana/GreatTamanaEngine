#version 450

// Raymarch preview of a 3D texture into a 2D RGBA8 image: one invocation per output pixel,
// front-to-back alpha composite through a fixed-camera, origin-centered proxy shape.
// IntersectRayBox/IntersectRayFrustum/MapFrustumLocalPositionToUvw mirror src/Renderer/VolumeTexturePreviewMath.h
// (the CPU reference); if they disagree, the CPU side is right.
// Bindings match src/Renderer/VolumeTexturePreviewRenderer.cpp: 0 = volume (sampler), 1 = output image.
// local_size must match VolumeTexturePreviewRenderer.h kLocalSizeX/kLocalSizeY.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler3D volumeTex;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// Must match PushConstants in VolumeTexturePreviewRenderer.cpp (every vec3 starts a 16-byte group).
layout(push_constant) uniform PushConstants {
    vec3 eyePosition;
    float tanHalfFovY;
    vec3 forward;
    float densityScale;
    vec3 right;
    int stepCount;
    vec3 up;
    float _padding0;
    vec3 boxHalfExtents; // Box half-extents, or the frustum (farHalfWidth, farHalfHeight, halfDepth) when shapeMode == 1.
    float _padding1;
    int interpretationMode; // 0 = alpha is density, 1 = alpha is transmittance and rgb is HDR in-scattering.
    float aerialPreviewExposure; // Mode 1 only.
    int shapeMode; // 0 = box (IntersectRayBox), 1 = frustum (IntersectRayFrustum).
} pc;

// Dark gray keeps bright content readable.
const vec3 kBackgroundColor = vec3(0.2, 0.2, 0.2);

// Slab test against a box centered at the origin. Relies on 1.0/0.0 == +inf for axis-parallel rays.
bool IntersectRayBox(vec3 rayOrigin, vec3 rayDirection, vec3 boxHalfExtents, out float tEnter, out float tExit)
{
    vec3 boxMin = -boxHalfExtents;
    vec3 boxMax = boxHalfExtents;

    vec3 invDir = 1.0 / rayDirection;
    vec3 t0 = (boxMin - rayOrigin) * invDir;
    vec3 t1 = (boxMax - rayOrigin) * invDir;

    vec3 tMin = min(t0, t1);
    vec3 tMax = max(t0, t1);

    tEnter = max(max(tMin.x, tMin.y), tMin.z);
    tExit = min(min(tMax.x, tMax.y), tMax.z);

    return tExit >= max(tEnter, 0.0);
}

// Stands in for +/-infinity in the frustum clipping below.
const float kFloatMax = 3.402823466e+38;

struct HalfSpacePlane {
    vec3 normal;
    float constant; // Inside where dot(normal, pos) + constant <= 0.
};

// Clips the running [tEnter, tExit] range against one half-space.
bool ClipRayAgainstHalfSpace(vec3 rayOrigin, vec3 rayDirection, HalfSpacePlane plane, inout float tEnter, inout float tExit)
{
    float denom = dot(plane.normal, rayDirection);
    float originValue = dot(plane.normal, rayOrigin) + plane.constant;
    const float kEpsilon = 1e-8;

    if (abs(denom) < kEpsilon) {
        return originValue <= 0.0;
    }

    float t = -originValue / denom;
    if (denom > 0.0) {
        tExit = min(tExit, t);
    } else {
        tEnter = max(tEnter, t);
    }
    return tEnter <= tExit;
}

// frustumParams = (farHalfWidth, farHalfHeight, halfDepth).
bool IntersectRayFrustum(vec3 rayOrigin, vec3 rayDirection, vec3 frustumParams, out float tEnter, out float tExit)
{
    float farHalfWidth = frustumParams.x;
    float farHalfHeight = frustumParams.y;
    float halfDepth = frustumParams.z;

    tEnter = -kFloatMax;
    tExit = kFloatMax;

    // Near/far caps.
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, 0.0, -1.0), -halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, 0.0, 1.0), -halfDepth), tEnter, tExit)) {
        return false;
    }

    // Four tapering side walls.
    float kx = farHalfWidth / (2.0 * halfDepth);
    float ky = farHalfHeight / (2.0 * halfDepth);

    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(1.0, 0.0, -kx), -kx * halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(-1.0, 0.0, -kx), -kx * halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, 1.0, -ky), -ky * halfDepth), tEnter, tExit)) {
        return false;
    }
    if (!ClipRayAgainstHalfSpace(rayOrigin, rayDirection, HalfSpacePlane(vec3(0.0, -1.0, -ky), -ky * halfDepth), tEnter, tExit)) {
        return false;
    }

    return tExit >= max(tEnter, 0.0);
}

// Maps a point inside the frustum to normalized [0,1]^3 texture space.
vec3 MapFrustumLocalPositionToUvw(vec3 localPos, vec3 frustumParams)
{
    float farHalfWidth = frustumParams.x;
    float farHalfHeight = frustumParams.y;
    float halfDepth = frustumParams.z;

    float w = (localPos.z + halfDepth) / (2.0 * halfDepth);
    float kx = farHalfWidth / (2.0 * halfDepth);
    float ky = farHalfHeight / (2.0 * halfDepth);
    const float kMinCrossSection = 1e-5;
    float halfWidthAtZ = max(kx * (localPos.z + halfDepth), kMinCrossSection);
    float halfHeightAtZ = max(ky * (localPos.z + halfDepth), kMinCrossSection);

    float u = (localPos.x / halfWidthAtZ) * 0.5 + 0.5;
    float v = (localPos.y / halfHeightAtZ) * 0.5 + 0.5;
    return vec3(u, v, w);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(outputImage);
    if (pixel.x >= outSize.x || pixel.y >= outSize.y) {
        return;
    }

    vec2 ndc = (vec2(pixel) + 0.5) / vec2(outSize) * 2.0 - 1.0; // [-1, 1]; y is not flipped (image write, not clip space).
    float aspect = float(outSize.x) / float(outSize.y);

    vec3 rayDir = normalize(
        pc.forward
        + pc.right * (ndc.x * pc.tanHalfFovY * aspect)
        + pc.up * (-ndc.y * pc.tanHalfFovY)); // Row 0 is the top of the image.

    float tEnter;
    float tExit;
    bool hit;
    if (pc.shapeMode == 1) {
        hit = IntersectRayFrustum(pc.eyePosition, rayDir, pc.boxHalfExtents, tEnter, tExit);
    } else {
        hit = IntersectRayBox(pc.eyePosition, rayDir, pc.boxHalfExtents, tEnter, tExit);
    }
    if (!hit) {
        imageStore(outputImage, pixel, vec4(kBackgroundColor, 1.0));
        return;
    }
    tEnter = max(tEnter, 0.0);

    float rayLength = tExit - tEnter;
    float stepLength = rayLength / float(pc.stepCount);
    float t = tEnter + 0.5 * stepLength;

    vec4 accum = vec4(0.0);
    for (int i = 0; i < pc.stepCount; ++i) {
        vec3 localPos = pc.eyePosition + rayDir * t;
        vec3 uvw;
        if (pc.shapeMode == 1) {
            uvw = MapFrustumLocalPositionToUvw(localPos, pc.boxHalfExtents);
        } else {
            uvw = (localPos / pc.boxHalfExtents) * 0.5 + 0.5;
        }

        vec4 s = texture(volumeTex, uvw);
        float density;
        vec3 color;
        if (pc.interpretationMode == 1) {
            density = 1.0 - s.a; // Alpha is transmittance: haze amount is its complement.
            vec3 exposed = s.rgb * pc.aerialPreviewExposure;
            color = exposed / (exposed + vec3(1.0)); // Reinhard tonemap of the tiny HDR input.
        } else {
            density = s.a;
            color = s.rgb;
        }
        float alpha = 1.0 - exp(-density * pc.densityScale * stepLength);

        accum.rgb += (1.0 - accum.a) * color * alpha;
        accum.a += (1.0 - accum.a) * alpha;

        if (accum.a > 0.995) {
            break;
        }
        t += stepLength;
    }

    vec3 finalColor = accum.rgb + (1.0 - accum.a) * kBackgroundColor;
    imageStore(outputImage, pixel, vec4(finalColor, 1.0));
}
