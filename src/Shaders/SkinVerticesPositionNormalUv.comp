#version 450

// GPU vertex skinning, position + normal + uv variant: the same blend as SkinVerticesPositionNormal.comp plus a UV copy.
// Buffer layouts must match src/Renderer/GpuSkinning/GpuSkinningTypes.h; the C++ side binds by the names below.
//   bindPose, skinWeights, boneMatrices (read-only), outputBuffer (tightly packed floats), bindPoseUv (read-only vec2[])
// local_size_x must equal kSkinningLocalSizeX in GpuSkinningPipelines.h.
layout(local_size_x = 256) in;

struct BindPoseVertex {
    vec4 positionAndPad;
    vec4 normalAndPad;
};
layout(std430, binding = 0) readonly buffer BindPoseBuffer {
    BindPoseVertex vertices[];
} bindPose;

struct SkinWeightsEntry {
    uvec4 boneIndices;
    vec4 weights;
};
layout(std430, binding = 1) readonly buffer SkinWeightsBuffer {
    SkinWeightsEntry entries[];
} skinWeights;

layout(std430, binding = 2) readonly buffer BoneMatricesBuffer {
    mat4 matrices[];
} boneMatrices;

// Tightly-packed output - matches GpuSkinnedVertexPositionNormalUv
// (GpuSkinningTypes.h) exactly: 8 floats per vertex (position.xyz,
// normal.xyz, uv.xy), stride 8, NO std430 vec-padding - same reasoning as
// the sibling file's own OutputBuffer.
layout(std430, binding = 3) buffer OutputBuffer {
    float values[];
} outputBuffer;

// Matches GpuUv (GpuSkinningTypes.h) exactly - a plain, unpadded vec2 (8
// bytes); std430's own alignment rule for vec2 needs no extra padding.
// Uploaded once per model, at load time, same lifetime as bindings 0/1.
layout(std430, binding = 4) readonly buffer UvBuffer {
    vec2 uvs[];
} bindPoseUv;

layout(push_constant) uniform PushConstants {
    uint vertexCount;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.vertexCount) {
        return;
    }

    vec3 bindPosition = bindPose.vertices[i].positionAndPad.xyz;
    vec3 bindNormal = bindPose.vertices[i].normalAndPad.xyz;

    uvec4 boneIndices = skinWeights.entries[i].boneIndices;
    vec4 weights = skinWeights.entries[i].weights;
    uint boneCount = uint(boneMatrices.matrices.length());

    vec3 skinnedPosition = vec3(0.0);
    vec3 skinnedNormal = vec3(0.0);
    float totalWeight = 0.0;

    for (int slot = 0; slot < 4; ++slot) {
        float weight = weights[slot];
        uint boneIndex = boneIndices[slot];

        if (weight == 0.0 || boneIndex >= boneCount) {
            continue;
        }

        mat4 m = boneMatrices.matrices[boneIndex];

        vec3 transformedPosition = (m * vec4(bindPosition, 1.0)).xyz;
        vec3 transformedNormal = mat3(m) * bindNormal;

        skinnedPosition += transformedPosition * weight;
        skinnedNormal += transformedNormal * weight;
        totalWeight += weight;
    }

    vec3 finalPosition;
    vec3 finalNormal;
    if (totalWeight > 0.0) {
        finalPosition = skinnedPosition / totalWeight;
        finalNormal = normalize(skinnedNormal);
    } else {
        finalPosition = bindPosition;
        finalNormal = bindNormal;
    }

    uint base = i * 8u;
    outputBuffer.values[base + 0] = finalPosition.x;
    outputBuffer.values[base + 1] = finalPosition.y;
    outputBuffer.values[base + 2] = finalPosition.z;
    outputBuffer.values[base + 3] = finalNormal.x;
    outputBuffer.values[base + 4] = finalNormal.y;
    outputBuffer.values[base + 5] = finalNormal.z;

    // UV pass-through - UVs never change under skinning, copied straight
    // from the bind-pose UV buffer, unmodified (see this file's own header
    // comment).
    vec2 uv = bindPoseUv.uvs[i];
    outputBuffer.values[base + 6] = uv.x;
    outputBuffer.values[base + 7] = uv.y;
}
