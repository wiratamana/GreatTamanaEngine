#version 450

// GPU Vertex Skinning - Phase 2: Compute Kernel (PositionNormalUv variant).
//
// See task_manager/gpu_skinning/GPU_SKINNING_PHASE2_COMPUTE_KERNEL_STRATEGY_v1.md
// for the full design reasoning, and src/Renderer/GpuSkinning/GpuSkinningTypes.h
// for the byte-for-byte C++ struct layouts every binding below must match
// EXACTLY. Sibling file: SkinVerticesPositionNormal.comp - identical blend
// math; see that file's own header comment first, this one only documents
// what's DIFFERENT here (the UV pass-through and its extra binding).
//
// Binding convention - bindings 0-3 are exactly GpuSkinningTypes.h's own
// documented table (see SkinVerticesPositionNormal.comp for the full
// per-binding reasoning). BINDING 4 IS A PHASE 2 ADDITION, needed only by
// this Uv variant: Phase 1's fixed 4-binding table has no slot for the
// bind-pose UV buffer, because UVs never change under skinning (they are
// copied straight through, unmodified, from the bind-pose UV buffer to the
// output buffer - exactly like the CPU path's own
// MeshVertexPacking.cpp/PackMeshVertexUvRange() copies `skinData->uvs`
// verbatim). Per the Phase 2 strategy doc's own "if the GLSL side turns out
// to want a different physical layout... that is a Phase 1 revision, not a
// Phase 2 workaround" rule: this is an ADDITIVE extension of Phase 1's
// table (a new binding 4, used ONLY by this Uv variant's own descriptor set
// layout - the plain PositionNormal variant's layout is unaffected and
// still has exactly 4 bindings), not a redefinition of bindings 0-3.
//   binding 0 - bind-pose vertex buffer (read-only, std430, array-of-structs)
//   binding 1 - skin-weight buffer      (read-only, std430, array-of-structs)
//   binding 2 - bone matrix buffer      (read-only, std430, plain mat4[])
//   binding 3 - skinned output buffer   (read-write, TIGHTLY PACKED floats)
//   binding 4 - bind-pose UV buffer     (read-only, std430, plain vec2[] -
//                                        matches GpuUv exactly, no padding
//                                        needed at std430's own 8-byte vec2
//                                        alignment) - UV-VARIANT ONLY.
//
// local_size_x = 256 - MUST match
// src/Renderer/GpuSkinning/GpuSkinningPipelines.h's own kSkinningLocalSizeX
// constant exactly, same as the sibling file.
layout(local_size_x = 256) in;

struct BindPoseVertex {
    vec4 positionAndPad;
    vec4 normalAndPad;
};
layout(std430, binding = 0) readonly buffer BindPoseBuffer {
    BindPoseVertex vertices[];
} bindPose;

struct SkinWeightsEntry {
    uvec4 boneIndices;
    vec4 weights;
};
layout(std430, binding = 1) readonly buffer SkinWeightsBuffer {
    SkinWeightsEntry entries[];
} skinWeights;

layout(std430, binding = 2) readonly buffer BoneMatricesBuffer {
    mat4 matrices[];
} boneMatrices;

// Tightly-packed output - matches GpuSkinnedVertexPositionNormalUv
// (GpuSkinningTypes.h) exactly: 8 floats per vertex (position.xyz,
// normal.xyz, uv.xy), stride 8, NO std430 vec-padding - same reasoning as
// the sibling file's own OutputBuffer.
layout(std430, binding = 3) buffer OutputBuffer {
    float values[];
} outputBuffer;

// Matches GpuUv (GpuSkinningTypes.h) exactly - a plain, unpadded vec2 (8
// bytes); std430's own alignment rule for vec2 needs no extra padding.
// Uploaded once per model, at load time, same lifetime as bindings 0/1.
layout(std430, binding = 4) readonly buffer UvBuffer {
    vec2 uvs[];
} bindPoseUv;

layout(push_constant) uniform PushConstants {
    uint vertexCount;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.vertexCount) {
        return;
    }

    vec3 bindPosition = bindPose.vertices[i].positionAndPad.xyz;
    vec3 bindNormal = bindPose.vertices[i].normalAndPad.xyz;

    uvec4 boneIndices = skinWeights.entries[i].boneIndices;
    vec4 weights = skinWeights.entries[i].weights;
    uint boneCount = uint(boneMatrices.matrices.length());

    vec3 skinnedPosition = vec3(0.0);
    vec3 skinnedNormal = vec3(0.0);
    float totalWeight = 0.0;

    for (int slot = 0; slot < 4; ++slot) {
        float weight = weights[slot];
        uint boneIndex = boneIndices[slot];

        if (weight == 0.0 || boneIndex >= boneCount) {
            continue;
        }

        mat4 m = boneMatrices.matrices[boneIndex];

        vec3 transformedPosition = (m * vec4(bindPosition, 1.0)).xyz;
        vec3 transformedNormal = mat3(m) * bindNormal;

        skinnedPosition += transformedPosition * weight;
        skinnedNormal += transformedNormal * weight;
        totalWeight += weight;
    }

    vec3 finalPosition;
    vec3 finalNormal;
    if (totalWeight > 0.0) {
        finalPosition = skinnedPosition / totalWeight;
        finalNormal = normalize(skinnedNormal);
    } else {
        finalPosition = bindPosition;
        finalNormal = bindNormal;
    }

    uint base = i * 8u;
    outputBuffer.values[base + 0] = finalPosition.x;
    outputBuffer.values[base + 1] = finalPosition.y;
    outputBuffer.values[base + 2] = finalPosition.z;
    outputBuffer.values[base + 3] = finalNormal.x;
    outputBuffer.values[base + 4] = finalNormal.y;
    outputBuffer.values[base + 5] = finalNormal.z;

    // UV pass-through - UVs never change under skinning, copied straight
    // from the bind-pose UV buffer, unmodified (see this file's own header
    // comment).
    vec2 uv = bindPoseUv.uvs[i];
    outputBuffer.values[base + 6] = uv.x;
    outputBuffer.values[base + 7] = uv.y;
}
