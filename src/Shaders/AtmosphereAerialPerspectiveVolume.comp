#version 450

// Atmosphere Scattering + Aerial Perspective campaign, Phase 6
// (task_manager/atmosphere-scattering-1/ATMOSPHERE_PHASE6_AERIAL_PERSPECTIVE_FROXEL_VOLUME_v1.md)
// - the camera-frustum-aligned 3D "froxel volume" that actually produces
// AERIAL PERSPECTIVE data: for every froxel (x, y, z), stores the
// accumulated in-scattered light (RGB) and transmittance (alpha, from the
// camera to that voxel's own view-space depth). Phase 7's composite pass
// will look this up per on-screen pixel (screen UV -> froxel column, real
// view depth -> Z slice via AtmosphereCommon.glsl's ViewDepthToFroxelSlice())
// and blend it onto already-rendered opaque geometry.
//
// ONE INVOCATION PER FROXEL COLUMN (x, y) - each invocation loops every Z
// slice INTERNALLY, in order, since each slice's accumulated
// transmittance/in-scattering depends on the PREVIOUS slice's own running
// total (a genuine sequential dependency along Z) - mirrors
// _reference/pl-sky/shaders/sky_aerial_lut.comp's own per-column-thread,
// intra-thread-Z-loop design exactly (see this phase's own strategy
// document, Step 2).
//
// BINDING CONVENTION (same as AtmosphereSkyViewLut.comp - see this
// campaign's own "Revision Notes"): binding 0 = AtmosphereParametersGpu
// (read-only STORAGE buffer, reused verbatim from Phase 3/4 - NEVER
// `uniform`); binding 1 = AtmosphereFrameUniforms (a SECOND read-only
// STORAGE buffer, this view's own per-frame data, including the
// Phase-6-new `invViewProjection` field - also NEVER `uniform`); binding 2
// = sampler2D transmittanceLut (Phase 3's own output); binding 3 =
// sampler2D multiScatteringLut (Phase 4's own output); binding 4 = the
// output image3D (rgba16f, write-only) - format matches Phase 2's
// VolumeTexture exactly. Both C++
// (src/Renderer/Atmosphere/AtmosphereLutRenderer.cpp) and this file must be
// kept in agreement by hand - this campaign deliberately has no shader
// reflection.
//
// local_size_x/y = 8, local_size_z = 1 - one invocation per froxel COLUMN
// (matches _reference/pl-sky/shaders/sky_aerial_lut.comp's own convention
// exactly) - MUST match
// src/Renderer/Atmosphere/AtmosphereLutRenderer.cpp's own
// kAerialPerspectiveVolumeLocalSizeX/Y/Z constants exactly.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

#include "AtmosphereCommon.glsl"

layout(std430, binding = 0) readonly buffer AtmosphereParametersBlock {
    AtmosphereParametersGpu atmosphereParameters;
};

layout(std430, binding = 1) readonly buffer AtmosphereFrameUniformsBlock {
    AtmosphereFrameUniforms frameUniforms;
};

layout(binding = 2) uniform sampler2D transmittanceLut;
layout(binding = 3) uniform sampler2D multiScatteringLut;

// rgba16f - RGB carries accumulated in-scattered luminance (routinely
// exceeds 1.0, same reasoning as every other HDR LUT in this campaign),
// alpha carries scalar transmittance (a plain average of the R/G/B
// transmittance channels - see this file's own "DEVIATION" comment below).
layout(binding = 4, rgba16f) uniform writeonly image3D destinationVolume;

// SAME fixed constants as _reference/pl-sky/src/app.c's own defaults (see
// task_manager/atmosphere-scattering-1/ATMOSPHERE_REFERENCE_NOTES.md,
// Sections 2/5) - fixed, hardcoded, never a runtime-tunable Editor knob
// (this phase's own "What We Will NOT Do"). The volume's actual
// width/height/depth are read from imageSize(destinationVolume) below
// rather than hardcoded here too (matches AtmosphereSkyViewLut.comp's own
// "read imageSize(), don't hardcode resolution in the shader" convention),
// but MUST match
// src/Renderer/Atmosphere/AtmosphereLutRenderer.cpp's own
// kAerialPerspectiveVolumeWidth/Height/Depth constants (128x128x32).
const float kAerialMaxDistanceKm = 10.0;
const float kAerialDepthExponent = 2.0;
const int kAerialSamplesPerSlice = 8;

void main()
{
    ivec3 volumeSize = imageSize(destinationVolume);
    ivec2 froxelXY = ivec2(gl_GlobalInvocationID.xy);
    if (froxelXY.x >= volumeSize.x || froxelXY.y >= volumeSize.y) {
        // The dispatch's own ceiling-division group count can legitimately
        // cover more threads than there are real froxel columns - see
        // ComputeDispatch.h's own header comment. Those extra invocations
        // simply do nothing.
        return;
    }

    float planetRadiusKm = atmosphereParameters.planetRadiusKm;

    // Same tiny surface-scale offset as AtmosphereSkyViewLut.comp's own
    // fCameraSurfaceOffset - keeps a camera sitting exactly at ground
    // level from producing a degenerate ray/sphere intersection.
    float surfaceOffsetKm = max(planetRadiusKm * 1e-7, 1e-6);
    float viewHeightKm = max(frameUniforms.cameraPositionAtmosphere.y, planetRadiusKm) + surfaceOffsetKm;

    vec3 rayOrigin = vec3(0.0, viewHeightKm, 0.0);
    vec3 viewDirection = FroxelColumnToViewRayDirection(froxelXY, volumeSize.xy, frameUniforms.invViewProjection);

    // AtmosphereFrameUniforms::sunDirection is already the direction FROM
    // the scene TOWARD the sun (see AtmosphereTypes.h's own doc comment) -
    // no negation needed here, exactly like AtmosphereSkyViewLut.comp.
    vec3 directionToSun = normalize(frameUniforms.sunDirection);

    float viewDotLight = clamp(dot(viewDirection, directionToSun), -1.0, 1.0);
    float rayleighPhaseValue = RayleighPhaseFunction(viewDotLight);
    float miePhaseValue = CornetteShanksMiePhaseFunction(atmosphereParameters.miePhaseG, viewDotLight);
    vec3 sunRadiance = frameUniforms.sunIlluminance;

    ivec2 transmittanceLutSize = textureSize(transmittanceLut, 0);
    ivec2 multiScatteringLutSize = textureSize(multiScatteringLut, 0);

    vec3 accumulatedLuminance = vec3(0.0);
    vec3 accumulatedTransmittance = vec3(1.0);

    for (int slice = 0; slice < volumeSize.z; ++slice) {
        float distance0Km =
            FroxelSliceToViewDepth(float(slice), float(volumeSize.z), kAerialMaxDistanceKm, kAerialDepthExponent);
        float distance1Km =
            FroxelSliceToViewDepth(float(slice + 1), float(volumeSize.z), kAerialMaxDistanceKm, kAerialDepthExponent);
        float sliceLengthKm = max(distance1Km - distance0Km, 0.0);

        for (int sampleIndex = 0; sampleIndex < kAerialSamplesPerSlice; ++sampleIndex) {
            float sampleU = (float(sampleIndex) + 0.5) / float(kAerialSamplesPerSlice);
            float sampleDistanceKm = mix(distance0Km, distance1Km, sampleU);
            float segmentLengthKm = sliceLengthKm / float(kAerialSamplesPerSlice);

            vec3 currentPositionKm = rayOrigin + viewDirection * sampleDistanceKm;
            float radialLengthKm = length(currentPositionKm);
            vec3 upAtSample = currentPositionKm / max(radialLengthKm, 1e-20);
            float currentHeightKm = radialLengthKm - planetRadiusKm;

            // Once this ray has gone below the planet's own surface, the
            // remaining aerial volume along it is invalid/occluded -
            // mirrors the reference's own identical early-out exactly
            // (break the INNER sample loop only; the outer per-slice loop
            // keeps running and simply re-stores the same, now-frozen
            // accumulated values for every remaining slice, since no
            // further accumulation ever happens once every subsequent
            // sample also starts below ground).
            if (currentHeightKm < 0.0) {
                break;
            }
            currentHeightKm = clamp(currentHeightKm, 0.0, atmosphereParameters.atmosphereThicknessKm);

            vec2 lutUv = HeightZenithToTransmittanceLutUv(
                atmosphereParameters, currentHeightKm, dot(upAtSample, directionToSun));
            vec3 transmittanceToSun = texture(transmittanceLut, ClampLutUvHalfTexelInset(lutUv, transmittanceLutSize)).rgb;
            vec3 multipleScatteredLuminance =
                texture(multiScatteringLut, ClampLutUvHalfTexelInset(lutUv, multiScatteringLutSize)).rgb;

            vec3 extinctionCoefficient = ComputeExtinctionCoefficientAtHeight(atmosphereParameters, currentHeightKm);
            vec3 scatterRayleigh =
                atmosphereParameters.rayleighScattering * RayleighDensityAtHeight(atmosphereParameters, currentHeightKm);
            vec3 scatterMie = atmosphereParameters.mieScattering * MieDensityAtHeight(atmosphereParameters, currentHeightKm);
            vec3 totalScattering = scatterRayleigh + scatterMie;

            float planetVisibility = PlanetVisibility(currentPositionKm, directionToSun, planetRadiusKm);

            vec3 phaseTimesScattering = scatterRayleigh * rayleighPhaseValue + scatterMie * miePhaseValue;
            vec3 directSource = planetVisibility * transmittanceToSun * phaseTimesScattering;

            // Same "do not double-count the direct solar shadow term"
            // rule as AtmosphereSkyViewLut.comp - the multi-scattering LUT
            // already represents incoming multiple-scattered luminance,
            // multiplied by LOCAL scattering only here.
            vec3 multipleScatteringSource = multipleScatteredLuminance * totalScattering;

            vec3 source = sunRadiance * (directSource + multipleScatteringSource);
            vec3 segmentLuminance = IntegrateInscattering(source, extinctionCoefficient, segmentLengthKm);

            accumulatedLuminance += accumulatedTransmittance * segmentLuminance;
            accumulatedTransmittance *= exp(-extinctionCoefficient * segmentLengthKm);
        }

        // DEVIATION FROM THE REFERENCE (documented, not a design change):
        // _reference/pl-sky/shaders/sky_aerial_lut.comp computes its own
        // scalar transmittance as
        // `dot(accumulatedTransmittance, vec3(1.0 / tAerialInfo.w))` -
        // dividing by the SUN INTENSITY constant (3.0 by default), which is
        // unrelated to transmittance at all. Its own commented-out
        // alternative directly above that line -
        // `dot(accumulatedTransmittance, vec3(1.0 / 3.0))` - reveals what
        // this is actually meant to compute: a plain per-channel AVERAGE
        // (dot with vec3(1/3) == sum/3), which only produces the same
        // number as "divide by sun intensity" because that reference's own
        // default sun intensity also happens to be 3.0. This shader
        // computes the average directly, with no dependency on sun
        // intensity at all - the mathematically correct interpretation of
        // what both versions of the reference's own code are really doing.
        float scalarTransmittance = (accumulatedTransmittance.r + accumulatedTransmittance.g + accumulatedTransmittance.b) / 3.0;
        imageStore(destinationVolume, ivec3(froxelXY, slice), vec4(accumulatedLuminance, scalarTransmittance));
    }
}
