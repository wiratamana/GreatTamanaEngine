#version 450

// Cluster culling: one thread per (instance, chunk of kClusterChunkClusters clusters). The instance box is tested first;
// only when it does not decide the whole chunk are the clusters tested one by one.
// NOTE: layouts must match ClusterCullMath.h (ClusterInstanceGpu, ClusterCullParams, MeshCluster); zero the count first.

#include "ClusterCullConstants.glsl"
#include "HizPyramidLayout.glsl"

layout(local_size_x = 64) in;

struct ClusterCullParams {
    vec4 planes[6]; // xyz = normal, w = distance; inside when dot + w >= 0.
    vec4 eyeOrDirection; // xyz = eye point, or view direction when orthographic.
    mat4 viewProjection; // The cull camera.
    uvec4 counts; // x = instanceCount, y = clusterCount, z = workItems, w = cull flags.
    vec4 hiz; // xy = atlas size, zw = level 0 size.
    vec4 depthMap; // x = k, y = b of d = k + b / w, z = pyramid level count.
    vec4 instanceBoxMin; // xyz = union box of the mesh's clusters (local space), w = 1 when valid.
    vec4 instanceBoxMax;
};
layout(std430, binding = 0) readonly buffer ParamsBlock {
    ClusterCullParams value;
} params;

struct ClusterInstance {
    mat4 world;
    uvec4 info; // x = flags, y = float bits of the largest axis scale.
};
layout(std430, binding = 1) readonly buffer InstancesBlock {
    ClusterInstance items[];
} instances;

// Same 64 bytes as MeshCluster.
struct Cluster {
    vec4 sphere; // xyz = center, w = radius.
    vec4 cone; // xyz = axis, w = cutoff (sine of the half angle); 1 = no cone.
    vec3 aabbMin;
    uint firstIndex;
    vec3 aabbMax;
    uint indexCount;
};
layout(std430, binding = 2) readonly buffer ClustersBlock {
    Cluster items[];
} clusters;

layout(std430, binding = 3) writeonly buffer VisibleBlock {
    uvec2 items[]; // x = instance index, y = cluster index.
} visible;

// Flat uint array, 5 uints per command: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance.
layout(std430, binding = 4) writeonly buffer CommandsBlock {
    uint values[];
} commands;

// Atomic counters: the host zeroes them before the dispatch. `reasons` counts item outcomes (kClusterReason*) only
// when kClusterCullFlagCollectReasons is set.
layout(std430, binding = 5) buffer CountBlock {
    uint value;
    uint reasons[kClusterReasonWords];
} count;

// One 32-bit word per instance and 16 clusters: bits 0-15 = visible last frame, bits 16-31 = drawn in the first phase of this frame.
layout(std430, binding = 7) buffer HistoryBlock {
    uint items[];
} history;

// Farthest-depth pyramid (one atlas); read only by the occlusion test.
layout(binding = 6) uniform sampler2D hizAtlas;

// Conservative: only a box fully behind one plane is rejected; a non-finite box is kept.
bool OutsideFrustum(Cluster cluster, mat4 world)
{
    vec3 c = 0.5 * (cluster.aabbMin + cluster.aabbMax);
    vec3 e = 0.5 * (cluster.aabbMax - cluster.aabbMin);
    vec3 wc = (world * vec4(c, 1.0)).xyz;
    vec3 we = abs(world[0].xyz) * e.x + abs(world[1].xyz) * e.y + abs(world[2].xyz) * e.z;
    if (any(isnan(wc)) || any(isnan(we)) || any(isinf(wc)) || any(isinf(we))) {
        return false;
    }
    for (int plane = 0; plane < 6; ++plane) {
        vec3 normal = params.value.planes[plane].xyz;
        if (dot(normal, wc) + params.value.planes[plane].w + dot(abs(normal), we) < 0.0) {
            return true;
        }
    }
    return false;
}

// Instance box against the frustum, padded so the cluster tests never disagree: 0 = clearly outside one plane,
// 2 = clearly inside every plane (so every cluster is inside), 1 = anything else. A non-finite box gives 1.
uint InstanceFrustumClass(mat4 world)
{
    vec3 c = 0.5 * (params.value.instanceBoxMin.xyz + params.value.instanceBoxMax.xyz);
    vec3 e = 0.5 * (params.value.instanceBoxMax.xyz - params.value.instanceBoxMin.xyz);
    vec3 wc = (world * vec4(c, 1.0)).xyz;
    vec3 we = abs(world[0].xyz) * e.x + abs(world[1].xyz) * e.y + abs(world[2].xyz) * e.z;
    if (any(isnan(wc)) || any(isnan(we)) || any(isinf(wc)) || any(isinf(we))) {
        return 1u;
    }
    uint result = 2u;
    for (int plane = 0; plane < 6; ++plane) {
        vec3 normal = params.value.planes[plane].xyz;
        float w = params.value.planes[plane].w;
        float d = dot(normal, wc) + w;
        float r = dot(abs(normal), we);
        float pad = 1e-4 * (abs(d) + r + abs(w)) + 1e-4;
        if (d + r < -pad) {
            return 0u;
        }
        if (d - r < pad) {
            result = 1u;
        }
    }
    return result;
}

// Back-face cone test; only for uniformly scaled, right-handed instances and clusters that have a cone.
bool BackfaceConeCulled(Cluster cluster, mat4 world, uint instanceFlags, float maxScale)
{
    const uint needed = kClusterFlagUniformScale | kClusterFlagPositiveHand;
    float cutoff = cluster.cone.w;
    if ((instanceFlags & needed) != needed || !(cutoff < 1.0)) {
        return false;
    }
    vec3 axisWorld = normalize(mat3(world) * cluster.cone.xyz);
    vec3 eyeOrDirection = params.value.eyeOrDirection.xyz;
    if ((params.value.counts.w & kClusterCullFlagOrthographic) != 0u) {
        return dot(eyeOrDirection, axisWorld) >= cutoff;
    }
    vec3 centerWorld = (world * vec4(cluster.sphere.xyz, 1.0)).xyz;
    vec3 toCluster = centerWorld - eyeOrDirection;
    return dot(toCluster, axisWorld) >= cutoff * length(toCluster) + cluster.sphere.w * maxScale;
}

// True when a box (nearest view distance, nearest depth) lies behind the pyramid texel of farthest depth.
// Mirrors HizBehind.
bool IsBehind(float nearestW, float nearestZ, float farthest)
{
    if (!(farthest < 1.0)) {
        return false; // Clear depth: a pixel of the block was never drawn.
    }
    if ((params.value.counts.w & kClusterCullFlagRawDepth) != 0u) {
        return nearestZ > farthest + kHizRawBias;
    }
    float k = params.value.depthMap.x;
    float b = params.value.depthMap.y;
    float denominator = (farthest + kHizDepthGuard) - k;
    if (!(denominator * b > 0.0)) {
        return false; // A depth at or beyond the far plane never occludes.
    }
    float farthestW = b / denominator;
    return nearestW > farthestW * (1.0 + kHizRelMargin) + kHizAbsMargin;
}

// Hi-Z test against the pyramid of this frame. The rect is clamped to the screen: pixels outside it are never
// drawn. Kept when any corner is behind the eye. Mirrors ClusterOccluded.
bool Occluded(Cluster cluster, mat4 world)
{
    uvec2 base = uvec2(params.value.hiz.zw);
    if (base.x == 0u || base.y == 0u) {
        return false;
    }
    vec2 ndcMin = vec2(0.0);
    vec2 ndcMax = vec2(0.0);
    float nearestZ = 0.0;
    float nearestW = 0.0;
    for (int i = 0; i < 8; ++i) {
        vec3 corner = vec3(
            (i & 1) != 0 ? cluster.aabbMax.x : cluster.aabbMin.x,
            (i & 2) != 0 ? cluster.aabbMax.y : cluster.aabbMin.y,
            (i & 4) != 0 ? cluster.aabbMax.z : cluster.aabbMin.z);
        vec4 clip = params.value.viewProjection * (world * vec4(corner, 1.0));
        if (!(clip.w > 1e-6)) {
            return false;
        }
        vec3 ndc = clip.xyz / clip.w;
        if (any(isnan(ndc)) || any(isinf(ndc))) {
            return false;
        }
        ndcMin = i == 0 ? ndc.xy : min(ndcMin, ndc.xy);
        ndcMax = i == 0 ? ndc.xy : max(ndcMax, ndc.xy);
        nearestZ = i == 0 ? ndc.z : min(nearestZ, ndc.z);
        nearestW = i == 0 ? clip.w : min(nearestW, clip.w);
    }
    ndcMin = max(ndcMin, vec2(-1.0));
    ndcMax = min(ndcMax, vec2(1.0));
    if (any(greaterThan(ndcMin, ndcMax))) {
        return false;
    }

    vec2 baseSize = vec2(base);
    vec2 rectMin = clamp((ndcMin * 0.5 + 0.5) * baseSize - kHizRectMarginTexels, vec2(0.0), baseSize);
    vec2 rectMax = clamp((ndcMax * 0.5 + 0.5) * baseSize + kHizRectMarginTexels, vec2(0.0), baseSize);
    float extent = max(rectMax.x - rectMin.x, rectMax.y - rectMin.y);
    uint levelCount = uint(params.value.depthMap.z);
    uint level = 0u;
    while (level + 1u < levelCount && float(1u << level) < extent) {
        ++level;
    }

    uvec2 origin = HizLevelOrigin(base, level);
    uvec2 size = HizLevelSize(base, level);
    float scale = 1.0 / float(1u << level);
    uvec2 lo = min(uvec2(floor(rectMin * scale)), size - 1u);
    uvec2 hi = min(uvec2(floor(rectMax * scale)), size - 1u);
    float farthest = texelFetch(hizAtlas, ivec2(origin + lo), 0).r;
    farthest = max(farthest, texelFetch(hizAtlas, ivec2(origin + uvec2(hi.x, lo.y)), 0).r);
    farthest = max(farthest, texelFetch(hizAtlas, ivec2(origin + uvec2(lo.x, hi.y)), 0).r);
    farthest = max(farthest, texelFetch(hizAtlas, ivec2(origin + hi), 0).r);
    return IsBehind(nearestW, nearestZ, farthest);
}


struct ReasonCounts {
    uint frustum;
    uint cone;
    uint pyramid;
    uint history;
    uint kept;
};

void FlushReasons(ReasonCounts r)
{
    if (r.frustum != 0u) { atomicAdd(count.reasons[kClusterReasonFrustum], r.frustum); }
    if (r.cone != 0u) { atomicAdd(count.reasons[kClusterReasonCone], r.cone); }
    if (r.pyramid != 0u) { atomicAdd(count.reasons[kClusterReasonPyramid], r.pyramid); }
    if (r.history != 0u) { atomicAdd(count.reasons[kClusterReasonHistory], r.history); }
    if (r.kept != 0u) { atomicAdd(count.reasons[kClusterReasonKept], r.kept); }
}

// Appends the survivors of one chunk (bit i = cluster firstCluster + i) as a contiguous run.
void Emit(uint mask, uint firstCluster, uint instanceIndex)
{
    uint n = bitCount(mask);
    if (n == 0u) {
        return;
    }
    uint slot = atomicAdd(count.value, n);
    while (mask != 0u) {
        int bit = findLSB(mask);
        mask &= mask - 1u;
        if (slot < params.value.counts.z) {
            uint clusterIndex = firstCluster + uint(bit);
            Cluster cluster = clusters.items[clusterIndex];
            visible.items[slot] = uvec2(instanceIndex, clusterIndex);
            uint base = slot * 5u;
            commands.values[base + 0u] = cluster.indexCount;
            commands.values[base + 1u] = 1u;
            commands.values[base + 2u] = cluster.firstIndex;
            commands.values[base + 3u] = 0u;
            commands.values[base + 4u] = slot; // firstInstance: the vertex shader reads visible[gl_InstanceIndex].
        }
        ++slot;
    }
}

void main()
{
    uint instanceCount = params.value.counts.x;
    uint clusterCount = params.value.counts.y;
    uint chunkCount = (clusterCount + kClusterChunkClusters - 1u) / kClusterChunkClusters;
    uint id = gl_GlobalInvocationID.x;
    if (id >= instanceCount * chunkCount) {
        return;
    }
    // Instances run fastest so one subgroup shares a chunk (uniform cluster reads) and the history reads are adjacent.
    uint chunk = id / instanceCount;
    uint instanceIndex = id - chunk * instanceCount;
    uint first = chunk * kClusterChunkClusters;
    uint end = min(first + kClusterChunkClusters, clusterCount);

    uint cullFlags = params.value.counts.w;
    bool phaseFirst = (cullFlags & kClusterCullFlagPhaseFirst) != 0u;
    bool phaseSecond = (cullFlags & kClusterCullFlagPhaseSecond) != 0u;
    bool frustumOn = (cullFlags & kClusterCullFlagFrustum) != 0u;
    bool coneOn = (cullFlags & kClusterCullFlagBackfaceCone) != 0u;
    bool collect = (cullFlags & kClusterCullFlagCollectReasons) != 0u;
    bool historyValid = (cullFlags & kClusterCullFlagHistoryValid) != 0u;
    bool occlusionOn = phaseSecond || (!phaseFirst && (cullFlags & kClusterCullFlagOcclusion) != 0u);
    ReasonCounts reasons = ReasonCounts(0u, 0u, 0u, 0u, 0u);

    ClusterInstance instance = instances.items[instanceIndex];
    bool boxValid = params.value.instanceBoxMin.w > 0.5;
    uint frustumClass = (boxValid && frustumOn) ? InstanceFrustumClass(instance.world) : 1u;
    bool instanceOutside = frustumClass == 0u;
    bool instanceInside = !frustumOn || frustumClass == 2u;
    bool instanceOccluded = false;
    if (!instanceOutside && boxValid && occlusionOn) {
        Cluster boxCluster;
        boxCluster.sphere = vec4(0.0);
        boxCluster.cone = vec4(0.0, 0.0, 0.0, 1.0);
        boxCluster.aabbMin = params.value.instanceBoxMin.xyz;
        boxCluster.firstIndex = 0u;
        boxCluster.aabbMax = params.value.instanceBoxMax.xyz;
        boxCluster.indexCount = 0u;
        instanceOccluded = Occluded(boxCluster, instance.world);
    }

    // The word of this chunk: bits 0-15 visible last frame, bits 16-31 drawn by the first phase of this frame.
    uint previous = 0u;
    if (phaseFirst) {
        previous = historyValid ? history.items[id] : 0u;
    } else if (phaseSecond) {
        previous = history.items[id];
    }
    uint visibleBefore = previous & 0xFFFFu;
    uint drawnFirst = previous >> 16;

    bool exactBulk = instanceInside && !coneOn;
    if (instanceOutside || (instanceOccluded && (!collect || exactBulk))) {
        // Every cluster of the chunk is rejected: no cluster test, no survivor.
        if (phaseFirst) {
            history.items[id] = visibleBefore;
        } else if (phaseSecond) {
            history.items[id] = 0u;
        }
        if (collect && !phaseFirst) {
            if (instanceOutside) {
                reasons.frustum = end - first;
            } else {
                reasons.pyramid = end - first;
            }
            FlushReasons(reasons);
        }
        return;
    }

    uint emitMask = 0u;
    uint visibleMask = 0u;
    for (uint c = first; c < end; ++c) {
        uint bit = 1u << (c - first);
        if (phaseFirst && (visibleBefore & bit) == 0u) {
            continue;
        }
        Cluster cluster = clusters.items[c];
        bool outside = frustumOn && !instanceInside && OutsideFrustum(cluster, instance.world);
        bool coneCulled = !outside && coneOn
            && BackfaceConeCulled(cluster, instance.world, instance.info.x, uintBitsToFloat(instance.info.y));
        bool inView = !outside && !coneCulled;
        if (phaseFirst) {
            if (inView) {
                emitMask |= bit;
                ++reasons.history;
            }
            continue;
        }
        bool occluded = inView && occlusionOn && (instanceOccluded || Occluded(cluster, instance.world));
        bool isVisible = inView && !occluded;
        if (collect) {
            if (outside) { ++reasons.frustum; }
            else if (coneCulled) { ++reasons.cone; }
            else if (occluded) { ++reasons.pyramid; }
            else { ++reasons.kept; }
        }
        if (isVisible) {
            visibleMask |= bit;
            if ((drawnFirst & bit) == 0u) {
                emitMask |= bit;
            }
        }
    }
    if (phaseFirst) {
        history.items[id] = visibleBefore | (emitMask << 16);
    } else if (phaseSecond) {
        history.items[id] = visibleMask;
    }
    Emit(emitMask, first, instanceIndex);
    if (collect) {
        FlushReasons(reasons);
    }
}
