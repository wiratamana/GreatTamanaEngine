#version 450

// Builds one level of the farthest-depth pyramid atlas. Reads only the scene depth and writes only its own
// region of the atlas. Layout must match HizLayoutFor in ClusterCullMath.h.
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform HizPush {
    uvec4 levelInfo; // x = level, y = scene depth texels per level texel and axis, zw = atlas origin of the level.
    uvec4 sizes;     // xy = level size in texels, zw = scene depth size.
} push;

layout(binding = 0) uniform sampler2D sceneDepth;
layout(binding = 1, r32f) uniform writeonly image2D hizOutput;

void main()
{
    uvec2 texel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(texel, push.sizes.xy))) {
        return;
    }
    uvec2 first = texel * push.levelInfo.y;
    uvec2 last = min(first + push.levelInfo.y, push.sizes.zw);
    float farthest = 0.0;
    for (uint y = first.y; y < last.y; ++y) {
        for (uint x = first.x; x < last.x; ++x) {
            farthest = max(farthest, texelFetch(sceneDepth, ivec2(x, y), 0).r);
        }
    }
    imageStore(hizOutput, ivec2(push.levelInfo.zw + texel), vec4(farthest));
}
