#version 450

// Frustum culling: writes one indirect draw command per visible instance (compacted or padded with empty draws).
// Buffer layouts must match CullingTypes.h and IndirectDrawTypes.h; the visible-count buffer must be zero before dispatch.
layout(local_size_x = 256) in;

// Per-instance input (std430, 112 bytes). The AABB is already in world space.
struct CullingInstance {
    mat4 worldMatrix;
    vec4 aabbMinAndPad;
    vec4 aabbMaxAndPad;
    uvec4 meshOffsets; // .x = firstIndex, .y = indexCount, .z = uint(vertexOffset), .w unused
};
layout(std430, binding = 0) readonly buffer InstanceInputBuffer {
    CullingInstance instances[];
} instanceInput;

// Flat uint array, 5 uints (20 bytes) per command: indexCount, instanceCount, firstIndex, vertexOffset, firstInstance.
// A struct array would pad to a larger stride and corrupt the commands.
layout(std430, binding = 1) buffer IndirectCommandOutputBuffer {
    uint values[];
} indirectCommands;

// Only incremented here; the host resets it, as a reset inside the dispatch would race across workgroups.
layout(std430, binding = 2) buffer VisibleCountBuffer {
    uint value;
} visibleCount;

layout(push_constant) uniform PushConstants {
    vec4 planes[6]; // Frustum planes: xyz = normal, w = distance.
    uint instanceCount; // Instances in the input array.
    uint useCompaction; // 1 = append visible commands, 0 = one slot per instance (culled ones become empty draws).
} pc;

// Conservative AABB test: reject only when the corner furthest along a plane normal is outside it.
bool AabbIntersectsFrustum(vec3 worldMin, vec3 worldMax)
{
    for (int p = 0; p < 6; ++p) {
        vec3 normal = pc.planes[p].xyz;
        float distance = pc.planes[p].w;
        vec3 pVertex = vec3(
            normal.x >= 0.0 ? worldMax.x : worldMin.x,
            normal.y >= 0.0 ? worldMax.y : worldMin.y,
            normal.z >= 0.0 ? worldMax.z : worldMin.z);
        if (dot(normal, pVertex) + distance < 0.0) {
            return false;
        }
    }
    return true;
}

void WriteIndirectCommand(
    uint slot, uint indexCount, uint instanceCountField, uint firstIndex, int vertexOffset, uint firstInstance)
{
    uint base = slot * 5u;
    indirectCommands.values[base + 0] = indexCount;
    indirectCommands.values[base + 1] = instanceCountField;
    indirectCommands.values[base + 2] = firstIndex;
    indirectCommands.values[base + 3] = uint(vertexOffset);
    indirectCommands.values[base + 4] = firstInstance;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.instanceCount) {
        return;
    }

    CullingInstance instance = instanceInput.instances[i];
    vec3 worldMin = instance.aabbMinAndPad.xyz;
    vec3 worldMax = instance.aabbMaxAndPad.xyz;
    bool visible = AabbIntersectsFrustum(worldMin, worldMax);

    uint firstIndex = instance.meshOffsets.x;
    uint indexCount = instance.meshOffsets.y;
    int vertexOffset = int(instance.meshOffsets.z);

    // firstInstance is always the input row `i`, so the vertex shader finds its matrix via gl_InstanceIndex.
    if (pc.useCompaction != 0u) {
        if (visible) {
            uint slot = atomicAdd(visibleCount.value, 1u);
            WriteIndirectCommand(slot, indexCount, 1u, firstIndex, vertexOffset, i);
        }
    } else {
        if (visible) {
            WriteIndirectCommand(i, indexCount, 1u, firstIndex, vertexOffset, i);
        } else {
            // Empty draw: the slot stays valid but does no work.
            WriteIndirectCommand(i, 0u, 0u, 0u, 0, i);
        }
    }
}
