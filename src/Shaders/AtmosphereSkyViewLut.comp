#version 450

// Atmosphere Scattering + Aerial Perspective campaign, Phase 5
// (task_manager/atmosphere-scattering-1/ATMOSPHERE_PHASE5_SKYVIEW_LUT_v1.md)
// - the Sky-View LUT: a 2D texture parameterized by view direction (azimuth
// + elevation relative to the LOCAL horizon - see AtmosphereCommon.glsl's
// SkyViewLutUvToViewDirection()) that lets a future sky-background draw
// (Phase 7) look up a plausible sky color for any background pixel with a
// SINGLE cheap texture sample instead of ray-marching the atmosphere per
// on-screen pixel.
//
// Unlike Phase 3/4's LUTs (computed once from fixed physical constants),
// this is the campaign's FIRST genuinely PER-FRAME compute pass: its
// content depends on the CURRENT camera height and CURRENT sun direction
// (AtmosphereFrameUniforms, new this phase - see
// src/Renderer/Atmosphere/AtmosphereLutRenderer.h's own per-view state, and
// Application.cpp's temporary validation call site) - recomputed every
// single frame, no dirty-flag question to consider here at all (this
// phase's own "What We Will NOT Do").
//
// Faithfully transcribed from _reference/pl-sky/shaders/sky_lut.comp - see
// task_manager/atmosphere-scattering-1/ATMOSPHERE_REFERENCE_NOTES.md,
// Section 5, for this LUT's own variable 32-64 sample count / quadratic
// distance distribution / t=0.3 mid-segment sampling, all matched exactly
// below.
//
// DEVIATION FROM THE REFERENCE (documented, not a design change): the
// per-segment source integral below reuses this campaign's own
// AtmosphereCommon.glsl IntegrateInscattering() (added in Phase 4 for the
// Multi-Scattering LUT) rather than transcribing the reference's own
// SEPARATE pl__integrate_source() a second time - both compute the exact
// same closed-form integral, (S - S*exp(-E*L)) / E; the only difference is
// pl__integrate_source()'s extra "linear fallback via a bvec3 mix()" for a
// near-zero extinction coefficient, versus IntegrateInscattering()'s
// simpler max(extinction, 1e-5) denominator clamp - a minor numerical-
// robustness nuance, not a formula difference, and not worth a third
// near-duplicate integral function (see AGENTS.md's "Skeletal Animation
// Pose Resolution" section for why this codebase refuses that pattern).
//
// BINDING CONVENTION (DescriptorSetLayoutBuilder.h's own documented
// ordering: buffer bindings, then read-only textures, then storage images
// last; see also this campaign's own "Revision Notes"): binding 0 =
// AtmosphereParametersGpu (read-only STORAGE buffer, reused verbatim from
// Phase 3/4 - NEVER `uniform`); binding 1 = AtmosphereFrameUniforms (a
// SECOND read-only STORAGE buffer, THIS phase's own new per-view/per-frame
// data - also NEVER `uniform`, per this campaign's own "Revision Notes");
// binding 2 = sampler2D transmittanceLut (Phase 3's own output); binding 3
// = sampler2D multiScatteringLut (Phase 4's own output); binding 4 = the
// output image2D. Both C++ (src/Renderer/Atmosphere/AtmosphereLutRenderer.cpp)
// and this file must be kept in agreement by hand - this campaign
// deliberately has no shader reflection.
//
// local_size_x/y = 8 - matches _reference/pl-sky/shaders/sky_lut.comp's own
// established convention for THIS shader specifically (unlike the 16x16
// Transmittance/Multi-Scattering LUTs) - MUST match
// src/Renderer/Atmosphere/AtmosphereLutRenderer.cpp's own
// kSkyViewLutLocalSizeX/Y constants exactly.
layout(local_size_x = 8, local_size_y = 8) in;

#include "AtmosphereCommon.glsl"

layout(std430, binding = 0) readonly buffer AtmosphereParametersBlock {
    AtmosphereParametersGpu atmosphereParameters;
};

layout(std430, binding = 1) readonly buffer AtmosphereFrameUniformsBlock {
    AtmosphereFrameUniforms frameUniforms;
};

layout(binding = 2) uniform sampler2D transmittanceLut;
layout(binding = 3) uniform sampler2D multiScatteringLut;

// HDR RenderTexture output (VK_FORMAT_R16G16B16A16_SFLOAT on the C++ side,
// see AtmosphereLutRenderer.cpp) - the sky's own near-sun radiance
// routinely exceeds 1.0, so `rgba16f` (never `rgba8`) here must always
// match it exactly.
layout(binding = 4, rgba16f) uniform writeonly image2D destinationImage;

// SAME variable sample-count knobs as
// _reference/pl-sky/shaders/sky_lut.comp's own
// SKY_VIEW_MIN/MAX_SAMPLE_COUNT/SKY_VIEW_SAMPLE_SEGMENT_T (see
// ATMOSPHERE_REFERENCE_NOTES.md, Section 5) - fixed, hardcoded constants,
// never a runtime-tunable Editor knob (see this phase's own "What We Will
// NOT Do").
const float kSkyViewMinSampleCount = 32.0;
const int kSkyViewMaxSampleCount = 64;
const float kSkyViewSampleSegmentT = 0.3;

void main()
{
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 lutSize = imageSize(destinationImage);
    if (texel.x >= lutSize.x || texel.y >= lutSize.y) {
        // The dispatch's own ceiling-division group count can legitimately
        // cover more threads than there are real texels - see
        // ComputeDispatch.h's own header comment. Those extra invocations
        // simply do nothing.
        return;
    }

    vec2 texelCenterUv = (vec2(texel) + vec2(0.5)) / vec2(lutSize);

    float planetRadiusKm = atmosphereParameters.planetRadiusKm;
    float atmosphereRadiusKm = AtmosphereRadiusKm(atmosphereParameters);

    // A tiny surface-scale offset (mirrors the reference's own
    // fCameraSurfaceOffset) keeps a camera sitting exactly at ground level
    // from producing a degenerate ray/sphere intersection.
    float surfaceOffsetKm = max(planetRadiusKm * 1e-7, 1e-6);
    float viewHeightKm = max(frameUniforms.cameraPositionAtmosphere.y, planetRadiusKm) + surfaceOffsetKm;

    vec3 viewDirection = SkyViewLutUvToViewDirection(texelCenterUv, lutSize, viewHeightKm, planetRadiusKm);

    vec3 rayOrigin = vec3(0.0, viewHeightKm, 0.0);

    // Combines a ground-hit test with an atmosphere-exit test, exactly
    // like the reference's own pl_ray_intersection_planet(): a ground hit
    // wins whenever it exists (the sky-view ray is blocked by the planet's
    // own bulk before it would otherwise exit the atmosphere).
    float groundHitDistanceKm = RayIntersectsSphereNearest(rayOrigin, viewDirection, planetRadiusKm);
    bool hitsGround = groundHitDistanceKm >= 0.0;
    float atmosphereExitDistanceKm = DistanceToAtmosphereOuterBoundary(rayOrigin, viewDirection, atmosphereRadiusKm);
    float rayLengthKm = hitsGround ? groundHitDistanceKm : atmosphereExitDistanceKm;

    if (rayLengthKm <= 0.0) {
        imageStore(destinationImage, texel, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    // AtmosphereFrameUniforms::sunDirection is already the direction FROM
    // the scene TOWARD the sun (see AtmosphereTypes.h's own doc comment) -
    // no negation needed here, unlike the reference's own tSunDirection
    // (which stores the direction light TRAVELS, the opposite sense).
    vec3 directionToSun = normalize(frameUniforms.sunDirection);

    float viewDotLight = clamp(dot(viewDirection, directionToSun), -1.0, 1.0);
    float rayleighPhaseValue = RayleighPhaseFunction(viewDotLight);
    float miePhaseValue = CornetteShanksMiePhaseFunction(atmosphereParameters.miePhaseG, viewDotLight);

    vec3 sunRadiance = frameUniforms.sunIlluminance;

    vec3 accumulatedTransmittance = vec3(1.0);
    vec3 accumulatedLuminance = vec3(0.0);

    // Increase the sample count as the ray becomes long relative to the
    // atmosphere's own vertical thickness.
    float sampleCountFactor = clamp(rayLengthKm / max(2.0 * atmosphereParameters.atmosphereThicknessKm, 1e-6), 0.0, 1.0);
    float sampleCount = mix(kSkyViewMinSampleCount, float(kSkyViewMaxSampleCount), sampleCountFactor);

    // Handles a partial final segment, avoiding an abrupt change whenever
    // the fractional sample count crosses an integer boundary.
    float sampleCountFloor = max(floor(sampleCount), 1.0);
    float completeSegmentsRayLengthKm = rayLengthKm * sampleCountFloor / sampleCount;

    ivec2 transmittanceLutSize = textureSize(transmittanceLut, 0);
    ivec2 multiScatteringLutSize = textureSize(multiScatteringLut, 0);

    for (int sampleIndex = 0; sampleIndex < kSkyViewMaxSampleCount; ++sampleIndex) {
        float sampleNumber = float(sampleIndex);
        if (sampleNumber >= sampleCount) {
            break;
        }

        float interval0 = sampleNumber / sampleCountFloor;
        float interval1 = (sampleNumber + 1.0) / sampleCountFloor;

        // Quadratic distribution concentrates samples near the camera.
        interval0 *= interval0;
        interval1 *= interval1;

        float distance0Km = completeSegmentsRayLengthKm * interval0;
        float distance1Km = (interval1 > 1.0) ? rayLengthKm : completeSegmentsRayLengthKm * interval1;

        float segmentLengthKm = max(distance1Km - distance0Km, 0.0);
        if (segmentLengthKm <= 0.0) {
            continue;
        }

        // Position sampled 30% of the way into this segment, not its
        // midpoint - matches Hillaire's own reference implementation
        // exactly (SKY_VIEW_SAMPLE_SEGMENT_T).
        float sampleDistanceKm = mix(distance0Km, distance1Km, kSkyViewSampleSegmentT);

        // Computed directly from the origin rather than incrementing a
        // running position, avoiding accumulated floating-point error.
        vec3 currentPositionKm = rayOrigin + viewDirection * sampleDistanceKm;
        float radialLengthKm = length(currentPositionKm);
        vec3 upAtSample = currentPositionKm / max(radialLengthKm, 1e-20);
        float currentHeightKm = clamp(radialLengthKm - planetRadiusKm, 0.0, atmosphereParameters.atmosphereThicknessKm);

        vec2 lutUv = HeightZenithToTransmittanceLutUv(atmosphereParameters, currentHeightKm, dot(upAtSample, directionToSun));
        vec3 transmittanceToSun = texture(transmittanceLut, ClampLutUvHalfTexelInset(lutUv, transmittanceLutSize)).rgb;
        vec3 multipleScatteredLuminance =
            texture(multiScatteringLut, ClampLutUvHalfTexelInset(lutUv, multiScatteringLutSize)).rgb;

        float rayleighDensity = RayleighDensityAtHeight(atmosphereParameters, currentHeightKm);
        float mieDensity = MieDensityAtHeight(atmosphereParameters, currentHeightKm);
        vec3 scatterRayleigh = atmosphereParameters.rayleighScattering * rayleighDensity;
        vec3 scatterMie = atmosphereParameters.mieScattering * mieDensity;
        vec3 totalScattering = scatterRayleigh + scatterMie;
        vec3 extinctionCoefficient = ComputeExtinctionCoefficientAtHeight(atmosphereParameters, currentHeightKm);

        float planetVisibility = PlanetVisibility(currentPositionKm, directionToSun, planetRadiusKm);

        // Direct sunlight scattered toward the camera.
        vec3 phaseTimesScattering = scatterRayleigh * rayleighPhaseValue + scatterMie * miePhaseValue;
        vec3 directSource = planetVisibility * transmittanceToSun * phaseTimesScattering;

        // The multiple-scattering LUT already represents incoming
        // multiple-scattered luminance - multiplied by LOCAL scattering
        // only here, never by the direct solar transmittance/shadow term
        // again (that would double-count it).
        vec3 multipleScatteringSource = multipleScatteredLuminance * totalScattering;

        vec3 source = sunRadiance * (directSource + multipleScatteringSource);
        vec3 segmentLuminance = IntegrateInscattering(source, extinctionCoefficient, segmentLengthKm);

        accumulatedLuminance += accumulatedTransmittance * segmentLuminance;

        vec3 segmentTransmittance = exp(-extinctionCoefficient * segmentLengthKm);
        accumulatedTransmittance *= segmentTransmittance;
    }

    imageStore(destinationImage, texel, vec4(accumulatedLuminance, 1.0));
}
