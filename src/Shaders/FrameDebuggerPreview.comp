#version 450

// task_manager/frame-debugger-3 campaign, PHASE6
// (PHASE6_CHANNELS_AND_LEVELS_REAL_PREVIEW.md) - the Frame Debugger's own
// Channels (All/R/G/B/A) + Levels preview-compositing shader. A direct GLSL
// transcription of src/Editor/FrameDebuggerPreviewProcessing.cpp's own
// ApplyFrameDebuggerPreviewTransform() (the pure CPU oracle - that file is
// right by definition; if this shader ever disagrees with it, THIS is what
// needs fixing, mirroring AtmosphereMath.h/VolumeTexturePreview.comp's own
// identical "CPU oracle first" precedent - see AGENTS.md, "Atmosphere
// Scattering").
//
// BINDING CONVENTION (matches
// src/Editor/FrameDebuggerPreviewProcessing.cpp exactly - see
// Vulkan/DescriptorSetLayoutBuilder.h's own documented "read-only Texture
// first, RWTexture output last" ordering): binding 0 = the source retained
// history preview texture (read-only combined image sampler, 1:1 same size
// as the output - see FrameDebuggerPreviewRenderer::EnsureOutputTexture()),
// binding 1 = this shader's own persistent RGBA8 output image.
//
// local_size_x/y = 16 - matches this codebase's other 2D-output compute
// passes (e.g. src/Shaders/VolumeTexturePreview.comp) - MUST match
// FrameDebuggerPreviewProcessing.h's own kLocalSizeX/kLocalSizeY constants
// exactly.
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D sourceTex;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// MUST match FrameDebuggerPreviewProcessing.cpp's own PushConstants struct
// exactly - three plain scalars, no vec3/std140 alignment concerns.
// `channel`: 0=All, 1=R, 2=G, 3=B, 4=A - matches
// gte::FrameDebuggerPreviewChannel's own declaration order exactly (see
// FrameDebuggerPreviewProcessing.h).
layout(push_constant) uniform PushConstants {
    int channel;
    float levelsBlack;
    float levelsWhite;
} pc;

// A direct GLSL transcription of FrameDebuggerPreviewProcessing.cpp's own
// anonymous-namespace RemapLevels() - identical formula.
float RemapLevels(float value, float levelsBlack, float levelsWhite)
{
    float denom = max(levelsWhite - levelsBlack, 1e-5);
    return clamp((value - levelsBlack) / denom, 0.0, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(outputImage);
    if (pixel.x >= outSize.x || pixel.y >= outSize.y) {
        return;
    }

    // The output image is always created at the source's own exact size
    // (see FrameDebuggerPreviewRenderer::EnsureOutputTexture()) - a plain
    // pixel-center UV lookup is therefore always a 1:1 texel mapping, never
    // a resample.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(outSize);
    vec4 src = texture(sourceTex, uv);

    vec4 leveled = vec4(RemapLevels(src.r, pc.levelsBlack, pc.levelsWhite), RemapLevels(src.g, pc.levelsBlack, pc.levelsWhite),
        RemapLevels(src.b, pc.levelsBlack, pc.levelsWhite), RemapLevels(src.a, pc.levelsBlack, pc.levelsWhite));

    vec4 result;
    if (pc.channel == 1) {
        result = vec4(leveled.r, leveled.r, leveled.r, 1.0); // R
    } else if (pc.channel == 2) {
        result = vec4(leveled.g, leveled.g, leveled.g, 1.0); // G
    } else if (pc.channel == 3) {
        result = vec4(leveled.b, leveled.b, leveled.b, 1.0); // B
    } else if (pc.channel == 4) {
        result = vec4(leveled.a, leveled.a, leveled.a, 1.0); // A
    } else {
        result = leveled; // All (pc.channel == 0)
    }

    imageStore(outputImage, pixel, result);
}
