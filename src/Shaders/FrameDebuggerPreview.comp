#version 450

// Channels and levels preview of a retained frame texture. Mirrors ApplyFrameDebuggerPreviewTransform() in
// FrameDebuggerPreviewProcessing.cpp; if they disagree, the CPU function is right.
// Bindings by name: sourceTex (sampled source) and outputImage (same-size RGBA8 output).
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D sourceTex;
layout(binding = 1, rgba8) uniform writeonly image2D outputImage;

// Matches PushConstants in FrameDebuggerPreviewProcessing.cpp. `channel` follows FrameDebuggerPreviewChannel:
// 0=All, 1=R, 2=G, 3=B, 4=A.
layout(push_constant) uniform PushConstants {
    int channel;
    float levelsBlack;
    float levelsWhite;
} pc;

// Same formula as RemapLevels() in FrameDebuggerPreviewProcessing.cpp.
float RemapLevels(float value, float levelsBlack, float levelsWhite)
{
    float denom = max(levelsWhite - levelsBlack, 1e-5);
    return clamp((value - levelsBlack) / denom, 0.0, 1.0);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(outputImage);
    if (pixel.x >= outSize.x || pixel.y >= outSize.y) {
        return;
    }

    // The output has the source's size, so this is a 1:1 texel lookup.
    vec2 uv = (vec2(pixel) + 0.5) / vec2(outSize);
    vec4 src = texture(sourceTex, uv);

    vec4 leveled = vec4(RemapLevels(src.r, pc.levelsBlack, pc.levelsWhite), RemapLevels(src.g, pc.levelsBlack, pc.levelsWhite),
        RemapLevels(src.b, pc.levelsBlack, pc.levelsWhite), RemapLevels(src.a, pc.levelsBlack, pc.levelsWhite));

    vec4 result;
    if (pc.channel == 1) {
        result = vec4(leveled.r, leveled.r, leveled.r, 1.0); // R
    } else if (pc.channel == 2) {
        result = vec4(leveled.g, leveled.g, leveled.g, 1.0); // G
    } else if (pc.channel == 3) {
        result = vec4(leveled.b, leveled.b, leveled.b, 1.0); // B
    } else if (pc.channel == 4) {
        result = vec4(leveled.a, leveled.a, leveled.a, 1.0); // A
    } else {
        result = leveled; // All (pc.channel == 0)
    }

    imageStore(outputImage, pixel, result);
}
