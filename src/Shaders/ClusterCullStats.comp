#version 450

// Copies the cluster cull survivor count into a readback buffer.
layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer CountBlock {
    uint value;
} count;

layout(std430, binding = 1) writeonly buffer OutCountBlock {
    uint value;
} outCount;

void main()
{
    outCount.value = count.value;
}
