#version 450

// GPU vertex skinning, position + normal variant. Mirrors SkinVertexRange() in Animation/VertexSkinning.cpp.
// Buffer layouts must match src/Renderer/GpuSkinning/GpuSkinningTypes.h; the C++ side binds by the names below.
//   bindPose (read-only), skinWeights (read-only), boneMatrices (read-only), outputBuffer (tightly packed floats)
// local_size_x must equal kSkinningLocalSizeX in GpuSkinningPipelines.h.
layout(local_size_x = 256) in;

// Matches GpuBindPoseVertex (GpuSkinningTypes.h) exactly: position padded to
// a vec4, normal padded to a vec4 (32 bytes total, std430 vec4+vec4).
struct BindPoseVertex {
    vec4 positionAndPad;
    vec4 normalAndPad;
};
layout(std430, binding = 0) readonly buffer BindPoseBuffer {
    BindPoseVertex vertices[];
} bindPose;

// Matches GpuSkinWeights (GpuSkinningTypes.h) exactly: 4 bone indices (as
// uvec4, matching GLSL's own unsigned convention) followed by 4 weights (as
// vec4) - 32 bytes total, std430 uvec4+vec4.
struct SkinWeightsEntry {
    uvec4 boneIndices;
    vec4 weights;
};
layout(std430, binding = 1) readonly buffer SkinWeightsBuffer {
    SkinWeightsEntry entries[];
} skinWeights;

// Plain mat4[] - Mat4::Data() (src/Math/Mat4.h) is already column-major,
// matching GLSL's mat4 layout exactly, so this needs zero repacking on the
// C++ side (see GpuSkinningTypes.h's own Step 3.3 reasoning). Re-uploaded
// every frame, for every currently-playing animator - the one genuinely
// dynamic input among this shader's four bindings.
layout(std430, binding = 2) readonly buffer BoneMatricesBuffer {
    mat4 matrices[];
} boneMatrices;

// Tightly-packed output - matches GpuSkinnedVertexPositionNormal
// (GpuSkinningTypes.h) exactly: 6 floats per vertex (position.xyz,
// normal.xyz), stride 6, NO std430 vec-padding. Declared as a flat float
// array with manually computed offsets (per GpuSkinningTypes.h's own Step
// 3.4 reasoning) specifically to avoid std430's automatic vec3/vec4
// alignment rules applying to an output layout that must stay tightly
// packed to remain byte-compatible with MeshVertex.
layout(std430, binding = 3) buffer OutputBuffer {
    float values[];
} outputBuffer;

layout(push_constant) uniform PushConstants {
    uint vertexCount;
} pc;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.vertexCount) {
        // ComputeGroupCount()'s own documented ceiling-division overshoot -
        // see ComputeDispatch.h. These extra invocations simply do nothing.
        return;
    }

    vec3 bindPosition = bindPose.vertices[i].positionAndPad.xyz;
    vec3 bindNormal = bindPose.vertices[i].normalAndPad.xyz;

    uvec4 boneIndices = skinWeights.entries[i].boneIndices;
    vec4 weights = skinWeights.entries[i].weights;
    uint boneCount = uint(boneMatrices.matrices.length());

    vec3 skinnedPosition = vec3(0.0);
    vec3 skinnedNormal = vec3(0.0);
    float totalWeight = 0.0;

    for (int slot = 0; slot < 4; ++slot) {
        float weight = weights[slot];
        uint boneIndex = boneIndices[slot];

        // Mirrors VertexSkinning.cpp's SkinVertexRange() exactly: an unused
        // slot (weight == 0.0 - see GpuSkinningTypes.h's PackSkinWeights(),
        // which packs every unused slot as bone 0 / weight 0.0, NEVER a raw
        // bit-reinterpreted -1) contributes nothing, and a bone index that
        // is somehow out of range against the ACTUAL bone-matrix buffer
        // size this frame is defensively skipped too, matching the CPU
        // path's own `static_cast<std::size_t>(boneIndex) >= boneCount`
        // bounds check.
        if (weight == 0.0 || boneIndex >= boneCount) {
            continue;
        }

        mat4 m = boneMatrices.matrices[boneIndex];

        // (m * vec4(bindPosition, 1.0)).xyz mirrors Mat4::TransformPoint()
        // (w=1, applies translation) exactly; mat3(m) * bindNormal mirrors
        // Mat4::TransformVector() (w=0, ignores translation) exactly - NOT
        // Mat4::TransformNormal()'s inverse-transpose - see
        // VertexSkinning.cpp's own call sites, which use TransformVector()
        // for the normal, not TransformNormal().
        vec3 transformedPosition = (m * vec4(bindPosition, 1.0)).xyz;
        vec3 transformedNormal = mat3(m) * bindNormal;

        skinnedPosition += transformedPosition * weight;
        skinnedNormal += transformedNormal * weight;
        totalWeight += weight;
    }

    vec3 finalPosition;
    vec3 finalNormal;
    if (totalWeight > 0.0) {
        // BDEF4 weights aren't guaranteed to sum to 1.0 by the format
        // itself - normalize by the ACTUAL total, exactly like
        // VertexSkinning.cpp's SkinVertexRange() does, never assuming
        // pre-normalized input.
        finalPosition = skinnedPosition / totalWeight;
        finalNormal = normalize(skinnedNormal);
    } else {
        // No valid influence at all (every slot unused/out of range) -
        // degrade to the bind pose exactly like the CPU path, never
        // collapsing to the origin.
        finalPosition = bindPosition;
        finalNormal = bindNormal;
    }

    uint base = i * 6u;
    outputBuffer.values[base + 0] = finalPosition.x;
    outputBuffer.values[base + 1] = finalPosition.y;
    outputBuffer.values[base + 2] = finalPosition.z;
    outputBuffer.values[base + 3] = finalNormal.x;
    outputBuffer.values[base + 4] = finalNormal.y;
    outputBuffer.values[base + 5] = finalNormal.z;
}
