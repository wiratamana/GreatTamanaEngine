#version 450

// Linear: finalColor = sceneColor * transmittance + inScatter, using the integrated volume at the pixel's distance.
layout(local_size_x = 16, local_size_y = 16) in;

#include "VolumetricLightCommon.glsl"

layout(push_constant) uniform PushConstants {
    mat4 invViewProjection;
    vec4 eyeAndMaxDistance;
    vec4 strengthExponentReserved;      // x strength, y exponent, z fog max distance (0 = all), w reserved.
    uvec4 frameAndDebug;                // x frame index, y debug view (0 off, 1 in-scatter, 2 transmittance), z sky distance fraction (float bits).
} pc;

layout(binding = 0) uniform sampler2D sourceColor;
layout(binding = 1) uniform sampler2D sourceDepth;
layout(binding = 2) uniform sampler3D integratedVolume;
layout(binding = 3, rgba16f) uniform writeonly image2D destinationImage;

vec4 SampleIntegratedVolume(vec2 uv, float rayDistance, float maxDistance, float exponent, float rangeFade)
{
    float sliceCount = float(textureSize(integratedVolume, 0).z);
    float slice = ViewDepthToFroxelSlice(rayDistance, sliceCount, maxDistance, exponent);
    // A slice holds the value at its far boundary, but texel centres sit half a texel inside.
    float halfTexel = 0.5 / sliceCount;
    float sliceUv = clamp(slice / sliceCount - halfTexel, halfTexel, 1.0 - halfTexel);
    vec4 fog = texture(integratedVolume, vec3(uv, sliceUv));
    if (HasNonFinite(fog)) {
        fog = vec4(0.0, 0.0, 0.0, 1.0);
    }
    return mix(vec4(0.0, 0.0, 0.0, 1.0), fog, clamp(slice, 0.0, 1.0) * rangeFade); // Fade in over the first slice.
}

void main()
{
    ivec2 outSize = imageSize(destinationImage);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= outSize.x || texel.y >= outSize.y) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(outSize);
    float depth = texture(sourceDepth, uv).r;
    vec3 scene = texture(sourceColor, uv).rgb;

    float maxDistance = pc.eyeAndMaxDistance.w;
    float exponent = pc.strengthExponentReserved.y;
    vec4 fog;
    if (depth < kClearDepthThreshold) {
        // Surfaces beyond maxDistance fade the volume out up to twice the range and get none after that.
        vec4 w = pc.invViewProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
        float surfaceDistance = length(w.xyz / w.w - pc.eyeAndMaxDistance.xyz);
        float rangeFade = 1.0 - smoothstep(maxDistance, 2.0 * maxDistance, surfaceDistance);
        fog = SampleIntegratedVolume(uv, min(surfaceDistance, maxDistance), maxDistance, exponent, rangeFade);
    } else {
        // Sky pixels keep plain fog within its own range and clamp transmittance so near fog cannot darken the sky.
        float rawSkyFraction = uintBitsToFloat(pc.frameAndDebug.z);
        float skyFraction = (isnan(rawSkyFraction) || isinf(rawSkyFraction)) ? 0.0 : clamp(rawSkyFraction, 0.0, 1.0);
        float fogRange = pc.strengthExponentReserved.z;
        float plainRange = (fogRange > 0.0 && fogRange < maxDistance) ? fogRange : maxDistance;
        fog = ClampSkyPlainFog(SampleIntegratedVolume(uv, plainRange * skyFraction, maxDistance, exponent, 1.0));
        float mistSkyDistance = maxDistance * skyFraction;
        if (fogRange > 0.0 && mistSkyDistance > fogRange) {
            vec4 fogEnd = SampleIntegratedVolume(uv, fogRange, maxDistance, exponent, 1.0);
            vec4 fogFar = SampleIntegratedVolume(uv, mistSkyDistance, maxDistance, exponent, 1.0);
            fog = CombineSkyMistFog(fog, fogEnd, fogFar);
        }
    }

    float strength = pc.strengthExponentReserved.x;
    vec3 inScatter = fog.rgb * strength;
    float transmittance = mix(1.0, fog.a, strength);

    vec3 color = scene;
    if (pc.frameAndDebug.y == 1u) {
        color = inScatter;
    } else if (pc.frameAndDebug.y == 2u) {
        color = vec3(transmittance);
    } else if (transmittance < 0.9999 || max(inScatter.r, max(inScatter.g, inScatter.b)) > 1e-5) {
        color = scene * transmittance + inScatter;
    }
    imageStore(destinationImage, texel, vec4(max(color, vec3(0.0)), 1.0));
}
