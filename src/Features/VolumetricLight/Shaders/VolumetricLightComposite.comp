#version 450

// Linear: finalColor = sceneColor * transmittance + inScatter, using the integrated volume at the pixel's distance.
layout(local_size_x = 16, local_size_y = 16) in;

#include "VolumetricLightCommon.glsl"

layout(push_constant) uniform PushConstants {
    mat4 invViewProjection;
    vec4 eyeAndMaxDistance;
    vec4 strengthExponentReserved;      // x strength, y exponent, z and w reserved.
    uvec4 frameAndDebug;                // x frame index, y debug view (0 off, 1 in-scatter, 2 transmittance), z sky distance fraction (float bits).
} pc;

layout(binding = 0) uniform sampler2D sourceColor;
layout(binding = 1) uniform sampler2D sourceDepth;
layout(binding = 2) uniform sampler3D integratedVolume;
layout(binding = 3, rgba16f) uniform writeonly image2D destinationImage;

void main()
{
    ivec2 outSize = imageSize(destinationImage);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= outSize.x || texel.y >= outSize.y) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(outSize);
    float depth = texture(sourceDepth, uv).r;
    vec3 scene = texture(sourceColor, uv).rgb;

    // Sky pixels see a fraction of the fog column.
    float maxDistance = pc.eyeAndMaxDistance.w;
    float distance = maxDistance * uintBitsToFloat(pc.frameAndDebug.z);
    if (depth < kSkyDepth) {
        vec4 w = pc.invViewProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
        distance = min(length(w.xyz / w.w - pc.eyeAndMaxDistance.xyz), maxDistance);
    }

    float sliceCount = float(textureSize(integratedVolume, 0).z);
    float slice = ViewDepthToFroxelSlice(distance, sliceCount, maxDistance, pc.strengthExponentReserved.y);

    // A slice holds the value at its far boundary, but texel centres sit half a texel inside.
    float halfTexel = 0.5 / sliceCount;
    float sliceUv = clamp(slice / sliceCount - halfTexel, halfTexel, 1.0 - halfTexel);
    vec4 fog = texture(integratedVolume, vec3(uv, sliceUv));
    if (HasNonFinite(fog)) {
        fog = vec4(0.0, 0.0, 0.0, 1.0);
    }
    fog = mix(vec4(0.0, 0.0, 0.0, 1.0), fog, clamp(slice, 0.0, 1.0)); // Fade in over the first slice.

    float strength = pc.strengthExponentReserved.x;
    vec3 inScatter = fog.rgb * strength;
    float transmittance = mix(1.0, fog.a, strength);

    vec3 color = scene;
    if (pc.frameAndDebug.y == 1u) {
        color = inScatter;
    } else if (pc.frameAndDebug.y == 2u) {
        color = vec3(transmittance);
    } else if (transmittance < 0.9999 || max(inScatter.r, max(inScatter.g, inScatter.b)) > 1e-5) {
        color = scene * transmittance + inScatter;
    }
    imageStore(destinationImage, texel, vec4(max(color, vec3(0.0)), 1.0));
}
