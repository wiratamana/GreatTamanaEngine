#version 450

// Per pixel: ray against the wave height field, shading, shore fade, foam and wet shore.
// Writes rgb + coverage and the window depth the composite draw stores into the scene depth.
#include "ScreenSpaceCommon.glsl"
#include "AtmosphereCommon.glsl"
#include "CloudShadowLookup.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

struct WaterWave {
    vec4 dirAndK;  // xy direction, z wave number, w crest exponent.
    vec4 ampPhase; // x amplitude, y frequency, z phase offset, w profile mean.
};

// Member names and order match WaterShadeParamsGpu.
layout(std430, binding = 0) readonly buffer WaterShadeParams {
    mat4 invViewProjection;
    mat4 viewProjection;
    vec4 eyeTime;          // xyz eye, w time.
    vec4 viewInfo;         // x pixel scale, yz jitter NDC, w sea level.
    vec4 sunDirection;     // xyz toward the sun, w sun specular.
    vec4 sunRadiance;      // rgb sun illuminance, w sky intensity.
    vec4 skyInfo;          // x eye height km, y planet radius km, z sky valid, w ambient scale.
    vec4 shallowColor;     // rgb, w clarity.
    vec4 deepColor;        // rgb, w refraction strength.
    vec4 foamColor;        // rgb, w crest foam.
    vec4 surfaceInfo;      // x shore foam, y shore width, z roughness, w reflection strength.
    vec4 rippleInfo;       // x ripple strength, y wave lod scale, z absorption, w max distance.
    vec4 wetInfo;          // x wet band, y wet strength, z wet fade distance, w ssr max distance.
    uvec4 counts;          // x wave count, y debug view, z ssr steps, w flags.
    vec4 cloudShadowGrid;  // xy map centre xz (m), z 1 / extent (m), w strength.
    vec4 cloudShadowLayer; // x layer base (m), y layer top (m), z sharpness, w map size.
    vec4 ripple[2];        // x scale, yz wrapped offset, w period.
    WaterWave waves[8];
} params;

struct WaterBodyHeader {
    vec4 info;   // x kind (0 ocean, 1 box, 2 polygon, 3 river), y level, z wave scale, w id.
    vec4 bounds; // xz min, xz max in world metres.
    uvec4 range; // x first point, y point count.
    vec4 shape;  // x flow speed, y lowest level, z highest level.
};

// Member names and order match WaterBodiesGpu.
layout(std430, binding = 6) readonly buffer WaterBodyTable {
    uvec4 counts; // x body count.
    WaterBodyHeader headers[16];
    vec4 points[256]; // xz world position, z river level, w river half width.
} bodies;

layout(binding = 1) uniform sampler2D sceneDepth;
layout(binding = 2) uniform sampler2D sceneColor;
layout(binding = 3) uniform sampler2D skyViewLut;
layout(binding = 4, rgba16f) uniform writeonly image2D waterColorOut; // rgb radiance, a coverage.
layout(binding = 5, r32f) uniform writeonly image2D waterDepthOut;    // Window depth.
layout(set = 0, binding = 7) uniform sampler2D cloudShadowMap;

const float kMaxWaterDepth = 0.99999; // Below kClearDepthThreshold so far water still counts as a surface.
const float kDirectScale = 0.65;      // Same sun energy scale as the lit material shaders.
const vec3 kAmbient = vec3(0.95, 1.0, 1.05);
const uint kFlagSsr = 1u;
const uint kFlagWet = 2u;
const uint kFlagSky = 4u;
const uint kFlagCloudShadow = 8u;

float SampleWaterCloudShadow(vec3 worldPos, vec3 sunDir)
{
    if ((params.counts.w & 8u) == 0u) {
        return 1.0;
    }
    return CloudSunTransmittanceFast(cloudShadowMap, params.cloudShadowGrid, params.cloudShadowLayer, sunDir, worldPos);
}

float Hash21(vec2 p)
{
    uvec2 q = uvec2(ivec2(p));
    uint h = q.x * 1597334673u ^ q.y * 3812015801u;
    h = (h ^ (h >> 16)) * 2246822519u;
    h ^= h >> 13;
    h *= 3266489917u;
    h ^= h >> 16;
    return float(h) * (1.0 / 4294967296.0);
}

// Value noise and its derivative; the lattice repeats every `period` cells so the pattern follows the eye wrap.
vec3 ValueNoiseD(vec2 x, float period)
{
    vec2 i = floor(x);
    vec2 f = x - i;
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    vec2 i0 = mod(i, period);
    vec2 i1 = mod(i + vec2(1.0), period);
    float a = Hash21(i0);
    float b = Hash21(vec2(i1.x, i0.y));
    float c = Hash21(vec2(i0.x, i1.y));
    float d = Hash21(i1);
    float k1 = b - a;
    float k2 = c - a;
    float k4 = a - b - c + d;
    float value = a + k1 * u.x + k2 * u.y + k4 * u.x * u.y;
    return vec3(value, du * vec2(k1 + k4 * u.y, k2 + k4 * u.x));
}

// Wave height at eye-relative xz. `footprint` is the world size of a pixel there; fine waves fade out below it.
float WaveHeight(vec2 rel, float footprint, float scale)
{
    float h = 0.0;
    uint n = min(params.counts.x, 8u);
    for (uint i = 0u; i < n; ++i) {
        WaterWave w = params.waves[i];
        float fade = smoothstep(4.0, 14.0, (6.2831853 / w.dirAndK.z) / (footprint * params.rippleInfo.y));
        if (fade <= 0.0) {
            continue;
        }
        float theta = w.dirAndK.z * dot(w.dirAndK.xy, rel) + w.ampPhase.z;
        float s = 0.5 + 0.5 * sin(theta);
        h += scale * w.ampPhase.x * fade * (pow(max(s, 1e-5), w.dirAndK.w) - w.ampPhase.w);
    }
    return h;
}

// Height, slope (d/dx, d/dz) and the sum of the faded amplitudes.
void WaveSurface(vec2 rel, float footprint, float scale, out float h, out vec2 slope, out float ampSum)
{
    h = 0.0;
    slope = vec2(0.0);
    ampSum = 0.0;
    uint n = min(params.counts.x, 8u);
    for (uint i = 0u; i < n; ++i) {
        WaterWave w = params.waves[i];
        float amp = scale * w.ampPhase.x * smoothstep(4.0, 14.0, (6.2831853 / w.dirAndK.z) / (footprint * params.rippleInfo.y));
        if (amp <= 0.0) {
            continue;
        }
        float theta = w.dirAndK.z * dot(w.dirAndK.xy, rel) + w.ampPhase.z;
        float sn = sin(theta);
        float s = 0.5 + 0.5 * sn;
        float e = w.dirAndK.w;
        float sPow = pow(max(s, 1e-5), e - 1.0);
        h += amp * (sPow * s - w.ampPhase.w);
        slope += w.dirAndK.xy * (amp * e * sPow * 0.5 * cos(theta) * w.dirAndK.z);
        ampSum += amp;
    }
}

// Small drifting ripples: slope and a foam noise value. Fades out when a ripple is smaller than a pixel.
vec2 RippleSlope(vec2 rel, float footprint, vec2 flow, out float foamNoise)
{
    vec4 l0 = params.ripple[0];
    vec4 l1 = params.ripple[1];
    vec2 moved = rel - flow * params.eyeTime.w;
    float f0 = 1.0 - smoothstep(0.1, 0.5, footprint * l0.x);
    float f1 = 1.0 - smoothstep(0.1, 0.5, footprint * l1.x);
    vec3 n0 = vec3(0.5, 0.0, 0.0);
    vec3 n1 = vec3(0.5, 0.0, 0.0);
    if (f0 > 0.0) {
        n0 = ValueNoiseD(moved * l0.x + l0.yz, l0.w);
    }
    if (f1 > 0.0) {
        n1 = ValueNoiseD(moved * l1.x + l1.yz, l1.w);
    }
    foamNoise = n0.x * 0.6 + n1.x * 0.4;
    return params.rippleInfo.x * (0.15 * l0.x * f0 * n0.yz + 0.07 * l1.x * f1 * n1.yz);
}

bool PolygonContains(WaterBodyHeader h, vec2 pw)
{
    bool inside = false;
    uint first = h.range.x;
    uint n = h.range.y;
    vec2 prev = bodies.points[first + n - 1u].xy;
    for (uint i = 0u; i < n; ++i) {
        vec2 cur = bodies.points[first + i].xy;
        if ((cur.y > pw.y) != (prev.y > pw.y) && pw.x < (prev.x - cur.x) * (pw.y - cur.y) / (prev.y - cur.y) + cur.x) {
            inside = !inside;
        }
        prev = cur;
    }
    return inside;
}

// Distance to the river centre line minus the half width there (negative = inside), with level and flow direction.
// Only segments first..last are tested; `segment` returns the nearest one.
float RiverQuery(WaterBodyHeader h, vec2 pw, uint firstSegment, uint lastSegment, out float level, out vec2 tangent,
    out uint segment)
{
    float best = 1e30;
    level = h.info.y;
    tangent = vec2(1.0, 0.0);
    segment = firstSegment;
    uint first = h.range.x;
    for (uint i = firstSegment; i <= lastSegment; ++i) {
        vec4 a = bodies.points[first + i];
        vec4 b = bodies.points[first + i + 1u];
        vec2 ab = b.xy - a.xy;
        float l2 = dot(ab, ab);
        float u = l2 > 1e-6 ? clamp(dot(pw - a.xy, ab) / l2, 0.0, 1.0) : 0.0;
        float d = length(pw - (a.xy + ab * u)) - mix(a.w, b.w, u);
        if (d < best) {
            best = d;
            level = mix(a.z, b.z, u);
            tangent = l2 > 1e-6 ? ab * inversesqrt(l2) : vec2(1.0, 0.0);
            segment = i;
        }
    }
    return best;
}

struct BodyHit {
    bool valid;
    float t;
    float level;
    float waveScale;
    vec2 flow;
    uint id;
};

// Nearest water surface along the ray among all bodies the eye looks down on.
BodyHit PickBody(vec3 origin, vec3 dir, float tScene)
{
    BodyHit best;
    best.valid = false;
    best.t = 1e30;
    best.level = 0.0;
    best.waveScale = 1.0;
    best.flow = vec2(0.0);
    best.id = 0u;
    if (dir.y > -1e-5) {
        return best;
    }
    vec2 eyeXZ = params.eyeTime.xz;
    float limit = min(tScene, params.rippleInfo.w);
    uint n = min(bodies.counts.x, 16u);
    for (uint i = 0u; i < n; ++i) {
        WaterBodyHeader h = bodies.headers[i];
        float level = h.info.y;
        float levelRel = level - params.eyeTime.y;
        if (levelRel >= origin.y - 0.05) {
            continue; // The eye is not above this body.
        }
        float t = (levelRel - origin.y) / dir.y;
        if (t <= 0.0 || t >= min(best.t, limit)) {
            continue;
        }
        vec2 pw = eyeXZ + origin.xz + dir.xz * t;
        uint kind = uint(h.info.x + 0.5);
        vec2 flow = vec2(0.0);
        if (kind != 0u && (any(lessThan(pw, h.bounds.xy)) || any(greaterThan(pw, h.bounds.zw)))) {
            continue;
        }
        if (kind == 2u && !PolygonContains(h, pw)) {
            continue;
        }
        if (kind == 3u) {
            // The river surface follows its centre line, so test again at the hit of the local level.
            vec2 tangent;
            float lv;
            uint segment;
            uint last = h.range.y - 2u;
            if (RiverQuery(h, pw, 0u, last, lv, tangent, segment) > 0.0) {
                continue;
            }
            t = (lv - params.eyeTime.y - origin.y) / dir.y;
            if (t <= 0.0 || t >= min(best.t, limit)) {
                continue;
            }
            pw = eyeXZ + origin.xz + dir.xz * t;
            if (RiverQuery(h, pw, segment == 0u ? 0u : segment - 1u, min(segment + 1u, last), lv, tangent, segment) > 0.0) {
                continue;
            }
            level = lv;
            flow = tangent * h.shape.x;
        }
        best.valid = true;
        best.t = t;
        best.level = level;
        best.waveScale = h.info.z;
        best.flow = flow;
        best.id = i;
    }
    return best;
}

// Darkening of dry ground close above a body's surface; `pos` is eye-relative.
float WetAmount(vec3 pos, float dist)
{
    float band = params.wetInfo.x;
    vec2 pw = params.eyeTime.xz + pos.xz;
    float amount = 0.0;
    uint n = min(bodies.counts.x, 16u);
    for (uint i = 0u; i < n; ++i) {
        WaterBodyHeader h = bodies.headers[i];
        float level = h.info.y;
        uint kind = uint(h.info.x + 0.5);
        if (kind == 3u) {
            vec2 tangent;
            float lv;
            uint segment;
            float y = pos.y + params.eyeTime.y;
            if (y < h.shape.y - 0.5 || y > h.shape.z + band
                || RiverQuery(h, pw, 0u, h.range.y - 2u, lv, tangent, segment) >= 30.0) {
                continue;
            }
            level = lv;
        } else if (kind != 0u && (any(lessThan(pw, h.bounds.xy - 30.0)) || any(greaterThan(pw, h.bounds.zw + 30.0)))) {
            continue;
        }
        float above = pos.y + params.eyeTime.y - level;
        if (above > -0.5 && above < band) {
            amount = max(amount, 1.0 - smoothstep(0.0, band, max(above, 0.0)));
        }
    }
    float distFade = 1.0 - smoothstep(0.5 * params.wetInfo.z, params.wetInfo.z, dist);
    return amount * params.wetInfo.y * distFade;
}

vec3 SkyRadiance(vec3 dir)
{
    if ((params.counts.w & kFlagSky) == 0u) {
        return vec3(0.35, 0.55, 0.9);
    }
    float viewHeightKm = max(params.skyInfo.x, params.skyInfo.y);
    vec2 uv = ViewDirectionToSkyViewLutUv(dir, textureSize(skyViewLut, 0), viewHeightKm, params.skyInfo.y);
    vec3 radiance = max(texture(skyViewLut, uv).rgb, vec3(0.0)) * params.sunRadiance.w;
    // Same horizon tint as the sky background so the far water meets the sky seamlessly.
    float horizonBlend = 1.0 - smoothstep(0.0, 0.2, dir.y);
    float luma = dot(radiance, vec3(0.2126, 0.7152, 0.0722));
    return mix(radiance, vec3(luma) * vec3(0.93, 0.98, 1.07), 0.6 * horizonBlend);
}

// Screen-space march of the reflected ray over the scene depth. Returns the hit colour (rgb) and weight (a).
vec4 TraceScreen(vec3 start, vec3 rdir, ivec2 size, float jitter)
{
    int steps = int(params.counts.z);
    float maxDist = params.wetInfo.w;
    vec2 sizeF = vec2(size);
    for (int i = 0; i < steps; ++i) {
        float s = (float(i) + jitter + 0.5) / float(steps);
        float d = maxDist * s * s + 0.5;
        vec3 pos = start + rdir * d;
        vec4 c = params.viewProjection * vec4(pos, 1.0);
        if (c.w <= 1e-3) {
            break;
        }
        vec3 ndc = c.xyz / c.w;
        vec2 uv = (ndc.xy + params.viewInfo.yz) * 0.5 + 0.5;
        if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) {
            break;
        }
        ivec2 q = ivec2(uv * sizeF);
        float sd = FetchDepth(sceneDepth, q);
        if (sd >= kClearDepthThreshold) {
            continue;
        }
        vec2 qndc = (vec2(q) + 0.5) / sizeF * 2.0 - 1.0 - params.viewInfo.yz;
        float invW = params.invViewProjection[0][3] * qndc.x + params.invViewProjection[1][3] * qndc.y
            + params.invViewProjection[2][3] * sd + params.invViewProjection[3][3];
        float sceneW = 1.0 / invW;
        float diff = c.w - sceneW;
        float thick = max(1.5, c.w * 0.04);
        if (diff > 0.0 && diff < thick) {
            vec2 edge = min(uv, 1.0 - uv);
            float fade = smoothstep(0.0, 0.08, min(edge.x, edge.y)) * (1.0 - smoothstep(0.85, 1.0, s));
            return vec4(texelFetch(sceneColor, q, 0).rgb, fade);
        }
    }
    return vec4(0.0);
}

// Sky (and optionally screen-space) radiance seen along the mirrored view ray; `weight` is the reflectance.
vec3 ReflectionColor(vec3 hit, vec3 dir, vec3 normal, ivec2 p, ivec2 size, float weight)
{
    vec3 reflected = reflect(dir, normal);
    reflected.y = max(reflected.y, 0.02);
    reflected = normalize(reflected);
    vec3 sky = SkyRadiance(reflected);
    if ((params.counts.w & kFlagSsr) != 0u && weight > 0.03) {
        float jitter = InterleavedGradientNoise(vec2(p) + vec2(37.0 * fract(params.eyeTime.w * 7.0)));
        vec4 screenHit = TraceScreen(hit, reflected, size, jitter);
        return mix(sky, screenHit.rgb, screenHit.a);
    }
    return sky;
}

float DistributionGgx(float nDotH, float alpha)
{
    float a2 = alpha * alpha;
    float d = nDotH * nDotH * (a2 - 1.0) + 1.0;
    return a2 / (3.14159265 * d * d);
}

void Store(ivec2 p, vec4 color, float depth)
{
    imageStore(waterColorOut, p, color);
    imageStore(waterDepthOut, p, vec4(depth));
}

void main()
{
    ivec2 size = imageSize(waterColorOut);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }
    // The scene images are full size; the water targets may be half size.
    ivec2 fullSize = textureSize(sceneDepth, 0);
    ivec2 fp = min(ivec2(vec2(p) * (vec2(fullSize) / vec2(size))), fullSize - ivec2(1));
    uint debugView = params.counts.y;
    bool debugging = debugView != 0u;

    // The scene was drawn with the TAA jitter; the unjittered camera sees the same pixel at ndc - jitter.
    vec2 ndc = (vec2(p) + 0.5) / vec2(size) * 2.0 - 1.0 - params.viewInfo.yz;
    // Half size: the top-left pixel of the 2x2 block; the composite depth test keeps the land edge exact.
    float depth = FetchDepth(sceneDepth, fp);
    bool hasScene = depth < kClearDepthThreshold;
    vec3 scenePos = vec3(0.0);
    if (hasScene) {
        vec2 sceneNdc = (vec2(fp) + 0.5) / vec2(fullSize) * 2.0 - 1.0 - params.viewInfo.yz;
        vec4 sceneH = params.invViewProjection * vec4(sceneNdc, depth, 1.0);
        scenePos = sceneH.xyz / sceneH.w;
    }

    vec4 nearH = params.invViewProjection * vec4(ndc, 0.0, 1.0);
    vec4 farH = params.invViewProjection * vec4(ndc, 1.0, 1.0);
    vec3 origin = nearH.xyz / nearH.w;
    vec3 dir = normalize(farH.xyz / farH.w - origin);
    float tScene = hasScene ? length(scenePos - origin) : 1e30;
    BodyHit body = PickBody(origin, dir, tScene);
    float tWater = body.t;
    float levelRel = body.level - params.eyeTime.y;
    bool candidate = body.valid;

    if (!candidate) {
        // Not water: optionally darken the dry terrain just above the water line.
        float wet = 0.0;
        if (hasScene && (params.counts.w & kFlagWet) != 0u) {
            wet = WetAmount(scenePos, tScene);
        }
        if (debugging) {
            vec3 neutral = vec3(0.0);
            if (debugView == 1u) {
                neutral = vec3(hasScene ? clamp(tScene / 2000.0, 0.0, 1.0) : 1.0);
            } else if (debugView == 9u) {
                neutral = vec3(wet);
            }
            Store(p, vec4(neutral, 1.0), depth);
            return;
        }
        if (wet <= 0.001) {
            Store(p, vec4(0.0), 0.0);
            return;
        }
        // Wet ground keeps its depth; soften porosity darkening slightly inside cloud shadows so diffuse fill stays readable.
        float shoreCloudVis = SampleWaterCloudShadow(params.eyeTime.xyz + scenePos, params.sunDirection.xyz);
        vec3 dry = texelFetch(sceneColor, fp, 0).rgb;
        Store(p, vec4(dry * mix(1.0, mix(0.55, 0.45, shoreCloudVis), wet), 1.0), depth);
        return;
    }

    // Plane hit, then fixed-point refinement against the wave height field.
    float pixelScale = params.viewInfo.x * (float(fullSize.x) / float(size.x)); // A half-size pixel covers twice the ground.
    float footprint = max(tWater * pixelScale, 1e-3);
    float t = tWater;
    if (params.counts.x > 0u) {
        for (int i = 0; i < 3; ++i) {
            vec3 q = origin + dir * t;
            float h = WaveHeight(q.xz, footprint, body.waveScale);
            float tNext = (levelRel + h - origin.y) / dir.y;
            t = clamp(tNext, tWater * 0.5, tWater * 1.5 + 2.0);
        }
    }
    if (t <= 0.0 || t >= tScene) {
        Store(p, debugging ? vec4(0.0, 0.0, 0.0, 1.0) : vec4(0.0), debugging ? depth : 0.0);
        return;
    }

    vec3 hit = origin + dir * t;
    footprint = max(t * pixelScale, 1e-3);
    float h;
    vec2 waveSlope;
    float ampSum;
    WaveSurface(hit.xz, footprint, body.waveScale, h, waveSlope, ampSum);
    float foamNoise;
    vec2 slope = waveSlope + RippleSlope(hit.xz, footprint, body.flow, foamNoise);
    vec3 normal = normalize(vec3(-slope.x, 1.0, -slope.y));

    vec3 viewDir = -dir;
    float nDotV = max(dot(normal, viewDir), 0.0);
    float fresnel = 0.02 + 0.98 * pow(1.0 - nDotV, 5.0);

    // Depth of the water column under this pixel.
    float surfaceY = levelRel + h;
    float verticalDepth = hasScene ? max(surfaceY - scenePos.y, 0.0) : 1e4;
    float rayDepth = hasScene ? max(tScene - t, 0.0) : 1e4;
    float clarity = params.shallowColor.w;
    float shoreWidth = params.surfaceInfo.y;
    float shoreMask = hasScene ? 1.0 - smoothstep(0.0, shoreWidth, verticalDepth) : 0.0;

    vec4 clip = params.viewProjection * vec4(hit, 1.0);
    float windowDepth = clamp(clip.z / max(clip.w, 1e-6), 0.0, kMaxWaterDepth);

    // Foam: wave crests (height against the amplitude sum) and a breaking band at the shore.
    float crestMetric = h / max(ampSum, 1e-3);
    float steep = smoothstep(0.05, 0.22, length(waveSlope));
    float breakup = smoothstep(0.42, 0.75, foamNoise);
    float crestFoam = smoothstep(0.34, 0.58, crestMetric) * (0.35 + 0.65 * steep) * breakup * params.foamColor.w
        * (1.0 - smoothstep(0.6, 3.0, footprint));
    float shoreLine = shoreMask * (0.35 + 0.65 * smoothstep(0.3, 0.8, foamNoise + 0.25 * sin(verticalDepth * 6.0 - params.eyeTime.w * 1.6)));
    float foam = clamp(crestFoam + shoreLine * params.surfaceInfo.x, 0.0, 1.0);

    if (debugging) {
        vec3 d = vec3(0.0);
        if (debugView == 1u) {
            d = vec3(clamp(t / 2000.0, 0.0, 1.0));
        } else if (debugView == 2u) {
            d = vec3(clamp(verticalDepth / max(clarity, 0.1), 0.0, 1.0));
        } else if (debugView == 3u) {
            d = vec3(shoreMask);
        } else if (debugView == 4u) {
            d = vec3(foam);
        } else if (debugView == 5u) {
            d = normal * 0.5 + 0.5;
        } else if (debugView == 6u) {
            d = vec3(clamp(0.5 + h / max(2.0 * ampSum, 1e-3), 0.0, 1.0));
        } else if (debugView == 7u) {
            d = ReflectionColor(hit, dir, normal, p, fullSize, fresnel) * fresnel;
        } else if (debugView == 8u) {
            d = vec3(Hash21(vec2(float(body.id), 3.0)), Hash21(vec2(float(body.id), 11.0)), Hash21(vec2(float(body.id), 29.0)));
        }
        Store(p, vec4(d, 1.0), windowDepth);
        return;
    }

    vec3 sunDir = params.sunDirection.xyz;
    float cloudVis = SampleWaterCloudShadow(params.eyeTime.xyz + hit, sunDir);

    // Light on the water body: hemisphere ambient stays unattenuated while clouds shade direct sun scatter.
    float sunUp = max(sunDir.y, 0.0);
    float bodySunVis = mix(0.12, 1.0, cloudVis);
    vec3 bodyLight = kAmbient * params.skyInfo.w + params.sunRadiance.rgb * (kDirectScale * sunUp * max(normal.y, 0.0) * bodySunVis);

    // Refraction: shift the seabed lookup by the surface slope, keep it only where it still lies behind the water.
    // Deep water hides the seabed, so its colour is not read at all.
    vec3 sigma = params.rippleInfo.z / clarity * vec3(1.9, 0.75, 0.55);
    vec3 transmit = hasScene ? exp(-sigma * rayDepth) : vec3(0.0);
    vec3 seabed = vec3(0.0);
    if (hasScene && max(transmit.r, max(transmit.g, transmit.b)) > 0.01) {
        vec2 shift = slope * params.deepColor.w * float(fullSize.y) * smoothstep(0.0, 1.5, verticalDepth);
        ivec2 p2 = clamp(fp + ivec2(shift), ivec2(0), fullSize - ivec2(1));
        float depth2 = FetchDepth(sceneDepth, p2);
        if (depth2 < windowDepth || depth2 >= kClearDepthThreshold) {
            p2 = fp;
        }
        seabed = texelFetch(sceneColor, p2, 0).rgb;
    }
    // Without collimated sun beams, shallow volume scatter shifts toward deeper sapphire tones.
    float deepMix = 1.0 - exp(-verticalDepth / clarity);
    float shadowedDeepMix = mix(deepMix, 1.0, 0.4 * (1.0 - cloudVis));
    vec3 bodyColor = mix(params.shallowColor.rgb, params.deepColor.rgb, shadowedDeepMix) * bodyLight;
    vec3 under = seabed * transmit + bodyColor * (1.0 - transmit);

    // Reflection: sky from the look-up table, screen-space hits when enabled.
    float shoreFresnel = smoothstep(0.0, 0.35, verticalDepth);
    float reflectWeight = fresnel * shoreFresnel;
    vec3 reflection = ReflectionColor(hit, dir, normal, p, fullSize, reflectWeight);
    vec3 color = mix(under, reflection * params.surfaceInfo.w, reflectWeight);

    // Sun glint vanishes rapidly as cloud optical depth scatters the solar disk cone.
    float nDotL = max(dot(normal, sunDir), 0.0);
    if (nDotL > 0.0 && sunDir.y > 0.0) {
        vec3 halfVec = normalize(sunDir + viewDir);
        float nDotH = clamp(dot(normal, halfVec), 0.0, 1.0);
        float vDotH = clamp(dot(viewDir, halfVec), 0.0, 1.0);
        float f = 0.02 + 0.98 * pow(1.0 - vDotH, 5.0);
        float a = params.surfaceInfo.z;
        float vis = 0.25 / max(max(nDotL, 0.1) * max(nDotV, 0.1), 1e-3);
        float glintVis = cloudVis * cloudVis;
        color += params.sunRadiance.rgb * (params.sunDirection.w * f * DistributionGgx(nDotH, a) * vis * nDotL * kDirectScale * 3.14159265 * clamp(sunDir.y * 8.0, 0.0, 1.0) * glintVis);
    }

    vec3 foamLight = kAmbient * params.skyInfo.w + params.sunRadiance.rgb * (kDirectScale * sunUp * mix(0.20, 1.0, cloudVis));
    color = mix(color, params.foamColor.rgb * foamLight, foam);
    Store(p, vec4(min(color, vec3(60000.0)), 1.0), windowDepth);
}
