#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// Read-only storage buffer - this engine's convention for compute shader parameters.
layout(std430, binding = 0) readonly buffer ShadowMaskParams {
    mat4 invViewProjection;       // Current view's own pixel -> world.
    mat4 lightViewProjection;     // World -> light clip space.
    vec4 biasAndStrengthAndTexel; // x=depthBias, y=unused, z=1/mapResolution, w=pad.
} params;

layout(binding = 1) uniform sampler2D shadowDepth;  // The shadow map itself.
layout(binding = 2) uniform sampler2D sceneDepth;   // Current view's own depth.
layout(binding = 3, r8) uniform writeonly image2D maskOutput; // Single channel, 0=lit 1=shadowed.

void main()
{
    ivec2 size = imageSize(maskOutput);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }

    vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    float depth = texture(sceneDepth, uv).r;
    if (depth >= 0.999999) { // Clear-depth sky pixel - nothing to shadow.
        imageStore(maskOutput, texel, vec4(0.0));
        return;
    }

    vec4 worldPos4 = params.invViewProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec3 worldPos = worldPos4.xyz / worldPos4.w;
    vec4 lightClip = params.lightViewProjection * vec4(worldPos, 1.0);
    vec3 lightNdc = lightClip.xyz / lightClip.w;
    vec2 lightUv = lightNdc.xy * 0.5 + 0.5;

    float shadowFactor = 0.0;
    float texelSize = params.biasAndStrengthAndTexel.z;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            float storedDepth = texture(shadowDepth, lightUv + vec2(x, y) * texelSize).r;
            shadowFactor += (lightNdc.z - params.biasAndStrengthAndTexel.x > storedDepth) ? 1.0 : 0.0;
        }
    }
    shadowFactor /= 9.0;

    imageStore(maskOutput, texel, vec4(shadowFactor));
}
