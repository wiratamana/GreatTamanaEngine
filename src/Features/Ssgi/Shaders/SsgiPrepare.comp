#version 450

// Per GI texel: scene radiance (rgb, luminance capped) with view depth (a), and the world normal from depth.
#include "SsgiCommon.glsl"
layout(local_size_x = 8, local_size_y = 8) in;

// Member names and order match SsgiPrepareParamsGpu.
layout(std430, binding = 0) readonly buffer SsgiPrepareParams {
    mat4 invViewProjection;
    vec4 eye;     // xyz eye.
    vec4 forward; // xyz forward.
    vec4 tuning;  // x max radiance.
    uvec4 counts; // x divisor.
} params;

layout(binding = 1) uniform sampler2D sceneDepth;
layout(binding = 2) uniform sampler2D sceneColor;
layout(binding = 3, rgba16f) uniform writeonly image2D ssgiColorOut;  // rgb radiance, a view depth (0 = no surface).
layout(binding = 4, rgba16f) uniform writeonly image2D ssgiNormalOut; // xyz world normal.

void main()
{
    ivec2 size = imageSize(ssgiColorOut);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }

    // GI texel i reads depth pixel i * divisor.
    ivec2 depthSize = textureSize(sceneDepth, 0);
    ivec2 colorSize = textureSize(sceneColor, 0);
    int div = int(max(params.counts.x, 1u));
    ivec2 pixel = min(p * div, depthSize - ivec2(1));
    float depth = FetchDepth(sceneDepth, pixel);
    if (depth >= kEmptyDepth) {
        imageStore(ssgiColorOut, p, vec4(0.0));
        imageStore(ssgiNormalOut, p, vec4(0.0));
        return;
    }

    vec3 eye = params.eye.xyz;
    vec3 position = UnprojectDepth(params.invViewProjection, pixel, depth, depthSize);
    float viewZ = dot(position - eye, params.forward.xyz);
    vec3 normal = NormalFromDepth(sceneDepth, params.invViewProjection, pixel, depth, position, eye);

    // Average the divisor x divisor block of scene color; texels with no surface are skipped.
    vec3 sum = vec3(0.0);
    float count = 0.0;
    for (int y = 0; y < div; ++y) {
        for (int x = 0; x < div; ++x) {
            ivec2 q = min(pixel + ivec2(x, y), depthSize - ivec2(1));
            if (FetchDepth(sceneDepth, q) >= kEmptyDepth) {
                continue;
            }
            sum += texelFetch(sceneColor, min(q, colorSize - ivec2(1)), 0).rgb;
            count += 1.0;
        }
    }
    vec3 radiance = sum / max(count, 1.0);
    float lum = dot(radiance, kLumaWeights);
    radiance *= min(1.0, params.tuning.x / max(lum, 1e-4));

    if (IsBad(radiance) || IsBad(normal) || viewZ <= 0.0) {
        imageStore(ssgiColorOut, p, vec4(0.0));
        imageStore(ssgiNormalOut, p, vec4(0.0));
        return;
    }
    imageStore(ssgiColorOut, p, vec4(radiance, viewZ));
    imageStore(ssgiNormalOut, p, vec4(normal, 0.0));
}
