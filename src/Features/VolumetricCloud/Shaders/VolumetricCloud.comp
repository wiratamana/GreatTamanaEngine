#version 450

// One cloud layer between two spheres below the camera, ray marched at a fraction of the view size.
// Writes the cloud light and transmittance; VolumetricCloudResolve.comp upsamples and composites it.
layout(local_size_x = 8, local_size_y = 8) in;

#include "SceneDepthConstants.glsl"
#include "AtmosphereCommon.glsl"

// Member names and order match VolumetricCloudParamsGpu.
layout(std430, binding = 0) readonly buffer VolumetricCloudParams {
    mat4 invViewProjection;         // Clip space to world position minus eye.
    vec4 eyeAndPlanetRadius;        // xyz eye, w planet radius (m).
    vec4 sunDirectionAndIntensity;  // xyz toward the sun, w sun intensity factor.
    vec4 sunColorAndAmbient;        // rgb sun radiance, w ambient intensity factor.
    vec4 ambientColor;              // rgb ambient radiance, w density curve exponent.
    vec4 layer;                     // x base, y top, z max distance, w fade start fraction.
    vec4 weather;                   // x weather tile (m), yz wind offset (m), w coverage.
    vec4 noise;                     // x shape tile (m), y detail tile (m), z detail strength, w detail fade (m).
    vec4 density;                   // x density factor, y extinction (1/m), z peak min, w jitter strength.
    vec4 heightShape;               // x base roundness, y top roundness, z density ramp, w density top fade.
    vec4 march;                     // x base step (m), y step growth, z coarse multiplier, w min transmittance.
    uvec4 counts;                   // x max steps, y frame index, z empty samples to coarse, w sun march stride.
    vec4 skip;                      // x clear-weather stride multiplier, y top falloff start, zw shape stretch low, high.
    vec4 lightMarch;                // x sun steps, y reach fraction of the thickness, z octaves, w powder.
    vec4 lightPhase;                // x forward g, y backward g, z backward mix, w silver intensity.
    vec4 lightScatter;              // x silver g, y octave attenuation, z octave contribution, w octave eccentricity.
    vec4 lightMisc;                 // x phase model, y ambient at the base, z haze distance (m), w light detail.
    vec4 drainePhase;               // x Henyey-Greenstein g, y Draine g, z Draine alpha, w Draine weight.
    uvec4 lowRes;                   // x divisor, yz sample offset inside the block, w sub-pixel jitter in percent of a pixel.
    uvec4 fullSize;                 // xy view size in pixels.
    vec4 atmosphereMode;            // x 1 = lit by the atmosphere LUTs, y sky intensity, z air scale, w sky ambient gain.
    vec4 atmosphereCamera;          // xyz camera position in atmosphere space (km).
    vec4 skyShade;                  // x sky occlusion strength, y its reach (m), z sky light floor, w ground bounce.
    vec4 skyShade2;                 // x ground bounce warmth, y blue shift of the scattering octaves, z far field start (m), w far weather mix.
    vec4 farField;                  // x far coverage lift, y far air distance scale, z max step optical depth, w in-scatter strength.
    vec4 detailShape;               // x curl amount (m), y curl tile (m), z wispiness, w fine detail weight.
    vec4 structure;                 // x large lobe mix, y size variation, zw wind shear vector at the layer top (m).
    vec4 structure2;                // x erosion kept in the body, y vertical stretch of the noise, z base variation, w far softening.
    vec4 structure3;                // x weight of the Worley cells in the shape (popcorn), y body threshold floor, z ragged base, w body ramp width.
    vec4 lightTune;                 // x sky light saturation, y diffusion gain, z inner glow gain, w reserved.
    vec4 lightTune2;                // x sun warmth, yzw reserved.
    vec4 shadowGrid;                // x map texel (m), yz map centre x, z (m), w 1 = write the cloud shadow map.
    vec4 shadowShift;               // xy history shift (m), z history blend, w optical depth factor.
    vec4 shadowTune;                // x edge blur (texels), y update interval (frames), z ray steps, w march: shaft strength (0 = none).
} params;

layout(binding = 1) uniform sampler2D sourceDepth;
layout(binding = 2) uniform sampler3D shapeVolume;   // R Perlin-Worley, GBA Worley fbm.
layout(binding = 3) uniform sampler3D detailVolume;  // R/G billowy low/high, B/A wispy low/high.
layout(binding = 4) uniform sampler2D weatherMap;    // R coverage, G high coverage (fill), B cloud type / peak (0 low top, 1 tall), A density.
layout(binding = 5) uniform sampler2D blueNoise;
layout(binding = 6, rgba16f) uniform writeonly image2D lowColorOut; // Cloud light in rgb, transmittance in a.
layout(binding = 7, rgba16f) uniform writeonly image2D lowAuxOut;   // x cloud distance, y complete up to (km).

// Sky LUTs of the atmosphere; bound to stand-ins when the standalone look is used.
layout(std430, binding = 8) readonly buffer AtmosphereParameters {
    AtmosphereParametersGpu values;
} atmosphere;
layout(binding = 9) uniform sampler2D transmittanceLut;
layout(binding = 10) uniform sampler2D multiScatteringLut;
layout(binding = 11) uniform sampler2D skyViewLut;
layout(binding = 12) uniform sampler2D curlMap;          // RG curl of a noise potential, B a second field.
layout(binding = 13) uniform sampler2D shadowHistory;    // Last cloud shadow map (r transmittance, g optical depth); a stand-in for the march.

const float kNoSurfaceKm = 1000.0;

const float kMinWidth = 1e-4;
const float kGoldenRatio = 0.61803398875;
const float kBlueNoiseSize = 128.0;
const float kMaxOutputLuminance = 65504.0;
const float kMinCoverageProduct = 0.02;
const float kGroundSlack = 0.5;
// The far weather map is the same file at this multiple of the weather tile, shifted by kFarWeatherOffset tiles. The
// factor makes the wind period of the three noise tiles (see CloudWindPeriodM) a whole number of far tiles.
const float kFarWeatherTileScale = 2.8;
const vec2 kFarWeatherOffset = vec2(0.37, 0.61);
// The second, finer fetch of the detail noise reads it at this multiple of the detail frequency.
const float kFineDetailScale = 3.1;
const float kShapeWorleyMean = 0.5;
// The large lobe octave reads the shape volume at this multiple of the shape tile, shifted so it is not a copy of the mid octave.
const float kLargeShapeScale = 1.75;
const vec3 kLargeShapeOffset = vec3(0.17, 0.31, 0.43);
const float kStepBudgetShare = 0.85;
const float kMinStepShare = 0.2;
const float kMinStepGrowth = 1e-4;
const float kMaxStepGrowth = 0.5;
const int kGrowthRounds = 4;
// Weather lookup warp and the cell-size probe (L4a).
const float kWeatherWarpTileM = 50000.0;
const float kWeatherWarpM = 1200.0;
const float kMinCloudTop = 0.14;
const float kBaseLump = 0.2;
// Far model (L4b): beyond this distance the layer is thinner and its lobes are stretched along the wind into rolls.
const float kFarStreakStartM = 15000.0;
const float kFarStreakEndM = 50000.0;
const float kFarStreakAlong = 5.0;
const float kFarStreakAcross = 2.5;
const float kFarTopScale = 0.4;
const float kFarFill = 0.3;
const float kCoverageGain = 1.5;
const float kSmallShapeScale = 2.7;
const vec3 kSmallShapeOffset = vec3(0.53, 0.07, 0.29);
const float kSmallModLow = 0.45;
const float kSmallModGain = 0.9;
// The finest shape octaves fade out between these distances.
const float kShapeLodStartM = 12000.0;
const float kShapeLodEndM = 40000.0;
// The small-cell octave (about 14 m texels) fades out earlier.
const float kSmallLodEndM = 60000.0;
// Dome: broad-mass level needed at the base, extra needed at the top, and the softness of the cut.
const float kWeatherLodStartM = 15000.0;
const float kWeatherLodEndM = 45000.0;
const float kWeatherLodMax = 0.8;
const float kZoomStartM = 20000.0;
const float kZoomEndM = 50000.0;
const float kFarZoom = 2.8;
const vec3 kFarZoomOffset = vec3(0.21, 0.0, 0.58);
const float kDomeBase = 0.05;
const float kDomeSpan = 0.75;
const float kDomeSoft = 0.12;
// Skin relief (TEMP L6): the visible surface is shaded with a normal from the density gradient.
const float kSkinRadiusM = 110.0;
const float kSkinRadiusPerM = 0.01;
const float kReliefLow = 0.4;
const float kReliefHigh = 1.7;
const float kReliefStrength = 0.6;
const float kSkinTransmittance = 1.1;

// TEMP L4: bit set = that L4 change off (1 warp, 2 size, 4 specks, 8 base lumps); set with ambientIntensity = 40 + bits.
int gXoff = 0;
#define kXoff gXoff

float Saturate(float v)
{
    return clamp(v, 0.0, 1.0);
}

float Remap(float v, float lo0, float hi0, float lo1, float hi1)
{
    float width = hi0 - lo0;
    width = abs(width) < kMinWidth ? (width < 0.0 ? -kMinWidth : kMinWidth) : width;
    return lo1 + (v - lo0) / width * (hi1 - lo1);
}

// Height above sea level of a point `horizontalSquared` from the planet axis at world height `y`.
float Altitude(float horizontalSquared, float y)
{
    float radius = params.eyeAndPlanetRadius.w;
    float s = horizontalSquared + y * (2.0 * radius + y);
    return s / (sqrt(max(s + radius * radius, 0.0)) + radius);
}

// Roots of the ray against the sphere at altitude `height`; returns false on a miss.
bool IntersectShell(float cameraY, float dirY, float height, out float tNear, out float tFar)
{
    float radius = params.eyeAndPlanetRadius.w;
    float ro = radius + cameraY;
    float s = sqrt(max(1.0 - dirY * dirY, 0.0));
    float inner = (height - cameraY) + ro * dirY * dirY / (1.0 + s);
    float outer = radius + height + ro * s;
    float disc = inner * outer;
    tNear = 0.0;
    tFar = 0.0;
    if (disc < 0.0) {
        return false;
    }
    float root = sqrt(disc);
    float b = ro * dirY;
    tNear = -b - root;
    tFar = -b + root;
    return true;
}

// Part of the ray inside the layer; false when it misses. Same logic as ComputeCloudShellSegment().
bool LayerSegment(float cameraY, float dirY, out float tStart, out float tEnd)
{
    float base = params.layer.x;
    float top = params.layer.y;
    float y = max(cameraY, 0.0);
    float topNear, topFar, baseNear, baseFar;
    bool topHit = IntersectShell(y, dirY, top, topNear, topFar);
    bool baseHit = IntersectShell(y, dirY, base, baseNear, baseFar);
    tStart = 0.0;
    tEnd = 0.0;
    if (y < base) {
        float groundNear, groundFar;
        bool groundHit = IntersectShell(y, dirY, 0.0, groundNear, groundFar);
        if (dirY < 0.0 && groundHit && groundNear > -kGroundSlack) {
            return false;
        }
        tStart = baseFar;
        tEnd = topFar;
    } else if (y < top) {
        tEnd = topFar;
        if (baseHit && baseNear > 0.0) {
            tEnd = min(tEnd, baseNear);
        }
    } else {
        if (!topHit || topFar <= 0.0) {
            return false;
        }
        tStart = max(topNear, 0.0);
        tEnd = (baseHit && baseNear > 0.0) ? baseNear : topFar;
    }
    tEnd = min(tEnd, params.layer.z);
    return tEnd > tStart;
}

// Cloud body at a world position: the coverage-eroded base shape, and the height-based density factor.
// Returns the shape; `densityFactor` is the part that scales it.
// Set by CloudShape(): the weather map holds no cloud at the last sampled position.
bool gWeatherClear = false;
// Set by CloudShape(): 0 for an isolated small cell, 1 for a big mass.
float gCloudSize = 1.0;

// Set by CloudShape(): 0 near, 1 far; the finest shape octaves fade out with distance (they would alias into dots).
float gShapeLod = 0.0;
// TEMP L5 debug values written by CloudShape().
vec3 gDbgShape = vec3(0.0);

// The shape value of one volume fetch: Perlin-Worley body against the Worley fbm, stretched to 0..1.
float ShapeValue(vec4 sn)
{
    float fbm = sn.g * (0.625 + 0.375 * gShapeLod) + (sn.b * 0.25 + sn.a * 0.125) * (1.0 - gShapeLod);
    // The Worley cells are what makes equal-sized popcorn balls; their weight scales them toward their mean.
    fbm = kShapeWorleyMean + (fbm - kShapeWorleyMean) * params.structure3.x;
    float shape = Remap(sn.r, fbm - 1.0, 1.0, 0.0, 1.0);
    return Saturate(Remap(shape, params.skip.z, params.skip.w, 0.0, 1.0));
}

float CloudShape(vec3 position, float heightFraction, out float densityFactor)
{
    vec2 wind = params.weather.yz;
    int xdbg = int(params.sunColorAndAmbient.w + 0.5);
    gXoff = (xdbg >= 40 ? xdbg - 40 : 0) | max(int(params.lightMisc.z / 1000.0 + 0.5) - 45, 0); // TEMP: A/B mask
    int xoff = gXoff;
    // Wind shear: the noise is read at a place that moves with the height, so the top of a cloud leans downwind.
    vec2 shear = params.structure.zw * heightFraction;
    vec2 fromEye = position.xz - params.eyeAndPlanetRadius.xz;
    float fromEyeLength = length(fromEye);
    gShapeLod = (xoff & 256) != 0 ? 0.0 : smoothstep(kShapeLodStartM, kShapeLodEndM, fromEyeLength);
    float farRamp = smoothstep(params.skyShade2.z, 2.0 * params.skyShade2.z, fromEyeLength);
    float coverage = min(params.weather.w + params.farField.x * farRamp, 1.0);
    float farStreak = (xoff & 16) != 0 ? 0.0 : smoothstep(kFarStreakStartM, kFarStreakEndM, length(fromEye));
    vec2 weatherPosition = position.xz + wind + 0.5 * params.structure.zw;
    // Domain warp: no straight or long smooth contour of the weather field.
    weatherPosition += (textureLod(curlMap, weatherPosition / kWeatherWarpTileM, 0.0).rg * 2.0 - 1.0) * ((xoff & 1) != 0 ? 0.0 : kWeatherWarpM);
    vec4 wm = textureLod(weatherMap, weatherPosition / params.weather.x, 0.0);
    // Mean coverage around the point: tells an isolated small cell (low) from a big mass (high).
    float massAverage = 1.5 * wm.g;  // the smooth fill channel is a blurred coverage: no extra fetches
    gCloudSize = (xoff & 2) != 0 ? 1.0 : smoothstep(0.15, 0.75, massAverage);
    // Far away the weather repeats every tile and shows the same big blobs. Blend in a second sample of the map at
    // another scale: the pattern no longer repeats and the far field gets more even, smaller clouds.
    // The fine texture of the weather map is smaller than a pixel far away and shows as dots: from medium distance on
    // the coarser second copy of the map takes over (world-fixed, so nothing swims).
    float weatherLod = (xoff & 2048) != 0 ? 0.0 : kWeatherLodMax * smoothstep(kWeatherLodStartM, kWeatherLodEndM, fromEyeLength);
    float farBlend = max(params.skyShade2.w * farRamp, weatherLod);
    if (farBlend > 0.0) {
        vec2 farUv = weatherPosition / (params.weather.x * kFarWeatherTileScale) + kFarWeatherOffset;
        wm = mix(wm, textureLod(weatherMap, farUv, 0.0), farBlend);
    }
    float weatherCoverage = max(wm.r, Saturate(coverage - 0.5) * wm.g * 1.1);  // the high-coverage fill tops out at 0.55: no solid sheet
    // Crisp specks of the map that stand alone are dropped; they would be hard flat flakes.
    weatherCoverage *= (xoff & 4) != 0 ? 1.0 : smoothstep(0.03, 0.10, massAverage);
    weatherCoverage = Saturate(weatherCoverage * ((xoff & 64) != 0 ? 1.0 : mix(1.0, kCoverageGain, smoothstep(0.08, 0.3, weatherCoverage))));
    // The far deck is a band of low rolls: it fills in toward the horizon.
    weatherCoverage = Saturate(weatherCoverage + kFarFill * farStreak * smoothstep(0.0, 0.06, weatherCoverage));
    // A shape value can not reach the coverage threshold here, so skip the 3D fetch.
    densityFactor = 0.0;
    gWeatherClear = coverage * weatherCoverage <= kMinCoverageProduct;
    if (gWeatherClear) {
        return 0.0;
    }

    float altitude = params.layer.x + heightFraction * (params.layer.y - params.layer.x);
    vec3 shapeUv = vec3(position.x + wind.x + shear.x, altitude / params.structure2.y, position.z + wind.y + shear.y) / params.noise.x;
    vec4 shapeSample = textureLod(shapeVolume, shapeUv, 0.0);
    // Far away a texel of the volume is smaller than a pixel and the fine lobes alias into dots: read a zoomed copy
    // of the same field there (world-fixed, so nothing swims) and cross-fade over the distance.
    float zoomMix = (xoff & 512) != 0 ? 0.0 : smoothstep(kZoomStartM, kZoomEndM, fromEyeLength);
    if (zoomMix > 0.0) {
        vec4 zoomSample = textureLod(shapeVolume, shapeUv / kFarZoom + kFarZoomOffset, 0.0);
        shapeSample = mix(shapeSample, zoomSample, zoomMix);
    }
    float shape = ShapeValue(shapeSample);
    float shapeMid = shape;
    float shapeLarge = shape;
    if (params.structure.x > 0.0 || params.structure2.w > 0.0) {
        // Two scales of the same volume: a big lobe octave carries the body and the mid octave adds the lobes on it.
        // Where the weather map says a cloud is big and tall (B high) the big octave dominates, small low clouds keep
        // the mid lobes; far away the big octave takes over so a distant deck does not turn into thin stacked sheets.
        shapeLarge = ShapeValue(textureLod(shapeVolume, shapeUv / kLargeShapeScale + kLargeShapeOffset, 0.0));
        float largeShare = Saturate(params.structure.x + params.structure.y * (wm.b - 0.5) * 2.0 + params.structure2.w * farRamp);
        shape = mix(shape, shapeLarge, largeShare);
    }
    // Small cells get a second, finer lobe octave: bumpy cauliflower surfaces instead of one smooth lobe.
    float smallness = (xoff & 32) != 0 ? 0.0 : (1.0 - gCloudSize) * (1.0 - smoothstep(0.25 * kSmallLodEndM, kSmallLodEndM, fromEyeLength));
    if (smallness > 0.02) {
        float fine = ShapeValue(textureLod(shapeVolume, shapeUv * kSmallShapeScale + kSmallShapeOffset, 0.0));
        shape *= mix(1.0, kSmallModLow + kSmallModGain * fine, smallness);
    }
    // Far model: the big octave read through a coordinate stretched along the wind gives rolls, not lobes.
    if (farStreak > 0.0) {
        // Fixed axes: with a stretch of 5 and 2.5 the wind wrap (350000 m) is a whole number of noise tiles, so it never pops.
        const vec2 windAxis = vec2(1.0, 0.0);
        const vec2 crossAxis = vec2(0.0, 1.0);
        vec2 world2 = shapeUv.xz * params.noise.x;
        vec2 stretched = windAxis * (dot(world2, windAxis) / kFarStreakAlong) + crossAxis * (dot(world2, crossAxis) / kFarStreakAcross);
        vec3 farUv = vec3(stretched.x, shapeUv.y * params.noise.x, stretched.y) / params.noise.x;
        shape = mix(shape, ShapeValue(textureLod(shapeVolume, farUv / kLargeShapeScale + kLargeShapeOffset, 0.0)), farStreak);
    }

    float peak = mix(params.density.z, 1.0, wm.b);
    float stop = Saturate(peak + params.heightShape.y);
    // Small cells are low flat cumulus, big masses are tall: no thin towers.
    // The noise lifts and lowers the top, so it is lumpy and not a flat plane.
    stop = (xoff & 2) != 0 ? stop : max(stop * mix(kMinCloudTop, 1.0, gCloudSize) + (shapeMid - 0.5) * 0.5 * (1.0 - ((xoff & 256) != 0 ? 0.6 : 0.25) * gCloudSize), 0.10);
    stop *= mix(1.0, kFarTopScale, farStreak);
    float topSoftStart = mix(0.15, ((xoff & 256) != 0 ? params.skip.y : min(params.skip.y, 0.55)), gCloudSize);
    // Hanging bases: where the big octave is high the cloud base is lower, so the underside is bumpy and not one plane.
    float baseShift = params.structure2.z * (0.5 - shapeLarge) * 0.4 + params.structure3.z * (0.5 - shapeMid) * 0.3;
    // Lumps of 0.5-1 km on the underside: the base is not one smooth surface.
    baseShift += (xoff & 8) != 0 ? 0.0 : clamp((shapeSample.r - 0.635) * kBaseLump, -0.03, 0.08);
    float roundBottom = Saturate(Remap(heightFraction, baseShift, baseShift + params.heightShape.x, 0.0, 1.0));
    float roundTop = Saturate(Remap(heightFraction, stop * topSoftStart, stop, 1.0, 0.0));
    float shapeGradient = roundBottom * roundTop;

    float rampBottom = heightFraction * Saturate(Remap(heightFraction, 0.0, params.heightShape.z, 0.0, 1.0));
    float rampTop = Saturate(Remap(heightFraction, params.heightShape.w, 1.0, 1.0, 0.0));
    densityFactor = params.density.x * rampBottom * rampTop * wm.a * 2.0;

    // Linear body; CloudDetail erodes it and applies the density curve afterwards, so the fine noise cuts into the
    // soft part of the cloud and not into a body already raised to a power.
    // The cut level never falls below the floor: a big mass keeps its lobes and holes instead of filling solid.
    // Dome: the footprint shrinks with height (small cells more), so a cell is not a prism with vertical walls.
    float dome = smoothstep(0.15, 1.0, heightFraction);
    float domeLoss = (xoff & 128) != 0 ? 0.0 : mix(0.5, 0.25, gCloudSize);
    float effCoverage = coverage * weatherCoverage * (1.0 - domeLoss * dome * dome);
    // The broad mass field must be higher the higher up we are: the footprint of a mass shrinks toward its top over km.
    float massNeed = kDomeBase + kDomeSpan * dome;
    effCoverage *= (xoff & 128) != 0 ? 1.0 : smoothstep(massNeed - kDomeSoft, massNeed + kDomeSoft, massAverage);
    float threshold = max(1.0 - effCoverage, params.structure3.y);
    gDbgShape = vec3(weatherCoverage, stop, threshold); // TEMP L5
    float rampEnd = params.structure3.w > 0.0 ? min(threshold + params.structure3.w, 1.0) : 1.0;
    return Saturate(Remap(shape * shapeGradient, threshold, rampEnd, 0.0, 1.0));
}

float CloudCurve(float body)
{
    return pow(body, params.ambientColor.w);
}

// Erodes the shape with the fine noise and applies the density factor. `shape` is the linear body of the cloud.
// `detailAmount` is 0..1 of the strength.
float CloudDetail(vec3 position, float heightFraction, float shape, float densityFactor, float detailAmount)
{
    vec2 wind = params.weather.yz;
    float altitude = params.layer.x + heightFraction * (params.layer.y - params.layer.x);
    vec2 shear = params.structure.zw * heightFraction;
    vec3 world = vec3(position.x + wind.x + shear.x, altitude / params.structure2.y, position.z + wind.y + shear.y);
    // Curl noise pushes the lookup around: the lobes get swirled and the edges ragged. Less at the top.
    vec3 curl = textureLod(curlMap, world.xz / params.detailShape.y, 0.0).rgb * 2.0 - 1.0;
    world += vec3(curl.x, curl.z * 0.5, curl.y) * (params.detailShape.x * (1.0 - 0.5 * heightFraction));
    vec4 dn = textureLod(detailVolume, world / params.noise.y, 0.0);
    float billow = dn.r * 0.6 + dn.g * 0.4;
    float wisp = dn.b * 0.6 + dn.a * 0.4;
    // Billows erode the cell borders (rounded lobes); wisps erode everything but thin sheets and strands.
    float billowErosion = mix(billow, 1.0 - billow, Saturate(heightFraction * 5.0));
    float wispErosion = 1.0 - wisp;
    float wispShare = params.detailShape.z * Saturate(1.2 - 1.6 * shape + 0.5 * Saturate((heightFraction - 0.7) * 3.0));
    float erosion = mix(billowErosion, wispErosion, wispShare);
    if (params.detailShape.w > 0.0) {
        vec4 fn = textureLod(detailVolume, world * kFineDetailScale / params.noise.y + 0.31, 0.0);
        erosion = mix(erosion, 1.0 - (fn.g * 0.5 + fn.a * 0.5), params.detailShape.w * 0.5);
    }
    // The fine erosion cuts the rim of a cloud; the core keeps only a share of it, so the body stays smooth.
    erosion *= params.noise.z * detailAmount * exp(-params.weather.w * 0.75) * mix(params.structure2.x, 1.0, 1.0 - shape);
    return CloudCurve(Saturate(Remap(shape, erosion, 1.0, 0.0, 1.0))) * densityFactor;
}

// Full density at a world position, for light marching.
float CloudDensityAt(vec3 position, float detailAmount)
{
    float horizontalSquared = dot(position.xz - params.eyeAndPlanetRadius.xz, position.xz - params.eyeAndPlanetRadius.xz);
    float altitude = Altitude(horizontalSquared, position.y);
    float h = Saturate((altitude - params.layer.x) / max(params.layer.y - params.layer.x, kMinWidth));
    float factor;
    float shape = CloudShape(position, h, factor);
    return CloudDetail(position, h, shape, factor, detailAmount);
}

#include "VolumetricCloudLighting.glsl"
#include "VolumetricCloudAtmosphere.glsl"

// Outward normal of the cloud skin at a position: minus the gradient of the smooth density (4 taps).
vec3 SkinNormal(vec3 position, float t)
{
    float r = max(kSkinRadiusM, kSkinRadiusPerM * t);
    // A loop with a run-time count keeps one copy of the density code (an unrolled copy per tap makes the shader slow).
    vec3 g = vec3(0.0);
    for (uint i = 0u; i < uint(params.lightMarch.x); ++i) {
        vec3 k = vec3((i == 0u || i == 3u) ? 1.0 : -1.0, i >= 2u ? 1.0 : -1.0, (i & 1u) == 1u ? 1.0 : -1.0);
        vec3 p = position + k * r;
        if ((gXoff & 16384) != 0) {
            g += k * CloudLightDensity(p);
        } else {
            // The raw noise keeps its relief where the density is saturated.
            float alt = Altitude(dot(p.xz - params.eyeAndPlanetRadius.xz, p.xz - params.eyeAndPlanetRadius.xz), p.y);
            vec3 uv = vec3(p.x + params.weather.y, alt / params.structure2.y, p.z + params.weather.z) / params.noise.x;
            g += k * textureLod(shapeVolume, uv, 0.0).r;
        }
    }
    float len = length(g);
    return len > 1e-5 ? -g / len : vec3(0.0, -1.0, 0.0);
}

// Marches [tStart, tEnd]. Returns light in rgb and the transmittance in a; `cloudDistance` is the mean
// distance of the cloud, weighted by how much each step adds to the picture (0 when there is none).
vec4 MarchClouds(vec3 eye, vec3 rd, float tStart, float tEnd, float jitter, float rayGrowth, out float cloudDistance)
{
    float distanceSum = 0.0;
    float weightSum = 0.0;
    float maxDistance = params.layer.z;
    float fadeBegin = params.layer.w * maxDistance;
    // The step is (t + stepOffset) * rayGrowth = stepBaseM + rayGrowth * t.
    float stepOffset = params.march.x / rayGrowth;
    float coarseMultiplier = params.march.z;
    float horizontalScale = dot(rd.xz, rd.xz);
    uint maxSteps = params.counts.x;
    uint emptyToCoarse = params.counts.z;

    vec3 sunDirection = params.sunDirectionAndIntensity.xyz;
    vec3 sunRadiance = params.sunColorAndAmbient.rgb * params.sunDirectionAndIntensity.w;
    bool integrated = AtmosphereOn();
    vec3 ambientRadiance = integrated ? gSkyAmbient : params.ambientColor.rgb * params.sunColorAndAmbient.w;

    float stepLength = (tStart + stepOffset) * rayGrowth;
    float t = tStart + jitter * params.density.w * stepLength;
    vec3 light = vec3(0.0);
    float transmittance = 1.0;
    bool coarse = true;
    uint emptyRun = 0u;
    // The sun march and the sky occlusion run every few lit samples; the samples in between blend the two
    // nearest results, so the light has no steps along the ray.
    bool sunLit = dot(sunRadiance, sunRadiance) > 0.0;
    bool needSky = params.skyShade.x > 0.0;
    uint lightStride = max(params.counts.w, 1u);
    uint lightAge = 0u;
    bool lightPrimed = false;
    float sunDepthA = 0.0;
    float sunDepthB = 0.0;
    float skyVisibilityA = 1.0;
    float skyVisibilityB = 1.0;
    float sunOpticalDepth = 0.0;
    float skyVisibility = 1.0;
    bool skinKnown = false;
    vec3 skinNormal = vec3(0.0, -1.0, 0.0);

    for (uint i = 0u; i < maxSteps && t < tEnd && transmittance > params.march.w; ++i) {
        stepLength = (t + stepOffset) * rayGrowth;
        float coarseLength = stepLength * coarseMultiplier;
        vec3 position = vec3(eye.x + rd.x * t, eye.y + rd.y * t, eye.z + rd.z * t);
        float altitude = Altitude(horizontalScale * t * t, eye.y + rd.y * t);
        float h = Saturate((altitude - params.layer.x) / (params.layer.y - params.layer.x));
        float factor;
        float shape = CloudShape(position, h, factor);
        vec3 dbgS = gDbgShape; // TEMP L5

        if (coarse) {
            if (shape * factor > 0.0) {
                coarse = false;
                emptyRun = 0u;
                t = max(t - coarseLength, tStart);
            } else {
                t += gWeatherClear ? coarseLength * params.skip.x : coarseLength;
            }
            continue;
        }

        float detailAmount = 1.0 - smoothstep(0.5 * params.noise.w, params.noise.w, t);
        float d = CloudDetail(position, h, shape, factor, detailAmount);
        if (d <= 0.0) {
            emptyRun++;
            if (emptyRun >= emptyToCoarse) {
                coarse = true;
            }
            t += stepLength;
            continue;
        }
        emptyRun = 0u;

        float fade = 1.0 - smoothstep(fadeBegin, maxDistance, t);
        float extinction = d * params.density.y * fade;
        // Standalone: a far cloud counts as less opaque, so the sky behind it shows through. With the
        // atmosphere the air between the eye and the cloud does that, see AirInscatter().
        float haze = integrated ? 1.0 : exp(-t / params.lightMisc.z);
        // A dense sample may not be more than farField.z optical depths long: the step is shortened so the ray
        // integrates through a cloud edge instead of stopping at a jittered point inside one long step.
        float marchStep = stepLength;
        if (extinction * stepLength > params.farField.z) {
            marchStep = max(params.farField.z / extinction, stepLength * kMinStepShare);
        }
        float opacity = (1.0 - exp(-extinction * marchStep)) * haze;

        vec3 sampleSun = sunRadiance;
        if (integrated) {
            sampleSun *= SunTransmittanceAt(AtmospherePosition(rd * t), sunDirection);
        }
        bool needSun = sunLit && dot(sampleSun, sampleSun) > 0.0;
        if (needSun || needSky) {
            vec3 nextPosition = position + rd * (stepLength * float(lightStride));
            if (!lightPrimed) {
                lightPrimed = true;
                lightAge = 0u;
                sunDepthA = needSun ? SunOpticalDepth(position, sunDirection) : 0.0;
                skyVisibilityA = needSky ? SkyVisibility(position) : 1.0;
                sunDepthB = needSun ? SunOpticalDepth(nextPosition, sunDirection) : 0.0;
                skyVisibilityB = needSky ? SkyVisibility(nextPosition) : 1.0;
            } else if (lightAge >= lightStride) {
                lightAge = 0u;
                sunDepthA = sunDepthB;
                skyVisibilityA = skyVisibilityB;
                sunDepthB = needSun ? SunOpticalDepth(nextPosition, sunDirection) : 0.0;
                skyVisibilityB = needSky ? SkyVisibility(nextPosition) : 1.0;
            }
            float blend = float(lightAge) / float(lightStride);
            sunOpticalDepth = mix(sunDepthA, sunDepthB, blend);
            skyVisibility = mix(skyVisibilityA, skyVisibilityB, blend);
            lightAge++;
        }

        CloudLightInput li;
        li.position = position;
        li.density = d;
        li.heightFraction = h;
        li.extinction = extinction;
        li.stepLength = stepLength;
        li.distanceAlongRay = t;
        li.viewDirection = rd;
        li.sunDirection = sunDirection;
        li.sunRadiance = sampleSun;
        li.ambientRadiance = ambientRadiance;
        li.sunOpticalDepth = sunOpticalDepth;
        li.skyVisibility = skyVisibility;
        li.groundRadiance = gGroundRadiance;
        li.lodDensity = Saturate(CloudCurve(shape) * factor);
        vec3 src = CloudSourceRadiance(li);
        if ((gXoff & 8192) == 0 && d > 0.02) {
            // The skin is where the ray has lost part of its light; the thin fringe in front of it has no relief.
            if (!skinKnown && transmittance < kSkinTransmittance) {
                skinKnown = true;
                skinNormal = SkinNormal(position, t);
            }
        }
        if ((gXoff & 8192) == 0 && skinKnown) {
            vec3 key = normalize(sunDirection + vec3(0.0, 0.6, 0.0));
            float relief = mix(kReliefLow, kReliefHigh, 0.5 + 0.5 * dot(skinNormal, key));
            src *= mix(1.0, relief, kReliefStrength);
        }
        int dbg = int(params.sunColorAndAmbient.w + 0.5); // TEMP L1 debug
        if (dbg > 0) {
            float cosT = dot(rd, sunDirection);
            float skyShareDbg = mix(params.lightMisc.y, 1.0, pow(h, 0.7)) * skyVisibility;
            float tauDbg = sunOpticalDepth;
            if      (dbg == 1)  src = vec3(exp(-tauDbg));
            else if (dbg == 2)  src = ambientRadiance * skyShareDbg;
            else if (dbg == 3)  src = gGroundRadiance * (1.0 - h) * (1.0 - h);
            else if (dbg == 4)  src = vec3(h);
            else if (dbg == 5)  src = vec3(shape);
            else if (dbg == 6)  src = vec3(Saturate(d / 3.0));
            else if (dbg == 7)  src = vec3(skyVisibility);
            else if (dbg == 8)  src = vec3(Saturate(log2(1.0 + tauDbg) / 8.0));
            else if (dbg == 9)  src = li.sunRadiance * SunScatter(cosT, tauDbg);
            else if (dbg == 10) src = li.sunRadiance * vec3(params.lightTune.y * (tauDbg / (tauDbg + 2.0)) / (1.0 + 0.15 * tauDbg) / (4.0 * kPi));
            else if (dbg == 11) src = (h < 0.03 || h > 0.97) ? vec3(1.0, 0.0, 0.0) : vec3(0.0);
            else if (dbg == 12) src = vec3(Saturate(extinction * 20.0));
            else if (dbg == 13) src = vec3(Saturate(li.lodDensity));
            else if (dbg == 14) src = vec3(tauDbg / 100.0);
            else if (dbg == 15) src = vec3(dbgS.x);
            else if (dbg == 16) src = vec3(dbgS.y);
            else if (dbg == 17) src = vec3(dbgS.z);
            src = max(src, vec3(0.0));
        }
        light += transmittance * src * opacity;
        float weight = transmittance * opacity;
        distanceSum += weight * t;
        weightSum += weight;
        transmittance *= 1.0 - opacity;
        t += marchStep;
    }
    cloudDistance = weightSum > 0.0 ? distanceSum / weightSum : 0.0;
    // Below the cutoff the cloud counts as opaque; rescale so there is no step at the threshold.
    float cutoff = params.march.w;
    if (transmittance <= cutoff) {
        transmittance = 0.0;
    } else {
        transmittance = Saturate((transmittance - cutoff) / (1.0 - cutoff));
    }
    return vec4(light, transmittance);
}

// Cloud shadow map mode: each texel holds the sun light that reaches the layer plane at its place. The ray from the
// place toward the sun is marched through the whole layer with the smooth density (no fine erosion).
const int kShadowMaxSteps = 24;
const float kShadowMinSunY = 0.03;

float ShadowNoise(vec2 p)
{
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

vec4 ShadowHistoryAt(vec2 uv, ivec2 size)
{
    vec2 p = uv * vec2(size) - 0.5;
    ivec2 i0 = ivec2(floor(p));
    vec2 f = p - vec2(i0);
    ivec2 hi = size - 1;
    vec4 a = texelFetch(shadowHistory, clamp(i0, ivec2(0), hi), 0);
    vec4 b = texelFetch(shadowHistory, clamp(i0 + ivec2(1, 0), ivec2(0), hi), 0);
    vec4 c = texelFetch(shadowHistory, clamp(i0 + ivec2(0, 1), ivec2(0), hi), 0);
    vec4 d = texelFetch(shadowHistory, clamp(i0 + ivec2(1, 1), ivec2(0), hi), 0);
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

void WriteCloudShadow()
{
    ivec2 size = min(imageSize(lowColorOut), imageSize(lowAuxOut));
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }
    float texelM = params.shadowGrid.x;
    vec2 local = (vec2(texel) + 0.5 - 0.5 * vec2(size)) * texelM;
    vec2 xz = params.shadowGrid.yz + local;
    float blend = params.shadowShift.z;
    bool haveHistory = blend < 0.999;
    vec2 historyUv = (local + params.shadowShift.xy) / (texelM * vec2(size)) + 0.5;
    if (haveHistory && !(all(greaterThanEqual(historyUv, vec2(0.0))) && all(lessThanEqual(historyUv, vec2(1.0))))) {
        haveHistory = false;
    }
    ivec2 historySize = textureSize(shadowHistory, 0);
    uint interval = max(uint(params.shadowTune.y + 0.5), 1u);
    // Whole 8 x 8 tiles take their turn together, so a skipped tile costs nothing.
    uint phase = (gl_WorkGroupID.x + 3u * gl_WorkGroupID.y) % interval;
    if (haveHistory && (params.counts.y % interval) != phase) {
        vec4 carried = ShadowHistoryAt(historyUv, historySize);
        imageStore(lowColorOut, texel, carried);
        imageStore(lowAuxOut, texel, vec4(carried.g, 0.0, 0.0, 0.0));
        return;
    }
    // The history of a texel that is redone is blurred a little (a tent of about one texel): the noise of the
    // few samples of each update averages out and the shadow edge stays soft.
    vec4 previous = vec4(1.0, 0.0, 0.0, 1.0);
    if (haveHistory) {
        vec2 o = vec2(0.5 * clamp(params.shadowTune.x / 1.5, 0.0, 2.0)) / vec2(historySize);
        previous = 0.25 * (ShadowHistoryAt(historyUv + vec2(o.x, o.y), historySize) + ShadowHistoryAt(historyUv + vec2(-o.x, o.y), historySize)
            + ShadowHistoryAt(historyUv + vec2(o.x, -o.y), historySize) + ShadowHistoryAt(historyUv + vec2(-o.x, -o.y), historySize));
    }

    vec3 sun = params.sunDirectionAndIntensity.xyz;
    float sunY = max(sun.y, kShadowMinSunY);
    float base = params.layer.x;
    float top = params.layer.y;
    float mid = 0.5 * (base + top);
    float sBottom = (base - mid) / sunY;
    float sTop = (top - mid) / sunY;
    int steps = clamp(int(params.shadowTune.z + 0.5), 1, kShadowMaxSteps);
    float segment = (sTop - sBottom) / float(steps);
    float frame = float(params.counts.y & 1023u);
    vec2 noiseSeed = vec2(texel) + frame * vec2(5.588238, 3.1416);
    float along = ShadowNoise(noiseSeed);
    float angle = 6.2831853 * ShadowNoise(noiseSeed + 17.0);
    vec2 blur = vec2(cos(angle), sin(angle)) * sqrt(ShadowNoise(noiseSeed + 41.0)) * params.shadowTune.x * texelM;
    float opticalDepth = 0.0;
    for (int i = 0; i < steps; ++i) {
        float s = sBottom + (float(i) + along) * segment;
        vec3 position = vec3(xz.x + blur.x + sun.x * s, mid + sun.y * s, xz.y + blur.y + sun.z * s);
        opticalDepth += CloudLightDensity(position) * segment;
    }
    opticalDepth *= params.density.y * params.shadowShift.w;
    vec4 current = vec4(exp(-opticalDepth), opticalDepth, 0.0, 1.0);
    vec4 result = haveHistory ? mix(previous, current, blend) : current;
    imageStore(lowColorOut, texel, result);
    imageStore(lowAuxOut, texel, vec4(result.g, 0.0, 0.0, 0.0));
}

void main()
{
    if (params.shadowGrid.w > 0.5) {
        WriteCloudShadow();
        return;
    }
    // A persistent target keeps its old size for one frame after a resize: trust the bound images.
    ivec2 lowSize = min(imageSize(lowColorOut), imageSize(lowAuxOut));
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= lowSize.x || texel.y >= lowSize.y) {
        return;
    }
    // The march samples one real pixel of its block; the offset walks through the block over the frames.
    ivec2 fullSize = ivec2(params.fullSize.xy);
    ivec2 pixel = min(texel * int(params.lowRes.x) + ivec2(params.lowRes.yz), fullSize - 1);
    vec2 uv = (vec2(pixel) + 0.5) / vec2(fullSize);
    float rawDepth = textureLod(sourceDepth, uv, 0.0).r;

    vec2 ndc = uv * 2.0 - 1.0;
    // The ray goes through a point inside the pixel that changes with every own sample of the pixel (R2 sequence,
    // shifted per pixel by blue noise): the temporal average then covers the pixel area, which antialiases the
    // cloud edges. The depth test below keeps using the pixel centre.
    uint cycle = params.lowRes.x * params.lowRes.x;
    uint sampleIndex = (params.counts.y / cycle) & 255u;
    vec2 pixelShift = vec2(0.0);
    if (params.lowRes.w > 0u) {
        vec2 cp = vec2(textureLod(blueNoise, (vec2(pixel) + 0.5) / kBlueNoiseSize, 0.0).r,
            textureLod(blueNoise, (vec2(pixel) + vec2(37.5, 71.5)) / kBlueNoiseSize, 0.0).r);
        pixelShift = (fract(cp + float(sampleIndex + 1u) * vec2(0.7548776662, 0.5698402910)) - 0.5) * (float(params.lowRes.w) * 0.01);
    }
    vec2 rayNdc = ndc + pixelShift * 2.0 / vec2(fullSize);
    vec4 nearPoint = params.invViewProjection * vec4(rayNdc, 0.0, 1.0);
    vec4 farPoint = params.invViewProjection * vec4(rayNdc, 1.0, 1.0);
    vec3 rd = normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
    vec3 eye = params.eyeAndPlanetRadius.xyz;

    float tStart;
    float tEnd;
    if (!LayerSegment(eye.y, rd.y, tStart, tEnd)) {
        imageStore(lowColorOut, texel, vec4(0.0, 0.0, 0.0, 1.0));
        imageStore(lowAuxOut, texel, vec4(0.0, kNoSurfaceKm, 0.0, 0.0));
        return;
    }
    // Clouds behind the surface at this pixel are never added.
    float completeKm = kNoSurfaceKm;
    if (rawDepth < kClearDepthThreshold) {
        vec4 world = params.invViewProjection * vec4(ndc, rawDepth, 1.0);
        float surface = length(world.xyz / world.w);
        if (surface < tEnd) {
            tEnd = surface;
            completeKm = surface * 0.001;
        }
        if (tEnd <= tStart) {
            imageStore(lowColorOut, texel, vec4(0.0, 0.0, 0.0, 1.0));
            imageStore(lowAuxOut, texel, vec4(0.0, completeKm, 0.0, 0.0));
            return;
        }
    }

    float bn = textureLod(blueNoise, (vec2(pixel) + 0.5) / kBlueNoiseSize, 0.0).r;
    // A pixel is marched once per block cycle, so its own samples step by the golden ratio. Counting frames
    // would move the jitter by only 0.11 between two samples of the same pixel.
    uint cycleLength = params.lowRes.x * params.lowRes.x;
    uint ownSample = (params.counts.y / cycleLength) & 255u;
    float jitter = fract(bn + kGoldenRatio * float(ownSample));
    int xmask = int(params.sunColorAndAmbient.w + 0.5);
    int xall = (xmask >= 40 ? xmask - 40 : 0) | max(int(params.lightMisc.z / 1000.0 + 0.5) - 45, 0); // TEMP A/B mask
    bool lightJitterOff = (xall & 1024) != 0;
    gLightJitter = lightJitterOff ? 0.5 : fract(jitter * 1.7 + bn * 3.1);
    gDiffuseMode = (xall & 4096) != 0 ? 1 : 0;
    if (AtmosphereOn()) {
        gSkyAmbient = SkyAmbientRadiance();
        gGroundRadiance = GroundBounceRadiance(params.sunColorAndAmbient.rgb, params.sunDirectionAndIntensity.xyz);
    }
    // Every ray gets a step growth that brings it to the end of its segment within a share of the step budget. A ray
    // along the horizon crosses 100+ km of shell; with a fixed growth it would run out of steps long before.
    // Steps follow t_next + c = (t + c) * (1 + g) with c = stepBaseM / g, which is step = stepBaseM + g * t. A larger g
    // makes c smaller, so the ratio is solved by a few fixed-point rounds; the first step stays stepBaseM.
    float stepBudget = max(kStepBudgetShare * float(params.counts.x), 4.0);
    float rayGrowth = max(params.march.y, kMinStepGrowth);
    for (int round = 0; round < kGrowthRounds; ++round) {
        float stepOffset = params.march.x / rayGrowth;
        rayGrowth = max(rayGrowth, pow((tEnd + stepOffset) / (tStart + stepOffset), 1.0 / stepBudget) - 1.0);
    }
    rayGrowth = min(rayGrowth, kMaxStepGrowth);
    float cloudDistance;
    vec4 cloud = MarchClouds(eye, rd, tStart, tEnd, jitter, rayGrowth, cloudDistance);
    if (AtmosphereOn() && cloud.a < 1.0 && cloudDistance > 0.0 && (int(params.sunColorAndAmbient.w + 0.5) == 0 || int(params.sunColorAndAmbient.w + 0.5) >= 20)) {
        // Seen through the air: the cloud light is dimmed and the air in front of the cloud adds its own light.
        vec3 airTransmittance;
        vec3 sunIlluminance = params.sunColorAndAmbient.rgb;
        // Beyond the far field start the air in front of a cloud counts only a share of its length: the layer is
        // seen through the thin upper air, and without this a cloud deck near the horizon dissolves into the haze.
        float airKm = cloudDistance * 0.001;
        float farKm = params.skyShade2.z * 0.001;
        airKm = airKm <= farKm ? airKm : farKm + (airKm - farKm) * params.farField.y;
        vec3 air = AirInscatter(rd, airKm, params.sunDirectionAndIntensity.xyz, sunIlluminance, airTransmittance);
        float airGain = params.atmosphereMode.y;
        airTransmittance = mix(airTransmittance, vec3(dot(airTransmittance, vec3(0.2126, 0.7152, 0.0722))), 0.9); // TEMP L2 C3: neutral air transmittance
        cloud.rgb = cloud.rgb * airTransmittance + (1.0 - cloud.a) * air * airGain;
    }
    if (any(isnan(cloud)) || any(isinf(cloud))) {
        cloud = vec4(0.0, 0.0, 0.0, 1.0);
        cloudDistance = 0.0;
    }
    imageStore(lowColorOut, texel, vec4(min(cloud.rgb, vec3(kMaxOutputLuminance)), cloud.a));
    imageStore(lowAuxOut, texel, vec4(cloudDistance * 0.001, completeKm, 0.0, 0.0));
}
