#version 450

// Upsamples the low resolution cloud march, blends it with the reprojected history of the last frame and
// composites the result over the scene. A tap or a history texel is only used where it saw the same surface.
layout(local_size_x = 8, local_size_y = 8) in;

#include "SceneDepthConstants.glsl"

// Member names and order match VolumetricCloudResolveParamsGpu.
layout(std430, binding = 0) readonly buffer VolumetricCloudResolveParams {
    mat4 invViewProjection;     // Clip space to world position minus eye.
    mat4 prevViewProjection;    // Last frame's world position minus THIS frame's eye to clip space.
    vec4 eye;           // xyz eye.
    vec4 windDelta;     // xz shift to last frame's cloud position.
    vec4 blend;         // x history blend, y fresh blend, z clamp expand, w fallback cloud distance (m).
    vec4 motion;        // x extra blend at one pixel of motion, y sharp (Catmull-Rom) history 0..1, z adaptive sample count 0/1.
    uvec4 counts;       // x divisor, yz sample offset, w history valid.
    uvec4 sizes;        // xy view size, zw march target size.
    vec4 sunRay;        // xy sun position in the view, z strength (0 = off), w length (share of the way to the sun).
    vec4 sunRayColor;   // rgb colour, w glow radius (view height units).
} params;

layout(binding = 1) uniform sampler2D sourceColor;
layout(binding = 2) uniform sampler2D sourceDepth;
layout(binding = 3) uniform sampler2D lowColor;      // Cloud light in rgb, transmittance in a.
layout(binding = 4) uniform sampler2D lowAux;        // x cloud distance, y complete up to (km).
layout(binding = 5) uniform sampler2D historyColor;
layout(binding = 6) uniform sampler2D historyAux;
layout(binding = 7, rgba16f) uniform writeonly image2D historyColorOut;
layout(binding = 8, rgba16f) uniform writeonly image2D historyAuxOut;
layout(binding = 9, rgba16f) uniform writeonly image2D destinationImage;

const float kNoSurfaceKm = 1000.0;
const float kMaxOutputLuminance = 65504.0;
const float kRelative = 0.03;
const float kSlackKm = 0.02;
const float kClearTransmittance = 0.999;
const float kSnapTexels = 0.004;

// Keep identical to CloudTapUsable() in VolumetricCloudMath.cpp.
bool TapUsable(vec4 color, vec4 aux, float pixelEndKm)
{
    if (aux.y < (1.0 - kRelative) * pixelEndKm - kSlackKm) {
        return false;
    }
    return color.a > kClearTransmittance || aux.x <= (1.0 + kRelative) * pixelEndKm + kSlackKm;
}

// Bilinear fetch of the history around `texelPosition` (texel centres at integers), using only texels that
// saw this pixel's surface. Returns false when none did.
// Catmull-Rom weights of the four texels around a fractional position.
vec4 CatmullRomWeights(float f)
{
    float f2 = f * f;
    float f3 = f2 * f;
    return vec4(-0.5 * f3 + f2 - 0.5 * f, 1.5 * f3 - 2.5 * f2 + 1.0, -1.5 * f3 + 2.0 * f2 + 0.5 * f, 0.5 * f3 - 0.5 * f2);
}

// With params.motion.y > 0 the bilinear result is replaced by a Catmull-Rom fetch (clamped to the range of the
// four inner texels) when all four inner texels are usable: bilinear resampling blurs the history a little more
// on every frame of motion. `count` is the number of samples the history pixel has accumulated.
bool FetchHistory(vec2 texelPosition, float pixelEndKm, out vec4 color, out float distanceKm, out float count)
{
    ivec2 size = min(textureSize(historyColor, 0), textureSize(historyAux, 0));
    ivec2 base = ivec2(floor(texelPosition));
    vec2 f = texelPosition - vec2(base);
    vec4 colorSum = vec4(0.0);
    float distanceSum = 0.0;
    float distanceWeight = 0.0;
    float weightSum = 0.0;
    float countSum = 0.0;
    vec4 innerMin = vec4(1e30);
    vec4 innerMax = vec4(-1e30);
    for (int k = 0; k < 4; ++k) {
        ivec2 c = base + ivec2(k & 1, k >> 1);
        if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, size))) {
            continue;
        }
        float w = ((k & 1) == 1 ? f.x : 1.0 - f.x) * ((k >> 1) == 1 ? f.y : 1.0 - f.y);
        if (w <= 0.0) {
            continue;
        }
        vec4 hc = texelFetch(historyColor, c, 0);
        vec4 ha = texelFetch(historyAux, c, 0);
        if (!TapUsable(hc, ha, pixelEndKm)) {
            continue;
        }
        innerMin = min(innerMin, hc);
        innerMax = max(innerMax, hc);
        countSum += ha.z * w;
        colorSum += hc * w;
        weightSum += w;
        float cloudWeight = w * (1.0 - hc.a);
        distanceSum += ha.x * cloudWeight;
        distanceWeight += cloudWeight;
    }
    color = vec4(0.0, 0.0, 0.0, 1.0);
    distanceKm = 0.0;
    count = 0.0;
    if (weightSum < 1e-3) {
        return false;
    }
    color = colorSum / weightSum;
    count = countSum / weightSum;
    if (params.motion.y > 0.0 && weightSum > 0.999) {
        vec4 wx = CatmullRomWeights(f.x);
        vec4 wy = CatmullRomWeights(f.y);
        vec4 cubic = vec4(0.0);
        for (int j = 0; j < 4; ++j) {
            for (int i = 0; i < 4; ++i) {
                ivec2 c = clamp(base + ivec2(i - 1, j - 1), ivec2(0), size - 1);
                cubic += texelFetch(historyColor, c, 0) * (wx[i] * wy[j]);
            }
        }
        cubic = clamp(cubic, innerMin, innerMax);
        color = mix(color, cubic, params.motion.y);
    }
    distanceKm = distanceWeight > 0.0 ? distanceSum / distanceWeight : 0.0;
    return true;
}

const float kRayOpenLow = 0.35;
const float kRayOpenHigh = 0.75;
const vec3 kRayCool = vec3(0.80, 0.86, 1.0);
const float kRaySurroundRadius = 0.12; // Where the pixel looks around for the darker surroundings of a ray.
const float kRayContrastGain = 2.0;
const float kRayDeadZone = 0.3;
const float kRayWidth = 0.010;     // Half width of a ray near the pixel (view height units).
const float kRayWidthGrowth = 0.035; // Extra half width at the sun end.

// Sun rays: the glow around the sun, looked at through the gaps of the clouds. The pixel averages the glow along the
// line toward the sun; the blocker is last frame's smooth cloud transmittance, so the rays do not flicker.
vec3 SunRays(vec2 uv, ivec2 pixel, float pixelEndKm, float cloudTransmittance)
{
    const int kTaps = 12;
    // Pixels inside a cloud show no rays: they skip the whole pass.
    float openHere = smoothstep(0.8, 0.97, cloudTransmittance);
    if (openHere <= 0.0) {
        return vec3(0.0);
    }
    vec2 aspect = vec2(float(params.sizes.x) / float(params.sizes.y), 1.0);
    // Rays show only as light against their darker surroundings: an even open sky gets none, and skips the line.
    float surroundOpen = 0.0;
    for (int k = 0; k < 4; ++k) {
        float angle = 1.5707963 * float(k) + 0.5;
        vec2 q = uv + vec2(cos(angle), sin(angle)) * kRaySurroundRadius / aspect;
        surroundOpen += textureLod(historyColor, clamp(q, vec2(0.0), vec2(1.0)), 0.0).a;
    }
    surroundOpen *= 0.25;
    if (surroundOpen > 1.0 - kRayDeadZone) {
        return vec3(0.0);
    }
    vec2 toSun = params.sunRay.xy - uv;
    // The jitter moves every frame (the march offset cycles) so TAA averages it; the pixel only decides the side.
    float frameShift = fract(0.61803399 * float(params.counts.y + 8u * params.counts.z));
    float pixelShift = fract(52.9829189 * fract(dot(vec2(pixel), vec2(0.06711056, 0.00583715))));
    float radius = max(params.sunRayColor.w, 1e-3);
    // The glow peaks at the sun, so the taps crowd toward it: t = 1 - (1 - u)^2, weighted by dt / du.
    vec2 aspectLine = toSun * aspect;
    vec2 sideDirection = normalize(vec2(-aspectLine.y, aspectLine.x) + vec2(1e-6)) / aspect;
    float sum = 0.0;
    float glowSum = 0.0;
    float weightSum = 0.0;
    for (int i = 0; i < kTaps; ++i) {
        // The glow weight sits on a fixed lattice, so it is smooth; only the openness is read at jittered places.
        float uFixed = (float(i) + 0.5) / float(kTaps);
        float weight = 2.0 * (1.0 - uFixed);
        float tFixed = (1.0 - (1.0 - uFixed) * (1.0 - uFixed)) * params.sunRay.w;
        vec2 fromSun = (uv + toSun * tFixed - params.sunRay.xy) * aspect / radius;
        float glow = 1.0 / (1.0 + dot(fromSun, fromSun));
        float u = (float(i) + 0.5 + 0.7 * (pixelShift - 0.5) + 0.7 * (frameShift - 0.5)) / float(kTaps);
        float t = (1.0 - (1.0 - u) * (1.0 - u)) * params.sunRay.w;
        float side = ((i & 1) == 0 ? -1.0 : 1.0) * (0.35 + 0.65 * fract(pixelShift * 7.31 + float(i) * 0.37));
        vec2 p = uv + toSun * t + sideDirection * (side * (kRayWidth + kRayWidthGrowth * t));
        float open = textureLod(historyColor, clamp(p, vec2(0.0), vec2(1.0)), 0.0).a;
        sum += glow * open * weight;
        glowSum += glow * weight;
        weightSum += weight;
    }
    float lineOpen = sum / max(glowSum, 1e-4);
    float contrast = clamp((smoothstep(kRayOpenLow, kRayOpenHigh, lineOpen) - surroundOpen - kRayDeadZone) * kRayContrastGain, 0.0, 1.0);
    float ray = glowSum / max(weightSum, 1e-4) * contrast;
    float onGround = smoothstep(0.3, 4.0, pixelEndKm);
    float luma = dot(params.sunRayColor.rgb, vec3(0.2126, 0.7152, 0.0722));
    vec3 tint = mix(params.sunRayColor.rgb, vec3(luma) * kRayCool, 0.55);
    return tint * (params.sunRay.z * ray * onGround * openHere);
}

const float kStarRadius = 0.16;   // Reach of the spikes (view height units).
const float kStarGain = 2.5;

// A small starburst on the sun where the sun shows through a gap: six soft spikes, stable in time.
vec3 SunStar(vec2 uv)
{
    vec2 aspect = vec2(float(params.sizes.x) / float(params.sizes.y), 1.0);
    vec2 fromSun = (uv - params.sunRay.xy) * aspect;
    float r = length(fromSun);
    if (r > kStarRadius) {
        return vec3(0.0);
    }
    vec2 sunUv = clamp(params.sunRay.xy, vec2(0.0), vec2(1.0));
    float seen = smoothstep(0.35, 0.95, textureLod(historyColor, sunUv, 0.0).a)
        * step(kClearDepthThreshold, textureLod(sourceDepth, sunUv, 0.0).r);
    float angle = atan(fromSun.y, fromSun.x);
    float spikes = pow(abs(cos(3.0 * angle + 0.5)), 28.0);
    float falloff = exp(-r / (0.35 * kStarRadius)) * (1.0 - r / kStarRadius);
    float core = 0.02 / (r + 0.012);
    vec3 tint = mix(params.sunRayColor.rgb, vec3(1.0), 0.5);
    return tint * (kStarGain * params.sunRay.z * seen * falloff * (spikes * 0.9 + core * 0.25));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 fullSize = ivec2(params.sizes.xy);
    // A persistent target keeps its old size for one frame after a resize: never write past the bound images.
    ivec2 writable = min(imageSize(historyColorOut), min(imageSize(historyAuxOut), imageSize(destinationImage)));
    if (pixel.x >= fullSize.x || pixel.y >= fullSize.y || pixel.x >= writable.x || pixel.y >= writable.y) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(fullSize);
    vec3 scene = textureLod(sourceColor, uv, 0.0).rgb;
    float rawDepth = textureLod(sourceDepth, uv, 0.0).r;
    vec2 ndc = uv * 2.0 - 1.0;

    // Distance this pixel's surface lies at; a pixel without a surface sees the whole layer.
    float pixelEndKm = kNoSurfaceKm;
    if (rawDepth < kClearDepthThreshold) {
        vec4 world = params.invViewProjection * vec4(ndc, rawDepth, 1.0);
        pixelEndKm = min(length(world.xyz / world.w) * 0.001, kNoSurfaceKm);
    }

    // Fresh samples: the four march texels around this pixel. The texel at integer coordinates holds
    // the pixel (texel * divisor + offset), so the pixel that was marched itself gets weight 1.
    int divisor = int(params.counts.x);
    ivec2 lowSize = min(ivec2(params.sizes.zw), min(textureSize(lowColor, 0), textureSize(lowAux, 0)));
    vec2 lowPosition = vec2(pixel - ivec2(params.counts.yz)) / float(divisor);
    ivec2 lowBase = ivec2(floor(lowPosition));
    vec2 lowFrac = lowPosition - vec2(lowBase);
    vec4 freshSum = vec4(0.0);
    float freshDistanceSum = 0.0;
    float freshDistanceWeight = 0.0;
    float freshWeight = 0.0;
    float maxTapWeight = 0.0;
    for (int k = 0; k < 4; ++k) {
        ivec2 c = clamp(lowBase + ivec2(k & 1, k >> 1), ivec2(0), lowSize - 1);
        float w = ((k & 1) == 1 ? lowFrac.x : 1.0 - lowFrac.x) * ((k >> 1) == 1 ? lowFrac.y : 1.0 - lowFrac.y);
        if (w <= 0.0) {
            continue;
        }
        vec4 tapColor = texelFetch(lowColor, c, 0);
        vec4 tapAux = texelFetch(lowAux, c, 0);
        if (!TapUsable(tapColor, tapAux, pixelEndKm)) {
            continue;
        }
        freshSum += tapColor * w;
        freshWeight += w;
        float cloudWeight = w * (1.0 - tapColor.a);
        freshDistanceSum += tapAux.x * cloudWeight;
        freshDistanceWeight += cloudWeight;
        maxTapWeight = max(maxTapWeight, w);
    }
    // The history is clamped into the box of the usable march texels around the pixel, 3 x 3 of them,
    // so that a pixel that was marched itself still has neighbours to compare with. Skipped when off.
    vec4 boxMin = vec4(1e30);
    vec4 boxMax = vec4(-1e30);
    if (params.blend.z > 0.0) {
        ivec2 lowNearest = ivec2(floor(lowPosition + 0.5));
        for (int k = 0; k < 9; ++k) {
            ivec2 c = clamp(lowNearest + ivec2(k % 3 - 1, k / 3 - 1), ivec2(0), lowSize - 1);
            vec4 tapColor = texelFetch(lowColor, c, 0);
            if (TapUsable(tapColor, texelFetch(lowAux, c, 0), pixelEndKm)) {
                boxMin = min(boxMin, tapColor);
                boxMax = max(boxMax, tapColor);
            }
        }
    }
    bool hasFresh = freshWeight > 1e-3;
    vec4 fresh = hasFresh ? freshSum / freshWeight : vec4(0.0, 0.0, 0.0, 1.0);
    float freshDistanceKm = freshDistanceWeight > 0.0 ? freshDistanceSum / freshDistanceWeight : 0.0;

    // History: reproject through the cloud, which is far, never through the scene surface.
    vec4 history = vec4(0.0, 0.0, 0.0, 1.0);
    float historyDistanceKm = 0.0;
    float historyCount = 0.0;
    bool hasHistory = false;
    vec2 reprojectionShift = vec2(0.0); // Motion of this pixel since last frame, in pixels.
    if (params.counts.w != 0u) {
        vec4 nearPoint = params.invViewProjection * vec4(ndc, 0.0, 1.0);
        vec4 farPoint = params.invViewProjection * vec4(ndc, 1.0, 1.0);
        vec3 rd = normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
        float distance = (hasFresh && freshDistanceWeight > 0.0) ? freshDistanceKm * 1000.0 : params.blend.w;
        vec3 previous = rd * distance + vec3(params.windDelta.x, 0.0, params.windDelta.z);
        vec4 clip = params.prevViewProjection * vec4(previous, 1.0);
        if (clip.w > 0.0) {
            vec2 previousUv = clip.xy / clip.w * 0.5 + 0.5;
            vec2 previousTexel = previousUv * vec2(fullSize) - 0.5;
            // A still pixel must read its history texel EXACTLY: a fraction of 1e-4 texel (matrix rounding) makes the
            // resample differ from the stored value by a few 1e-6 and the rgba16f store then rounds it DOWN a half-float
            // step (about 5e-4 relative) on every one of the frames in which this pixel is not marched, a steady drain
            // that darkened the converged picture (more at larger divisors). Snap near-integer positions.
            vec2 snapped = floor(previousTexel + 0.5);
            previousTexel = mix(previousTexel, snapped, lessThan(abs(previousTexel - snapped), vec2(kSnapTexels)));
            reprojectionShift = previousTexel - vec2(pixel);
            hasHistory = FetchHistory(previousTexel, pixelEndKm, history, historyDistanceKm, historyCount);
        }
    }

    vec4 cloud;
    float cloudDistanceKm;
    // Samples this pixel has accumulated (history aux z). Every sample of an own march adds 1 until the
    // freshBlend floor (1 / (count + 1)) is reached; motion pulls the count back to 1 so a moving picture
    // keeps the fast blend it had before.
    float shiftLength = clamp(length(reprojectionShift), 0.0, 1.0);
    bool adaptive = params.motion.z > 0.5;
    float maxCount = max(1.0 / max(params.blend.y, 0.01) - 1.0, 0.0);
    float effectiveCount = adaptive ? min(historyCount, mix(maxCount, 1.0, shiftLength)) : 0.0;
    float newCount = 0.0;
    if (hasHistory && hasFresh) {
        // A positive clamp pulls the history into the box of the fresh samples so a changed cloud leaves
        // no trail; the march noise is as large as the signal at cloud edges, so zero turns it off.
        vec4 kept = history;
        if (params.blend.z > 0.0) {
            vec4 extent = (boxMax - boxMin) * params.blend.z + 1e-3;
            kept = clamp(history, boxMin - extent, boxMax + extent);
        }
        bool marched = maxTapWeight > 0.999;
        float alpha = marched ? params.blend.y : params.blend.x;
        if (marched && adaptive) {
            alpha = max(alpha, 1.0 / (effectiveCount + 1.0));
            newCount = min(effectiveCount + 1.0, maxCount);
        } else {
            newCount = effectiveCount;
        }
        // Where the picture moves the history is blurred and stale, so the new samples count for more.
        alpha = max(alpha, params.motion.x * shiftLength);
        cloud = mix(kept, fresh, alpha);
        cloudDistanceKm = freshDistanceWeight > 0.0 ? mix(historyDistanceKm, freshDistanceKm, alpha) : historyDistanceKm;
    } else if (hasFresh) {
        cloud = fresh;
        cloudDistanceKm = freshDistanceKm;
        newCount = (maxTapWeight > 0.999 && adaptive) ? 1.0 : 0.0;
    } else if (hasHistory) {
        cloud = history;
        cloudDistanceKm = historyDistanceKm;
        newCount = effectiveCount;
    } else {
        cloud = vec4(0.0, 0.0, 0.0, 1.0);
        cloudDistanceKm = 0.0;
    }
    cloud = vec4(max(cloud.rgb, vec3(0.0)), clamp(cloud.a, 0.0, 1.0));

    imageStore(historyColorOut, pixel, cloud);
    imageStore(historyAuxOut, pixel, vec4(cloudDistanceKm, pixelEndKm, newCount, 0.0));

    vec3 color = scene * cloud.a + cloud.rgb;
    if (params.sunRay.z > 0.0) {
        color += SunRays(uv, pixel, pixelEndKm, cloud.a);
        color += SunStar(uv);
    }
    if (any(isnan(color)) || any(isinf(color))) {
        color = scene;
    }
    imageStore(destinationImage, pixel, vec4(clamp(color, vec3(0.0), vec3(kMaxOutputLuminance)), 1.0));
}
