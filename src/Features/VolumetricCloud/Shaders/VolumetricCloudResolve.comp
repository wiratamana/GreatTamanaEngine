#version 450

// Upsamples the low resolution cloud march, blends it with the reprojected history of the last frame and
// composites the result over the scene. A tap or a history texel is only used where it saw the same surface.
layout(local_size_x = 8, local_size_y = 8) in;

#include "SceneDepthConstants.glsl"

// Member names and order match VolumetricCloudResolveParamsGpu.
layout(std430, binding = 0) readonly buffer VolumetricCloudResolveParams {
    mat4 invViewProjection;     // Clip space to world position minus eye.
    mat4 prevViewProjection;    // Last frame's world position minus THIS frame's eye to clip space.
    vec4 eye;           // xyz eye.
    vec4 windDelta;     // xz shift to last frame's cloud position.
    vec4 blend;         // x history blend, y fresh blend, z clamp expand, w fallback cloud distance (m).
    vec4 motion;        // x extra blend at one pixel of motion, y sharp (Catmull-Rom) history 0..1, z adaptive sample count 0/1.
    uvec4 counts;       // x divisor, yz sample offset, w history valid.
    uvec4 sizes;        // xy view size, zw march target size.
    vec4 sunRay;        // xy sun uv, z spoke strength (sunRaysSpoke, 0 = off), w starburst strength (0 = off).
    vec4 sunRayColor;   // rgb colour, w glow radius (view height units).
} params;

layout(binding = 1) uniform sampler2D sourceColor;
layout(binding = 2) uniform sampler2D sourceDepth;
layout(binding = 3) uniform sampler2D lowColor;      // Cloud light in rgb, transmittance in a.
layout(binding = 4) uniform sampler2D lowAux;        // x cloud distance, y complete up to (km).
layout(binding = 5) uniform sampler2D historyColor;
layout(binding = 6) uniform sampler2D historyAux;
layout(binding = 7, rgba16f) uniform writeonly image2D historyColorOut;
layout(binding = 8, rgba16f) uniform writeonly image2D historyAuxOut;
layout(binding = 9, rgba16f) uniform writeonly image2D destinationImage;
layout(binding = 10) uniform sampler2D sunShafts;    // Quarter-res rays in rgb, raw open fraction in a.

const float kNoSurfaceKm = 1000.0;
const float kMaxOutputLuminance = 65504.0;
const float kRelative = 0.03;
const float kSlackKm = 0.02;
const float kClearTransmittance = 0.999;
const float kSnapTexels = 0.004;
const float kSceneHdrKnee = 64.0;
const float kResolveShoulderStart = 3.6;
const float kResolveShoulderCeiling = 7.2;
const vec3 kCloudResolveLumaWeights = vec3(0.2126, 0.7152, 0.0722);

float CloudLuma(vec3 rgb)
{
    return dot(max(rgb, vec3(0.0)), kCloudResolveLumaWeights);
}

// Chroma-preserving soft HDR shoulder above kResolveShoulderStart toward kResolveShoulderCeiling.
vec3 CompressCloudShoulder(vec3 rgb)
{
    vec3 clean = max(rgb, vec3(0.0));
    float luma = dot(clean, kCloudResolveLumaWeights);
    if (luma <= kResolveShoulderStart) {
        return clean;
    }
    float span = kResolveShoulderCeiling - kResolveShoulderStart;
    float excess = luma - kResolveShoulderStart;
    float compressed = kResolveShoulderStart + span * excess / (span + excess);
    return clean * (compressed / luma);
}

// Dims HDR glare and the sun disc by the fourth power of transmittance so the disc cannot leak through cloud.
vec3 SceneBehindCloud(vec3 scene, float transmittance)
{
    float peak = max(scene.r, max(scene.g, scene.b));
    if (peak <= kSceneHdrKnee) {
        return scene * transmittance;
    }
    vec3 low = scene * (kSceneHdrKnee / peak);
    float t2 = transmittance * transmittance;
    return low * transmittance + (scene - low) * (t2 * t2);
}

// Keep identical to CloudTapUsable() in VolumetricCloudMath.cpp.
bool TapUsable(vec4 color, vec4 aux, float pixelEndKm)
{
    if (aux.y < (1.0 - kRelative) * pixelEndKm - kSlackKm) {
        return false;
    }
    if (pixelEndKm < 50.0 && aux.y > pixelEndKm * 1.08 + 0.15) {
        return false;
    }
    return color.a > kClearTransmittance || aux.x <= (1.0 + kRelative) * pixelEndKm + kSlackKm;
}

// Catmull-Rom weights of the four texels around a fractional position.
vec4 CatmullRomWeights(float f)
{
    float f2 = f * f;
    float f3 = f2 * f;
    return vec4(-0.5 * f3 + f2 - 0.5 * f, 1.5 * f3 - 2.5 * f2 + 1.0, -1.5 * f3 + 2.0 * f2 + 0.5 * f, 0.5 * f3 - 0.5 * f2);
}

// Fetches usable history texels with optional clamped Catmull-Rom sharpening and accumulated sample count.
bool FetchHistory(vec2 texelPosition, float pixelEndKm, out vec4 color, out float distanceKm, out float count)
{
    ivec2 size = min(textureSize(historyColor, 0), textureSize(historyAux, 0));
    ivec2 base = ivec2(floor(texelPosition));
    vec2 f = texelPosition - vec2(base);
    vec4 colorSum = vec4(0.0);
    float distanceSum = 0.0;
    float distanceWeight = 0.0;
    float weightSum = 0.0;
    float countSum = 0.0;
    vec4 innerMin = vec4(1e30);
    vec4 innerMax = vec4(-1e30);
    for (int k = 0; k < 4; ++k) {
        ivec2 c = base + ivec2(k & 1, k >> 1);
        if (any(lessThan(c, ivec2(0))) || any(greaterThanEqual(c, size))) {
            continue;
        }
        float w = ((k & 1) == 1 ? f.x : 1.0 - f.x) * ((k >> 1) == 1 ? f.y : 1.0 - f.y);
        if (w <= 0.0) {
            continue;
        }
        vec4 hc = texelFetch(historyColor, c, 0);
        vec4 ha = texelFetch(historyAux, c, 0);
        if (!TapUsable(hc, ha, pixelEndKm)) {
            continue;
        }
        innerMin = min(innerMin, hc);
        innerMax = max(innerMax, hc);
        countSum += ha.z * w;
        colorSum += hc * w;
        weightSum += w;
        float cloudWeight = w * (1.0 - hc.a);
        distanceSum += ha.x * cloudWeight;
        distanceWeight += cloudWeight;
    }
    color = vec4(0.0, 0.0, 0.0, 1.0);
    distanceKm = 0.0;
    count = 0.0;
    if (weightSum < 1e-3) {
        return false;
    }
    color = colorSum / weightSum;
    count = countSum / weightSum;
    if (params.motion.y > 0.0 && weightSum > 0.999) {
        vec4 wx = CatmullRomWeights(f.x);
        vec4 wy = CatmullRomWeights(f.y);
        vec4 cubic = vec4(0.0);
        for (int j = 0; j < 4; ++j) {
            for (int i = 0; i < 4; ++i) {
                ivec2 c = clamp(base + ivec2(i - 1, j - 1), ivec2(0), size - 1);
                cubic += texelFetch(historyColor, c, 0) * (wx[i] * wy[j]);
            }
        }
        cubic = clamp(cubic, innerMin, innerMax);
        color = mix(color, cubic, params.motion.y);
    }
    distanceKm = distanceWeight > 0.0 ? distanceSum / distanceWeight : 0.0;
    return true;
}

const float kStarRadius = 0.13;   // Reach of the spikes (view height units).
const float kStarGain = 2.5;
const float kShaftGain = 2.0;     // Restores full HDR scale from the 0..3 sun-shafts buffer.
const float kShaftCloudKeep = 0.5;
const float kSpokeWidth = 0.012;  // Tangential high-pass offset (view height units).
const float kSpokeFarScale = 2.0;
const float kSpokeFarMix = 0.4;
const float kSpokeNoiseFloor = 0.03;
const float kSpokeAirLengthM = 2000.0;
const float kSpokeGain = 6.0;
const float kSpokeFalloff = 1.5;
const float kSpokeSoftCap = 3.0;
const float kSpokeMinLuma = 1e-3;
const float kSpokeMinDist = 1e-5;
const vec3 kSpokeLumaWeights = vec3(0.2126, 0.7152, 0.0722);

// Share of this pixel and its four neighbours that show sky: the spikes fade out at a silhouette instead of cutting.
float SkyShare(vec2 uv, float ownDepth)
{
    vec2 texel = 1.0 / vec2(params.sizes.xy);
    float share = step(kClearDepthThreshold, ownDepth);
    share += step(kClearDepthThreshold, textureLod(sourceDepth, uv + vec2(texel.x, 0.0), 0.0).r);
    share += step(kClearDepthThreshold, textureLod(sourceDepth, uv - vec2(texel.x, 0.0), 0.0).r);
    share += step(kClearDepthThreshold, textureLod(sourceDepth, uv + vec2(0.0, texel.y), 0.0).r);
    share += step(kClearDepthThreshold, textureLod(sourceDepth, uv - vec2(0.0, texel.y), 0.0).r);
    return share * 0.2;
}

// A small starburst on the sun where the sun shows through a gap: six soft spikes, stable in time.
// The spikes are drawn over sky only; a ridge or a building in front of the sun carries none.
vec3 SunStar(vec2 uv, float ownDepth)
{
    vec2 aspect = vec2(float(params.sizes.x) / float(params.sizes.y), 1.0);
    vec2 fromSun = (uv - params.sunRay.xy) * aspect;
    float r = length(fromSun);
    if (r > kStarRadius) {
        return vec3(0.0);
    }
    vec2 sunUv = clamp(params.sunRay.xy, vec2(0.0), vec2(1.0));
    float seen = smoothstep(0.35, 0.95, textureLod(historyColor, sunUv, 0.0).a)
        * step(kClearDepthThreshold, textureLod(sourceDepth, sunUv, 0.0).r);
    seen *= SkyShare(uv, ownDepth);
    float angle = atan(fromSun.y, fromSun.x);
    float spikes = pow(abs(cos(3.0 * angle + 0.5)), 40.0);
    float falloff = exp(-r / (0.35 * kStarRadius)) * (1.0 - r / kStarRadius);
    float core = 0.02 / (r + 0.012);
    vec3 tint = mix(params.sunRayColor.rgb, vec3(1.0), 0.5);
    return tint * (kStarGain * params.sunRay.w * seen * falloff * (spikes * 0.9 + core * 0.25));
}

float SafeFloat(float v, float fallback)
{
    return (isnan(v) || isinf(v)) ? fallback : v;
}

vec3 SafeNonNegVec3(vec3 v)
{
    return vec3(
        max(SafeFloat(v.x, 0.0), 0.0),
        max(SafeFloat(v.y, 0.0), 0.0),
        max(SafeFloat(v.z, 0.0), 0.0));
}

// Angular high-pass of the open-ray fraction (sunShafts.a) for crepuscular spokes between small clouds.
vec3 SunShaftSpokes(vec2 uv, vec4 centerSample, float spokeStrength)
{
    float aspect = float(max(params.sizes.x, 1u)) / float(max(params.sizes.y, 1u));
    vec2 sunUv = vec2(SafeFloat(params.sunRay.x, 0.5), SafeFloat(params.sunRay.y, 0.5));
    vec2 toSun = vec2((sunUv.x - uv.x) * aspect, sunUv.y - uv.y);
    float distToSun = length(toSun);
    if (distToSun <= kSpokeMinDist) {
        return vec3(0.0);
    }

    vec2 radialDir = toSun / distToSun;
    vec2 tangent = vec2(-radialDir.y / aspect, radialDir.x);
    vec2 halfTexel = 0.5 / vec2(max(textureSize(sunShafts, 0), ivec2(1)));
    vec2 uvMin = halfTexel;
    vec2 uvMax = vec2(1.0) - halfTexel;

    float centerAlpha = clamp(SafeFloat(centerSample.a, 0.0), 0.0, 1.0);
    float aL1 = clamp(SafeFloat(textureLod(sunShafts, clamp(uv - tangent * kSpokeWidth, uvMin, uvMax), 0.0).a, 0.0), 0.0, 1.0);
    float aR1 = clamp(SafeFloat(textureLod(sunShafts, clamp(uv + tangent * kSpokeWidth, uvMin, uvMax), 0.0).a, 0.0), 0.0, 1.0);
    float aL2 = clamp(SafeFloat(textureLod(sunShafts, clamp(uv - tangent * (kSpokeFarScale * kSpokeWidth), uvMin, uvMax), 0.0).a, 0.0), 0.0, 1.0);
    float aR2 = clamp(SafeFloat(textureLod(sunShafts, clamp(uv + tangent * (kSpokeFarScale * kSpokeWidth), uvMin, uvMax), 0.0).a, 0.0), 0.0, 1.0);
    float sideNear = 0.5 * (aL1 + aR1);
    float sideFar = 0.5 * (aL2 + aR2);
    float spoke = max(0.0, centerAlpha - mix(sideNear, sideFar, kSpokeFarMix));
    spoke = max(0.0, spoke - kSpokeNoiseFloor);
    if (spoke <= 0.0) {
        return vec3(0.0);
    }

    vec3 sunShaftsRgbCentre = SafeNonNegVec3(centerSample.rgb);
    float centreLuma = dot(sunShaftsRgbCentre, kSpokeLumaWeights);
    vec3 fallbackRgb = SafeNonNegVec3(params.sunRayColor.rgb);
    float fallbackLuma = dot(fallbackRgb, kSpokeLumaWeights);
    vec3 hue = centreLuma >= kSpokeMinLuma
        ? (sunShaftsRgbCentre / max(centreLuma, kSpokeMinLuma))
        : (fallbackRgb / max(fallbackLuma, kSpokeMinLuma));

    float falloff = exp(-distToSun * kSpokeFalloff);
    vec3 spokeRgb = hue * (spoke * kSpokeGain * falloff * spokeStrength);
    float peak = max(spokeRgb.r, max(spokeRgb.g, spokeRgb.b));
    spokeRgb /= (1.0 + peak / kSpokeSoftCap);
    return SafeNonNegVec3(spokeRgb);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 fullSize = ivec2(params.sizes.xy);
    // A persistent target keeps its old size for one frame after a resize: never write past the bound images.
    ivec2 writable = min(imageSize(historyColorOut), min(imageSize(historyAuxOut), imageSize(destinationImage)));
    if (pixel.x >= fullSize.x || pixel.y >= fullSize.y || pixel.x >= writable.x || pixel.y >= writable.y) {
        return;
    }
    vec2 uv = (vec2(pixel) + 0.5) / vec2(fullSize);
    vec3 scene = textureLod(sourceColor, uv, 0.0).rgb;
    float rawDepth = textureLod(sourceDepth, uv, 0.0).r;
    vec2 ndc = uv * 2.0 - 1.0;

    // Distance this pixel's surface lies at; a pixel without a surface sees the whole layer.
    float pixelEndKm = kNoSurfaceKm;
    if (rawDepth < kClearDepthThreshold) {
        vec4 world = params.invViewProjection * vec4(ndc, rawDepth, 1.0);
        pixelEndKm = min(length(world.xyz / world.w) * 0.001, kNoSurfaceKm);
    }

    // Upsample 3x3 low-res taps with Karis inverse-luminance weights, silhouette distance dilation and moments.
    int divisor = int(params.counts.x);
    ivec2 lowSize = min(ivec2(params.sizes.zw), min(textureSize(lowColor, 0), textureSize(lowAux, 0)));
    vec2 lowPosition = vec2(pixel - ivec2(params.counts.yz)) / float(divisor);
    ivec2 lowNearest = ivec2(floor(lowPosition + 0.5));
    bool exactSample = dot(lowPosition - vec2(lowNearest), lowPosition - vec2(lowNearest)) < 1e-4;
    vec4 freshSum = vec4(0.0);
    float freshDistanceSum = 0.0;
    float freshDistanceWeight = 0.0;
    float freshWeight = 0.0;
    float maxTapWeight = 0.0;
    float nearestCloudKm = 1e30;
    vec4 minColor = vec4(1e30);
    vec4 maxColor = vec4(-1e30);
    vec4 moment1 = vec4(0.0);
    vec4 moment2 = vec4(0.0);
    float boxCount = 0.0;
    for (int k = 0; k < 9; ++k) {
        ivec2 offset = ivec2(k % 3 - 1, k / 3 - 1);
        ivec2 c = clamp(lowNearest + offset, ivec2(0), lowSize - 1);
        vec4 tapColor = texelFetch(lowColor, c, 0);
        vec4 tapAux = texelFetch(lowAux, c, 0);
        if (!TapUsable(tapColor, tapAux, pixelEndKm)) {
            continue;
        }
        minColor = min(minColor, tapColor);
        maxColor = max(maxColor, tapColor);
        moment1 += tapColor;
        moment2 += tapColor * tapColor;
        boxCount += 1.0;
        if (1.0 - tapColor.a > 0.01 && tapAux.x > 0.0) {
            nearestCloudKm = min(nearestCloudKm, tapAux.x);
        }
        vec2 d = abs(lowPosition - vec2(lowNearest + offset));
        float bilinearW = max(1.0 - d.x, 0.0) * max(1.0 - d.y, 0.0);
        maxTapWeight = max(maxTapWeight, bilinearW);
        float w = exactSample ? bilinearW : (max(1.25 - d.x, 0.0) * max(1.25 - d.y, 0.0));
        if (w <= 0.0) {
            continue;
        }
        float hdrW = 1.0 / (1.0 + CloudLuma(tapColor.rgb) * 0.5);
        float sampleW = w * hdrW;
        freshSum += tapColor * sampleW;
        freshWeight += sampleW;
        float cloudWeight = w * (1.0 - tapColor.a);
        freshDistanceSum += tapAux.x * cloudWeight;
        freshDistanceWeight += cloudWeight;
    }
    bool hasFresh = freshWeight > 1e-5;
    vec4 fresh = hasFresh ? freshSum / freshWeight : vec4(0.0, 0.0, 0.0, 1.0);
    float freshDistanceKm = freshDistanceWeight > 0.0
        ? min(freshDistanceSum / freshDistanceWeight, nearestCloudKm)
        : (nearestCloudKm < 1e20 ? nearestCloudKm : 0.0);

    // Reproject through the dilated cloud distance so silhouette borders never jump to fallback sky depth.
    vec4 history = vec4(0.0, 0.0, 0.0, 1.0);
    float historyDistanceKm = 0.0;
    float historyCount = 0.0;
    bool hasHistory = false;
    vec2 reprojectionShift = vec2(0.0);
    if (params.counts.w != 0u) {
        vec4 nearPoint = params.invViewProjection * vec4(ndc, 0.0, 1.0);
        vec4 farPoint = params.invViewProjection * vec4(ndc, 1.0, 1.0);
        vec3 rd = normalize(farPoint.xyz / farPoint.w - nearPoint.xyz / nearPoint.w);
        float distance = freshDistanceKm > 0.0 ? freshDistanceKm * 1000.0 : params.blend.w;
        vec3 previous = rd * distance + vec3(params.windDelta.x, 0.0, params.windDelta.z);
        vec4 clip = params.prevViewProjection * vec4(previous, 1.0);
        if (clip.w > 0.0) {
            vec2 previousUv = clip.xy / clip.w * 0.5 + 0.5;
            vec2 previousTexel = previousUv * vec2(fullSize) - 0.5;
            // Snap near-integer texels so still pixels never lose half-float precision across non-marched frames.
            vec2 snapped = floor(previousTexel + 0.5);
            previousTexel = mix(previousTexel, snapped, lessThan(abs(previousTexel - snapped), vec2(kSnapTexels)));
            reprojectionShift = previousTexel - vec2(pixel);
            hasHistory = FetchHistory(previousTexel, pixelEndKm, history, historyDistanceKm, historyCount);
        }
    }

    vec4 cloud;
    float cloudDistanceKm;
    // Accumulate marched sample count up to the freshBlend floor, relaxing gently only under real motion.
    float shiftLength = clamp(length(reprojectionShift), 0.0, 1.0);
    float motionFactor = smoothstep(0.15, 1.0, shiftLength);
    bool adaptive = params.motion.z > 0.5;
    float maxCount = max(1.0 / max(params.blend.y, 0.01) - 1.0, 0.0);
    float effectiveCount = adaptive ? min(historyCount, mix(maxCount, 1.0, motionFactor)) : 0.0;
    float newCount = 0.0;
    if (hasHistory && hasFresh) {
        // Preserve exact Bayer-reconstructed history when still; engage variance clamping smoothly under motion.
        vec4 kept = history;
        if (params.blend.z > 0.0 && boxCount > 0.0) {
            vec4 mean = moment1 / boxCount;
            vec4 variance = max(moment2 / boxCount - mean * mean, vec4(0.0));
            vec4 sigma = sqrt(variance);
            float edgeContrast = clamp(maxColor.a - minColor.a, 0.0, 1.0);
            float expand = params.blend.z * mix(3.0, 1.0, smoothstep(0.08, 0.45, edgeContrast));
            vec4 clampMin = max(min(mean - sigma * expand, fresh) - 1e-3, vec4(0.0));
            vec4 clampMax = max(mean + sigma * expand, fresh) + 1e-3;
            clampMax.a = min(clampMax.a, 1.0);
            vec4 clamped = clamp(history, clampMin, clampMax);
            float clampWeight = smoothstep(0.15, 1.25, length(reprojectionShift));
            kept = mix(history, clamped, clampWeight);
        }
        bool marched = maxTapWeight > 0.999;
        float alpha = marched ? params.blend.y : params.blend.x;
        if (marched && adaptive) {
            alpha = max(alpha, 1.0 / (effectiveCount + 1.0));
            newCount = min(effectiveCount + 1.0, maxCount);
        } else {
            newCount = effectiveCount;
        }
        alpha = max(alpha, params.motion.x * motionFactor);
        cloud = mix(kept, fresh, alpha);
        cloudDistanceKm = freshDistanceKm > 0.0 ? mix(historyDistanceKm, freshDistanceKm, alpha) : historyDistanceKm;
    } else if (hasFresh) {
        cloud = fresh;
        cloudDistanceKm = freshDistanceKm;
        newCount = (maxTapWeight > 0.999 && adaptive) ? 1.0 : 0.0;
    } else if (hasHistory) {
        cloud = history;
        cloudDistanceKm = historyDistanceKm;
        newCount = effectiveCount;
    } else {
        cloud = vec4(0.0, 0.0, 0.0, 1.0);
        cloudDistanceKm = 0.0;
    }
    cloud = vec4(max(cloud.rgb, vec3(0.0)), clamp(cloud.a, 0.0, 1.0));

    imageStore(historyColorOut, pixel, cloud);
    imageStore(historyAuxOut, pixel, vec4(cloudDistanceKm, pixelEndKm, newCount, 0.0));

    // Gentle 3x3 transmittance-weighted spatial filter on unconverged fringe pixels to prevent single-ray stipple.
    if (newCount < 3.0 && cloud.a > 0.05 && cloud.a < 0.95) {
        vec4 fringeSum = vec4(0.0);
        float fringeWeight = 0.0;
        for (int k = 0; k < 9; ++k) {
            ivec2 offset = ivec2(k % 3 - 1, k / 3 - 1);
            ivec2 c = clamp(lowNearest + offset, ivec2(0), lowSize - 1);
            vec4 tapColor = texelFetch(lowColor, c, 0);
            vec4 tapAux = texelFetch(lowAux, c, 0);
            if (!TapUsable(tapColor, tapAux, pixelEndKm)) {
                continue;
            }
            float tentW = (offset.x == 0 ? 2.0 : 1.0) * (offset.y == 0 ? 2.0 : 1.0);
            float transW = exp(-abs(tapColor.a - cloud.a) * 6.0);
            float hdrW = 1.0 / (1.0 + CloudLuma(tapColor.rgb) * 0.5);
            float w = tentW * transW * hdrW;
            fringeSum += tapColor * w;
            fringeWeight += w;
        }
        if (fringeWeight > 1e-5) {
            float freshFade = 1.0 - smoothstep(0.0, 3.0, newCount);
            float fringeGate = smoothstep(0.05, 0.15, cloud.a) * (1.0 - smoothstep(0.85, 0.95, cloud.a));
            cloud = mix(cloud, fringeSum / fringeWeight, 0.65 * freshFade * fringeGate);
        }
    }

    cloud.rgb = CompressCloudShoulder(cloud.rgb);
    vec3 color = SceneBehindCloud(scene, cloud.a) + cloud.rgb;
    vec4 shaftCenter = textureLod(sunShafts, uv, 0.0);
    float shaftCloudWeight = mix(0.06, 1.0, cloud.a * cloud.a);
    color += SafeNonNegVec3(shaftCenter.rgb) * (kShaftGain * shaftCloudWeight);
    float spokeStrength = max(SafeFloat(params.sunRay.z, 0.0), 0.0);
    if (spokeStrength > 0.0) {
        float spokeAir = (rawDepth >= kClearDepthThreshold)
            ? 1.0
            : clamp(SafeFloat(1.0 - exp(-pixelEndKm * 1000.0 / kSpokeAirLengthM), 0.0), 0.0, 1.0);
        color += SunShaftSpokes(uv, shaftCenter, spokeStrength) * shaftCloudWeight * spokeAir;
    }
    if (params.sunRay.w > 0.0) {
        color += SunStar(uv, rawDepth) * cloud.a;
    }
    if (any(isnan(color)) || any(isinf(color))) {
        color = scene;
    }
    imageStore(destinationImage, pixel, vec4(clamp(color, vec3(0.0), vec3(kMaxOutputLuminance)), 1.0));
}
