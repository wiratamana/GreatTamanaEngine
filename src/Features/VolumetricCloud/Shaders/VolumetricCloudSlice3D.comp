#version 450

// Debug overlay: one z-slice of a baked 3D texture, repeated `tiling` times over the screen (REPEAT sampling).
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    float slice;       // 0..1 along z.
    float tiling;      // Repeats over the screen.
    uint channel;      // 0 R, 1 G, 2 B, 3 A, 4 RGB.
    uint reserved;
} pc;

layout(binding = 0) uniform sampler3D noiseVolume;
layout(binding = 1, rgba16f) uniform writeonly image2D destinationImage;

void main()
{
    ivec2 outSize = imageSize(destinationImage);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= outSize.x || texel.y >= outSize.y) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(outSize);
    vec4 value = texture(noiseVolume, vec3(uv * pc.tiling, pc.slice));
    vec3 color = pc.channel == 4u ? value.rgb : vec3(value[min(pc.channel, 3u)]);
    imageStore(destinationImage, texel, vec4(color, 1.0));
}
