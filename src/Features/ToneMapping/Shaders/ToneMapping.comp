#version 450

// Display transform: exposure, saturation, curve, sRGB encode, dither. Reads linear scene color,
// writes display values into an 8-bit image.
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    vec4 exposureModeSaturationDither; // x exposure, y mode (0 Clamp, 1 Aces, 2 PbrNeutral), z saturation, w dither (8-bit steps)
    uvec4 frame;                       // x frame index
} pc;

layout(binding = 0) uniform sampler2D sourceColor;
layout(binding = 1, rgba8) uniform writeonly image2D destinationImage;

vec3 SrgbEncode(vec3 c)
{
    c = clamp(c, vec3(0.0), vec3(1.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

vec3 AcesFilm(vec3 x)
{
    const float a = 2.51, b = 0.03, c = 2.43, d = 0.59, e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 PbrNeutral(vec3 color)
{
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;
    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;
    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) {
        return color;
    }
    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;
    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, newPeak * vec3(1.0), g);
}

float InterleavedGradientNoise(vec2 p, uint frame)
{
    p += 5.588238 * float(frame & 63u);
    return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715))));
}

void main()
{
    ivec2 size = imageSize(destinationImage);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= size.x || texel.y >= size.y) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    vec3 c = texture(sourceColor, uv).rgb;
    if (any(isnan(c)) || any(isinf(c))) {
        c = vec3(0.0);
    }
    c *= pc.exposureModeSaturationDither.x;
    float luma = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = max(mix(vec3(luma), c, pc.exposureModeSaturationDither.z), vec3(0.0));
    float mode = pc.exposureModeSaturationDither.y;
    if (mode > 1.5) {
        c = PbrNeutral(c);
    } else if (mode > 0.5) {
        c = AcesFilm(c);
    }
    vec3 display = SrgbEncode(c);
    float noise = InterleavedGradientNoise(vec2(texel), pc.frame.x) - 0.5;
    display += noise * pc.exposureModeSaturationDither.w / 255.0;
    imageStore(destinationImage, texel, vec4(clamp(display, 0.0, 1.0), 1.0));
}
