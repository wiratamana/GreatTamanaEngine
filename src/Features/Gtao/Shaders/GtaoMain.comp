#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Member names and order match GtaoMainParamsGpu.
layout(std430, binding = 0) readonly buffer GtaoMainParams {
    mat4 invViewProjection;
    vec4 eyeAndPixelScale;     // xyz eye, w pixel scale.
    vec4 rightAndRadius;       // xyz camera right, w effect radius.
    vec4 downAndFalloffMul;    // xyz pixel-down direction, w falloff mul.
    vec4 forwardAndFalloffAdd; // xyz forward, w falloff add.
    vec4 tuning;               // x final power, y thin occluder, z distribution power, w min visibility.
    vec4 distanceFade;         // x fade start, y fade end, z max screen radius.
    uvec4 counts;              // x slices, y steps, z noise frame, w divisor.
    vec4 reserved;
} params;

layout(binding = 1) uniform sampler2D sceneDepth;
layout(binding = 2, rgba16f) uniform writeonly image2D aoOutput; // x visibility, y view depth (0 = sky).

const float kSkyDepth = 0.999999;
const float kPi = 3.14159265359;
const float kHalfPi = 1.57079632679;
const float kMinScreenRadius = 1.3; // Pixels; a smaller radius shows no occlusion.

ivec2 gDepthSize;

float FetchDepth(ivec2 p)
{
    return texelFetch(sceneDepth, clamp(p, ivec2(0), gDepthSize - ivec2(1)), 0).r;
}

vec3 WorldAt(ivec2 p, float depth)
{
    vec2 uv = (vec2(p) + 0.5) / vec2(gDepthSize);
    vec4 world = params.invViewProjection * vec4(uv * 2.0 - 1.0, depth, 1.0);
    return world.xyz / world.w;
}

bool OnScreen(ivec2 p)
{
    return all(greaterThanEqual(p, ivec2(0))) && all(lessThan(p, gDepthSize));
}

// Geometric normal from depth, using the neighbour with the smaller depth step on each axis.
// A sky neighbour is never chosen; with no usable neighbour the view direction is returned.
vec3 NormalFromDepth(ivec2 p, float depth, vec3 position, vec3 eye)
{
    vec3 toEye = normalize(eye - position);
    float dxp = FetchDepth(p + ivec2(1, 0));
    float dxn = FetchDepth(p - ivec2(1, 0));
    float dyp = FetchDepth(p + ivec2(0, 1));
    float dyn = FetchDepth(p - ivec2(0, 1));
    float errXp = dxp >= kSkyDepth ? 1e6 : abs(dxp - depth);
    float errXn = dxn >= kSkyDepth ? 1e6 : abs(depth - dxn);
    float errYp = dyp >= kSkyDepth ? 1e6 : abs(dyp - depth);
    float errYn = dyn >= kSkyDepth ? 1e6 : abs(depth - dyn);
    if (min(errXp, errXn) > 1e5 || min(errYp, errYn) > 1e5) {
        return toEye;
    }

    vec3 dx = errXp < errXn ? WorldAt(p + ivec2(1, 0), dxp) - position : position - WorldAt(p - ivec2(1, 0), dxn);
    vec3 dy = errYp < errYn ? WorldAt(p + ivec2(0, 1), dyp) - position : position - WorldAt(p - ivec2(0, 1), dyn);

    // Normalize before the cross product: two tiny vectors must not hit a fixed epsilon.
    float lx = length(dx);
    float ly = length(dy);
    if (lx < 1e-7 || ly < 1e-7) {
        return toEye;
    }
    vec3 n = cross(dx / lx, dy / ly);
    float len = length(n);
    if (len < 1e-3) {
        return toEye;
    }
    n /= len;
    return dot(n, toEye) < 0.0 ? -n : n;
}

// Input is clamped, so rounding can not push the sqrt argument below zero.
float FastAcos(float x)
{
    float ax = min(abs(x), 1.0);
    float res = (-0.156583 * ax + kHalfPi) * sqrt(max(1.0 - ax, 0.0));
    return x >= 0.0 ? res : kPi - res;
}

float InterleavedGradientNoise(vec2 pixel)
{
    return fract(52.9829189 * fract(dot(pixel, vec2(0.06711056, 0.00583715))));
}

// Updates the horizon cosine of one side from the occluder at depth pixel `p`.
float UpdateHorizon(float horizonCos, float lowCos, ivec2 p, vec3 P, vec3 V)
{
    if (!OnScreen(p)) {
        return horizonCos;
    }
    float d = FetchDepth(p);
    if (d >= kSkyDepth) {
        return horizonCos;
    }
    vec3 delta = WorldAt(p, d) - params.eyeAndPixelScale.xyz - P;
    float dist = max(length(delta), 1e-5);
    float w = clamp(dist * params.downAndFalloffMul.w + params.forwardAndFalloffAdd.w, 0.0, 1.0);
    if (w <= 0.0) {
        return horizonCos;
    }
    float shc = mix(lowCos, dot(delta / dist, V), w);
    return shc > horizonCos ? shc : mix(horizonCos, shc, params.tuning.y);
}

void main()
{
    ivec2 aoSize = imageSize(aoOutput);
    ivec2 aoPixel = ivec2(gl_GlobalInvocationID.xy);
    if (aoPixel.x >= aoSize.x || aoPixel.y >= aoSize.y) {
        return;
    }

    // AO texel i reads depth pixel i * divisor.
    gDepthSize = textureSize(sceneDepth, 0);
    ivec2 pixel = min(aoPixel * int(params.counts.w), gDepthSize - ivec2(1));
    float depth = FetchDepth(pixel);
    if (depth >= kSkyDepth) {
        imageStore(aoOutput, aoPixel, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    vec3 eye = params.eyeAndPixelScale.xyz;
    vec3 right = params.rightAndRadius.xyz;
    vec3 down = params.downAndFalloffMul.xyz;
    vec3 forward = params.forwardAndFalloffAdd.xyz;
    float radius = params.rightAndRadius.w;

    vec3 worldPos = WorldAt(pixel, depth);
    vec3 P = worldPos - eye;
    float viewZ = dot(P, forward);
    vec3 V = normalize(-P);
    vec3 N = NormalFromDepth(pixel, depth, worldPos, eye);

    float screenRadius = min(radius / max(viewZ * params.eyeAndPixelScale.w, 1e-6), params.distanceFade.z);
    float fadeSmall = clamp((screenRadius - kMinScreenRadius) / 4.0, 0.0, 1.0);
    if (fadeSmall <= 0.0) {
        imageStore(aoOutput, aoPixel, vec4(1.0, viewZ, 0.0, 0.0));
        return;
    }

    vec2 noiseBase = vec2(pixel) + 5.588238 * float(params.counts.z & 63u);
    float noiseSlice = InterleavedGradientNoise(noiseBase);
    float noiseSample = InterleavedGradientNoise(noiseBase.yx + vec2(17.0, 31.0));

    int sliceCount = int(params.counts.x);
    int stepCount = int(params.counts.y);
    float distribution = params.tuning.z;
    float minS = kMinScreenRadius / max(screenRadius, 1.0);

    float visibility = 0.0;
    for (int slice = 0; slice < sliceCount; ++slice) {
        float phi = (float(slice) + noiseSlice) / float(sliceCount) * kPi;
        vec2 omega = vec2(cos(phi), sin(phi));
        vec3 dir3 = omega.x * right + omega.y * down;
        vec3 orthoDir = dir3 - dot(dir3, V) * V;
        vec3 axis = normalize(cross(orthoDir, V));
        vec3 projN = N - axis * dot(N, axis);
        float projLen = max(length(projN), 1e-5);
        float signNorm = sign(dot(orthoDir, projN));
        float cosNorm = clamp(dot(projN, V) / projLen, 0.0, 1.0);
        float n = signNorm * FastAcos(cosNorm);

        float lowCos0 = cos(n + kHalfPi);
        float lowCos1 = cos(n - kHalfPi);
        float hCos0 = lowCos0;
        float hCos1 = lowCos1;
        float stepNoise = fract(noiseSample + float(slice) * float(stepCount) * 0.6180339887);

        for (int j = 0; j < stepCount; ++j) {
            float t = (float(j) + stepNoise) / float(stepCount);
            t = pow(t, distribution) + minS;
            ivec2 offset = ivec2(round(t * screenRadius * omega));
            hCos0 = UpdateHorizon(hCos0, lowCos0, pixel + offset, P, V);
            hCos1 = UpdateHorizon(hCos1, lowCos1, pixel - offset, P, V);
        }

        float h0 = -FastAcos(clamp(hCos1, -1.0, 1.0));
        float h1 = FastAcos(clamp(hCos0, -1.0, 1.0));
        h0 = n + clamp(h0 - n, -kHalfPi, kHalfPi);
        h1 = n + clamp(h1 - n, -kHalfPi, kHalfPi);
        float iarc0 = (cosNorm + 2.0 * h0 * sin(n) - cos(2.0 * h0 - n)) * 0.25;
        float iarc1 = (cosNorm + 2.0 * h1 * sin(n) - cos(2.0 * h1 - n)) * 0.25;
        visibility += projLen * (iarc0 + iarc1);
    }

    visibility = clamp(visibility / float(sliceCount), 0.0, 1.0);
    visibility = max(pow(visibility, params.tuning.x), params.tuning.w);
    visibility = mix(1.0, visibility, fadeSmall);
    visibility = mix(visibility, 1.0, smoothstep(params.distanceFade.x, params.distanceFade.y, viewZ));
    if (isnan(visibility)) {
        visibility = 1.0;
    }
    imageStore(aoOutput, aoPixel, vec4(visibility, viewZ, 0.0, 0.0));
}
