#version 450
layout(local_size_x = 8, local_size_y = 8) in;

// Member names and order match fx::TemporalResolveParamsGpu.
layout(std430, binding = 0) readonly buffer GtaoResolveParams {
    mat4 invViewProjection;
    mat4 prevViewProjection;
    vec4 eye;
    vec4 forward;
    vec4 prevEye;
    vec4 prevForward;
    vec4 filterParams; // x depth sigma, y history weight, z history depth tolerance, w spatial on.
    uvec4 counts;      // x divisor, y history valid, z depth width, w depth height.
} params;

layout(binding = 1) uniform sampler2D aoRaw;     // x visibility, y view depth (0 = sky).
layout(binding = 2) uniform sampler2D aoHistory; // Previous result, same layout.
layout(binding = 3, rgba16f) uniform writeonly image2D aoOutput;

#include "ScreenSpaceCommon.glsl"

// Previous-frame AO at the world point this texel sees: x = filtered value, y = bilinear coverage.
vec2 ReprojectHistory(ivec2 p, float viewZ, float tolerance)
{
    vec2 t;
    float prevZ;
    if (!ReprojectToHistory(params.invViewProjection, params.prevViewProjection, params.eye.xyz, params.forward.xyz,
            params.prevEye.xyz, params.prevForward.xyz, p, float(params.counts.x), vec2(params.counts.zw), viewZ, t,
            prevZ)) {
        return vec2(0.0);
    }
    ivec2 base = ivec2(floor(t));
    vec2 f = fract(t);
    ivec2 histSize = textureSize(aoHistory, 0);
    float sum = 0.0;
    float weightSum = 0.0;
    for (int i = 0; i < 4; ++i) {
        ivec2 o = ivec2(i & 1, i >> 1);
        ivec2 q = base + o;
        if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, histSize))) {
            continue;
        }
        vec2 h = texelFetch(aoHistory, q, 0).rg;
        float bilinear = (o.x == 1 ? f.x : 1.0 - f.x) * (o.y == 1 ? f.y : 1.0 - f.y);
        float relative = abs(h.y - prevZ) / prevZ;
        float valid = h.y > 0.0 ? 1.0 - smoothstep(0.5 * tolerance, tolerance, relative) : 0.0;
        sum += h.x * bilinear * valid;
        weightSum += bilinear * valid;
    }
    return weightSum > 0.0 ? vec2(sum / weightSum, weightSum) : vec2(0.0);
}

void main()
{
    ivec2 size = imageSize(aoOutput);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) {
        return;
    }

    ivec2 rawSize = textureSize(aoRaw, 0);
    vec2 center = texelFetch(aoRaw, min(p, rawSize - ivec2(1)), 0).rg;
    if (center.y <= 0.0) {
        imageStore(aoOutput, p, vec4(1.0, 0.0, 0.0, 0.0));
        return;
    }

    // 3x3 cross-bilateral filter; the min and max of the footprint also bound the history.
    float depthTolerance = max(center.y * params.filterParams.x, 1e-4);
    bool spatial = params.filterParams.w > 0.5;
    float sum = 0.0;
    float weightSum = 0.0;
    float lo = center.x;
    float hi = center.x;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec2 s = texelFetch(aoRaw, clamp(p + ivec2(dx, dy), ivec2(0), rawSize - ivec2(1)), 0).rg;
            if (s.y <= 0.0) {
                continue;
            }
            lo = min(lo, s.x);
            hi = max(hi, s.x);
            bool isCenter = dx == 0 && dy == 0;
            float kernel = isCenter ? 4.0 : ((dx == 0 || dy == 0) ? 2.0 : 1.0);
            if (!spatial && !isCenter) {
                kernel = 0.0;
            }
            float w = kernel * exp(-abs(s.y - center.y) / depthTolerance);
            sum += s.x * w;
            weightSum += w;
        }
    }
    float result = sum / max(weightSum, 1e-5);

    if (params.counts.y != 0u && params.filterParams.y > 0.0) {
        vec2 history = ReprojectHistory(p, center.y, params.filterParams.z);
        if (history.y > 0.25) {
            result = mix(result, clamp(history.x, lo, hi), params.filterParams.y * min(history.y, 1.0));
        }
    }
    if (isnan(result)) {
        result = 1.0;
    }
    imageStore(aoOutput, p, vec4(result, center.y, 0.0, 0.0));
}
