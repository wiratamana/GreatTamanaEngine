#version 450

// Adds the 3x3 tent-filtered smaller mip to the mip of this level and scales the sum.
layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    vec4 scaleAndPad; // x output scale, yzw reserved
} pc;

layout(binding = 0) uniform sampler2D sourceCurrent;
layout(binding = 1) uniform sampler2D sourceLower;
layout(binding = 2, rgba16f) uniform writeonly image2D destinationImage;

void main()
{
    ivec2 outSize = imageSize(destinationImage);
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x >= outSize.x || texel.y >= outSize.y) {
        return;
    }
    vec2 uv = (vec2(texel) + 0.5) / vec2(outSize);
    vec2 t = 1.0 / vec2(textureSize(sourceLower, 0));

    vec3 tent = texture(sourceLower, uv).rgb * 4.0;
    tent += (texture(sourceLower, uv + t * vec2(-1.0, 0.0)).rgb + texture(sourceLower, uv + t * vec2(1.0, 0.0)).rgb
        + texture(sourceLower, uv + t * vec2(0.0, -1.0)).rgb + texture(sourceLower, uv + t * vec2(0.0, 1.0)).rgb) * 2.0;
    tent += texture(sourceLower, uv + t * vec2(-1.0, -1.0)).rgb + texture(sourceLower, uv + t * vec2(1.0, -1.0)).rgb
        + texture(sourceLower, uv + t * vec2(-1.0, 1.0)).rgb + texture(sourceLower, uv + t * vec2(1.0, 1.0)).rgb;
    tent *= 1.0 / 16.0;

    vec3 result = (texture(sourceCurrent, uv).rgb + tent) * pc.scaleAndPad.x;
    imageStore(destinationImage, texel, vec4(result, 1.0));
}
