#version 450

// Culls 16 m grass chunks (distance, tile data, water, frustum, Hi-Z) and packs surviving blades per LOD.
// Dispatch gridCells * gridCells * extra.w groups after GrassInit.comp; extra.w groups share each chunk.
#include "GrassCommon.glsl"
#include "ClusterCullConstants.glsl"
#include "HizPyramidLayout.glsl"

layout(local_size_x = 64) in;

// Height tile: one uvec2 per texel = (float bits of the terrain height, bit 24 submerged | terrain colour r | g << 8 | b << 16);
// row-major, tile.w texels per side. NOTE: must match kGrassTileStride in GrassTypes.h.
layout(std430, binding = 1) readonly buffer GrassHeightTileBlock {
    uvec2 texels[];
} heightTile;

layout(std430, binding = 2) writeonly buffer GrassInstancesBlock {
    GrassInstance items[];
} instances;

// 6 x {vertexCount, instanceCount, firstVertex, firstInstance} (3 colour + 3 shadow); instanceCount is updated atomically.
layout(std430, binding = 3) buffer GrassCommandsBlock {
    uint values[];
} commands;

layout(std430, binding = 4) buffer GrassStatsBlock {
    uint words[];
} stats;

// Farthest-depth pyramid atlas of this frame. Bind any 1x1 texture when kGrassFlagHiz is off.
layout(binding = 5) uniform sampler2D hizAtlas;

// Sun cascade and cloud shadow parameters. NOTE: must match GrassShadowParamsGpu in GrassTypes.h (448 bytes).
layout(std430, binding = 6) readonly buffer GrassShadowBlock {
    mat4 cascadeViewProjection[4];
    vec4 cascadeSplitFar;
    vec4 cascadeBlendWidth;
    vec4 cascadeTexelWorld;
    vec4 cascadeDepthRange;
    vec4 eyeAndFadeStart;
    vec4 forwardAndFadeEnd;
    vec4 shadowParams;
    vec4 biasExtra;
    uvec4 counts;
    vec4 cloudGrid;
    vec4 cloudLayer;
    vec4 cloudSun;
} shadow;

layout(binding = 7) uniform sampler2D shadowDepth0;
layout(binding = 8) uniform sampler2D shadowDepth1;
layout(binding = 9) uniform sampler2D shadowDepth2;
layout(binding = 10) uniform sampler2D shadowDepth3;
layout(binding = 11) uniform sampler2D cloudShadowMap;

// Per-invocation slope-aware bias (texels), read by ORTHO_BIAS_TEXELS inside OrthoMapSetVisibility().
float gShadowBiasTexels = 0.0;

float OrthoMapDepthAt(int k, vec2 uv)
{
    switch (k) {
    case 0: return textureLod(shadowDepth0, uv, 0.0).r;
    case 1: return textureLod(shadowDepth1, uv, 0.0).r;
    case 2: return textureLod(shadowDepth2, uv, 0.0).r;
    default: return textureLod(shadowDepth3, uv, 0.0).r;
    }
}

#define ORTHO_VIEW_PROJECTION(k) shadow.cascadeViewProjection[k]
#define ORTHO_SPLIT_FAR(k) shadow.cascadeSplitFar[k]
#define ORTHO_BLEND_WIDTH(k) shadow.cascadeBlendWidth[k]
#define ORTHO_TEXEL_WORLD(k) shadow.cascadeTexelWorld[k]
#define ORTHO_DEPTH_RANGE(k) shadow.cascadeDepthRange[k]
#define ORTHO_EYE shadow.eyeAndFadeStart.xyz
#define ORTHO_FORWARD shadow.forwardAndFadeEnd.xyz
#define ORTHO_COUNT shadow.counts.x
#define ORTHO_TAPS shadow.counts.y
#define ORTHO_BIAS_TEXELS gShadowBiasTexels
#define ORTHO_FILTER_TEXELS shadow.shadowParams.z
#define ORTHO_INV_MAP_SIZE shadow.shadowParams.w

#include "OrthoMapSetVisibility.glsl"
#include "CloudShadowLookup.glsl"

// Combined cascade and cloud sun visibility at the blade root in [0, 1].
float GrassSunVisibility(vec3 world, vec3 normal, float rnd)
{
    float vis = 1.0;
    int count = clamp(int(shadow.counts.x), 0, 4);
    float strength = shadow.shadowParams.x;
    if (count > 0 && strength > 0.0) {
        float fadeStart = shadow.eyeAndFadeStart.w;
        float fadeEnd = shadow.forwardAndFadeEnd.w;
        float viewDepth = dot(world - shadow.eyeAndFadeStart.xyz, shadow.forwardAndFadeEnd.xyz);
        if (viewDepth < fadeEnd) {
            int c = count - 1;
            for (int i = 0; i < count; ++i) {
                if (viewDepth < shadow.cascadeSplitFar[i]) {
                    c = i;
                    break;
                }
            }
            float texel = shadow.cascadeTexelWorld[c];
            vec3 sunDir = length(params.sunDir.xyz) > 1e-6 ? normalize(params.sunDir.xyz) : vec3(0.0, 1.0, 0.0);
            float nDotL = clamp(dot(normal, sunDir), 0.0, 1.0);
            float tanTheta = clamp(sqrt(max(1.0 - nDotL * nDotL, 0.0)) / max(nDotL, 0.05), 0.0, 10.0);
            gShadowBiasTexels = shadow.shadowParams.y + shadow.biasExtra.x * tanTheta;
            vec3 offsetWorld = world + normal * (shadow.biasExtra.y * texel) + sunDir * (shadow.biasExtra.z * texel);
            float visCascade = OrthoMapSetVisibility(offsetWorld, rnd * 6.2831853);
            float fadeSpan = max(fadeEnd - fadeStart, 1e-4);
            float distanceFade = 1.0 - smoothstep(0.0, 1.0, clamp((viewDepth - fadeStart) / fadeSpan, 0.0, 1.0));
            vis = 1.0 - strength * (1.0 - visCascade) * distanceFade;
        }
    }
    if (shadow.cloudGrid.w > 0.0) {
        vis *= CloudSunTransmittanceFast(cloudShadowMap, shadow.cloudGrid, shadow.cloudLayer, shadow.cloudSun.xyz, world);
    }
    return clamp(vis, 0.0, 1.0);
}

shared float sMin[64];
shared float sMax[64];
shared float sLand[64];
shared uint sCount[3];
shared uint sBase[3];

// Per-chunk values, set before the blade loop.
vec2 gChunkLoGrid;   // Grid-relative xz of the chunk corner.
vec2 gChunkWorldLo;  // World xz of the chunk corner.
uint gSeed;
uint gOffX;
uint gOffY;

const uint kRejectNone = 0u;
const uint kRejectNoData = 1u;
const uint kRejectLod = 2u;
const uint kRejectWater = 3u;
const uint kRejectSlope = 4u;
const uint kRejectNoise = 5u;

bool HasFlag(uint flag)
{
    return (uint(params.grid.w) & flag) != 0u;
}

// Candidates of a chunk at a density; a tiny density counts as none.
uint CandidateCount(float density)
{
    float cs = params.camRel.w;
    return uint(max(ceil(density * cs * cs - 0.05), 0.0));
}

struct TileSample {
    float height;
    float flag;
    vec2 gradient; // d height / dx, d height / dz.
};

vec3 UnpackTileColor(uint bits)
{
    return vec3(float(bits & 255u), float((bits >> 8u) & 255u), float((bits >> 16u) & 255u)) * (1.0 / 255.0);
}

// Bilinear height, submerged flag (max of the 4 texels) and the exact bilinear gradient. False outside the tile.
bool SampleTile(vec2 gridXz, out TileSample s)
{
    int n = int(params.tile.w);
    float ts = params.tile.z;
    vec2 q = (gridXz - params.tile.xy) / ts;
    s.height = 0.0;
    s.flag = 1.0;
    s.gradient = vec2(0.0);
    if (q.x < 0.0 || q.y < 0.0 || q.x >= float(n - 1) || q.y >= float(n - 1)) {
        return false;
    }
    ivec2 i0 = ivec2(floor(q));
    vec2 f = q - vec2(i0);
    int index = i0.y * n + i0.x;
    uvec2 a = heightTile.texels[index];
    uvec2 b = heightTile.texels[index + 1];
    uvec2 c = heightTile.texels[index + n];
    uvec2 d = heightTile.texels[index + n + 1];
    float ha = uintBitsToFloat(a.x);
    float hb = uintBitsToFloat(b.x);
    float hc = uintBitsToFloat(c.x);
    float hd = uintBitsToFloat(d.x);
    s.height = mix(mix(ha, hb, f.x), mix(hc, hd, f.x), f.y);
    s.flag = float(((a.y | b.y | c.y | d.y) >> 24u) & 1u);
    s.gradient.x = mix(hb - ha, hd - hc, f.y) / ts;
    s.gradient.y = mix(hc - ha, hd - hb, f.x) / ts;
    return true;
}

// Terrain colour at a point inside the tile (call it for accepted blades only).
vec3 SampleTileColor(vec2 gridXz)
{
    int n = int(params.tile.w);
    vec2 q = (gridXz - params.tile.xy) / params.tile.z;
    ivec2 i0 = clamp(ivec2(floor(q)), ivec2(0), ivec2(n - 2));
    vec2 f = clamp(q - vec2(i0), vec2(0.0), vec2(1.0));
    int index = i0.y * n + i0.x;
    vec3 a = UnpackTileColor(heightTile.texels[index].y);
    vec3 b = UnpackTileColor(heightTile.texels[index + 1].y);
    vec3 c = UnpackTileColor(heightTile.texels[index + n].y);
    vec3 d = UnpackTileColor(heightTile.texels[index + n + 1].y);
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// True when the box (nearest view distance, nearest depth) lies behind the farthest depth of the pyramid texel.
bool IsBehind(float nearestW, float farthest)
{
    if (!(farthest < 1.0)) {
        return false; // Clear depth: a pixel of the block was never drawn.
    }
    float k = params.depthMap.x;
    float b = params.depthMap.y;
    float denominator = (farthest + kHizDepthGuard) - k;
    if (!(denominator * b > 0.0)) {
        return false;
    }
    float farthestW = b / denominator;
    return nearestW > farthestW * (1.0 + kHizRelMargin) + kHizAbsMargin;
}

// Hi-Z test of an eye-relative box. Mirrors Occluded() of ClusterCull.comp.
bool BoxOccluded(vec3 boxMin, vec3 boxMax)
{
    uvec2 base = uvec2(params.hiz.zw);
    if (base.x == 0u || base.y == 0u) {
        return false;
    }
    vec2 ndcMin = vec2(0.0);
    vec2 ndcMax = vec2(0.0);
    float nearestW = 0.0;
    for (int i = 0; i < 8; ++i) {
        vec3 corner = vec3((i & 1) != 0 ? boxMax.x : boxMin.x, (i & 2) != 0 ? boxMax.y : boxMin.y,
            (i & 4) != 0 ? boxMax.z : boxMin.z);
        vec4 clip = params.viewProjection * vec4(corner, 1.0);
        if (!(clip.w > 1e-6)) {
            return false; // A corner is behind the eye: keep.
        }
        vec3 ndc = clip.xyz / clip.w;
        if (any(isnan(ndc)) || any(isinf(ndc))) {
            return false;
        }
        ndcMin = i == 0 ? ndc.xy : min(ndcMin, ndc.xy);
        ndcMax = i == 0 ? ndc.xy : max(ndcMax, ndc.xy);
        nearestW = i == 0 ? clip.w : min(nearestW, clip.w);
    }
    ndcMin = max(ndcMin, vec2(-1.0));
    ndcMax = min(ndcMax, vec2(1.0));
    if (any(greaterThan(ndcMin, ndcMax))) {
        return false;
    }
    vec2 baseSize = vec2(base);
    vec2 rectMin = clamp((ndcMin * 0.5 + 0.5) * baseSize - kHizRectMarginTexels, vec2(0.0), baseSize);
    vec2 rectMax = clamp((ndcMax * 0.5 + 0.5) * baseSize + kHizRectMarginTexels, vec2(0.0), baseSize);
    float extent = max(rectMax.x - rectMin.x, rectMax.y - rectMin.y);
    uint levelCount = uint(params.depthMap.z);
    uint level = 0u;
    while (level + 1u < levelCount && float(1u << level) < extent) {
        ++level;
    }
    uvec2 origin = HizLevelOrigin(base, level);
    uvec2 size = HizLevelSize(base, level);
    float scale = 1.0 / float(1u << level);
    uvec2 lo = min(uvec2(floor(rectMin * scale)), size - 1u);
    uvec2 hi = min(uvec2(floor(rectMax * scale)), size - 1u);
    float farthest = texelFetch(hizAtlas, ivec2(origin + lo), 0).r;
    farthest = max(farthest, texelFetch(hizAtlas, ivec2(origin + uvec2(hi.x, lo.y)), 0).r);
    farthest = max(farthest, texelFetch(hizAtlas, ivec2(origin + uvec2(lo.x, hi.y)), 0).r);
    farthest = max(farthest, texelFetch(hizAtlas, ivec2(origin + hi), 0).r);
    return IsBehind(nearestW, farthest);
}

// Conservative: rejects only a box fully behind one plane.
bool BoxOutsideFrustum(vec3 boxMin, vec3 boxMax)
{
    vec3 c = 0.5 * (boxMin + boxMax);
    vec3 e = 0.5 * (boxMax - boxMin);
    for (int p = 0; p < 6; ++p) {
        vec3 normal = params.planes[p].xyz;
        if (dot(normal, c) + params.planes[p].w + dot(abs(normal), e) < 0.0) {
            return true;
        }
    }
    return false;
}

// Places candidate `idx` of the current chunk and filters it. Returns a kReject* code (0 = accepted).
// Lower densities are index prefixes of higher ones, so a blade only disappears at a density step.
uint EvalBlade(uint idx, out uint lod, out GrassInstance result)
{
    lod = 3u;
    result = GrassInstance(vec3(0.0), 0u, 0u, 0u, 0u, 0u);
    uint hb = GrassHash2(gSeed, idx);

    // R2 low-discrepancy sequence in 32-bit fixed point: every prefix covers the chunk evenly.
    vec2 u = vec2(float((gOffX + idx * 0xC13FA9A9u) >> 8u), float((gOffY + idx * 0x91E10DA5u) >> 8u)) * (1.0 / 16777216.0);
    vec2 local = u * params.camRel.w;
    vec2 pg = gChunkLoGrid + local;

    TileSample ts;
    if (!SampleTile(pg, ts)) {
        return kRejectNoData;
    }
    vec3 eye = vec3(pg.x - params.camRel.x, ts.height - params.camRel.y, pg.y - params.camRel.z);
    float dist = length(eye);
    if (dist >= params.lodDist.z) {
        return kRejectLod;
    }
    lod = dist < params.lodDist.x ? 0u : (dist < params.lodDist.y ? 1u : 2u);
    float logDensity = GrassLogDensityAt(dist);
    float localDensity = params.densityLog.w > 0.5 ? exp(logDensity) : 0.0;
    if (idx >= CandidateCount(localDensity)) {
        lod = 3u;
        return kRejectLod;
    }

    float waterTop = params.water.x + params.water.y;
    if (ts.flag > 0.5 || ts.height <= waterTop) {
        lod = 3u;
        return kRejectWater;
    }
    vec3 normal = normalize(vec3(-ts.gradient.x, 1.0, -ts.gradient.y));
    float slopeDeg = degrees(acos(clamp(normal.y, 0.0, 1.0)));
    if (slopeDeg > params.slope.x) {
        lod = 3u;
        return kRejectSlope;
    }

    // Density modulation: low-frequency patches, slope edge, waterline edge and the far edge. All stable per blade.
    vec2 worldXz = gChunkWorldLo + local;
    float scale = max(params.slope.z, 1.0);
    float nz = 0.65 * GrassValueNoise(worldXz / scale) + 0.35 * GrassValueNoise(worldXz / (scale * 0.37) + vec2(17.3, 5.9));
    float patchMask = smoothstep(params.slope.w - 0.1, params.slope.w + 0.15, nz);
    float m = mix(1.0, mix(params.variety.y, 1.0, patchMask), params.density.w);
    m *= 1.0 - smoothstep(params.slope.x - max(params.slope.y, 0.01), params.slope.x, slopeDeg);
    m *= smoothstep(waterTop, waterTop + max(params.water.z, 1e-3), ts.height);
    m *= smoothstep(params.water.x + params.water.w, params.water.x + params.water.w + 3.0, ts.height);
    m *= 1.0 - smoothstep(params.cameraWorld.z, params.cameraWorld.z + max(params.cameraWorld.w, 1e-3), ts.height);
    float edgeStart = params.lodDist.z * (1.0 - clamp(params.lodDist.w, 0.01, 1.0));
    m *= 1.0 - smoothstep(edgeStart, params.lodDist.z, dist);
    if (GrassUnit(GrassHash2(hb, 0x1234u)) >= m) {
        lod = 3u;
        return kRejectNoise;
    }

    // Break the R2 quasi-lattice using candidate-intrinsic spacing so world roots never drift with camera motion.
    float candDensity = max(float(idx + 1u) / (params.camRel.w * params.camRel.w), 0.5);
    float jr = min(params.variety2.z * inversesqrt(candDensity), 0.75);
    vec2 jit = (vec2(GrassUnit(GrassHash2(hb, 11u)), GrassUnit(GrassHash2(hb, 12u))) - 0.5) * (2.0 * jr);

    // Tuft clumping on a 0.55 m lattice: pull roots toward tuft centres, share tuft height/tint and lean outward.
    vec2 wxz = worldXz + jit;
    ivec2 cc = ivec2(floor(wxz / 0.55));
    vec2 cJit = vec2(GrassCellHash(cc), GrassCellHash(cc + ivec2(7, 13)));
    vec2 centre = (vec2(cc) + 0.2 + 0.6 * cJit) * 0.55;
    float clumpStr = params.variety.x;
    float clumpActive = clamp(clumpStr / 0.6, 0.0, 1.0);
    vec2 shifted = mix(wxz, centre, 0.55 * clumpStr);
    vec2 deltaXz = shifted - worldXz;
    if (dot(deltaXz, deltaXz) > 1e-8) {
        vec2 pgShifted = gChunkLoGrid + local + deltaXz;
        TileSample tsShifted;
        if (SampleTile(pgShifted, tsShifted) && tsShifted.flag <= 0.5 && tsShifted.height > waterTop) {
            local += deltaXz;
            pg = pgShifted;
            ts = tsShifted;
            normal = normalize(vec3(-ts.gradient.x, 1.0, -ts.gradient.y));
            eye = vec3(pg.x - params.camRel.x, ts.height - params.camRel.y, pg.y - params.camRel.z);
        }
    }
    uint cid = GrassHash2(uint(cc.x), uint(cc.y));
    float cHeight = mix(1.0, mix(0.75, 1.2, GrassUnit(cid)), clumpActive);
    float cTint = mix(0.5, GrassUnit(GrassPcg(cid ^ 0x51ED270Bu)), clumpActive);
    vec2 toBlade = (gChunkWorldLo + local) - centre;
    vec2 outward = dot(toBlade, toBlade) > 1e-8 ? normalize(toBlade) : vec2(0.0);

    float r1 = GrassUnit(GrassHash2(hb, 1u));
    float r2 = GrassUnit(GrassHash2(hb, 2u));
    float r3 = GrassUnit(GrassHash2(hb, 3u));
    float r4 = GrassUnit(GrassHash2(hb, 4u));
    float r5 = GrassUnit(GrassHash2(hb, 5u));
    float farShrink = 1.0 - smoothstep(params.lodDist.z * (1.0 - params.extra.y), params.lodDist.z, dist);
    float poorSoilScale = clamp(params.variety.y / 0.22, 0.0, 1.0) * smoothstep(0.0, 0.2, params.density.w);
    float patchHeight = mix(1.0, mix(0.45, 1.0, patchMask), poorSoilScale);
    float height = params.blade.x * (1.0 + params.blade.w * (2.0 * r1 - 1.0)) * (0.85 + 0.3 * nz) * cHeight * patchHeight * farShrink;
    // Thinned blades widen so the cover stays even.
    float widthScale = min(exp(params.bladeB.y * max(params.densityLog.x - logDensity, 0.0)), params.bladeB.z);
    float width = params.blade.y * (0.8 + 0.4 * r2) * widthScale;
    float lean = params.bladeB.x * (0.3 + 0.7 * r4);

    // Blade species: rare flowers, broadleaf rosette weeds and dry straw blades.
    float patchDry = 1.0 - patchMask;
    float kind = GrassUnit(GrassHash2(hb, 21u));
    float flowerShare = params.variety2.x;
    float weedShare = params.variety.z;
    float dryShare = params.variety.w;
    bool isFlower = kind < flowerShare;
    bool isWeed = !isFlower && (kind < flowerShare + weedShare);
    bool isDry = !isFlower && !isWeed && (kind > 1.0 - dryShare * (0.4 + patchDry));
    if (isWeed) {
        width *= 2.2;
        height *= 0.5;
    } else if (isDry) {
        height *= 0.8;
    } else if (isFlower) {
        height *= 1.05;
        lean *= 0.65;
    }

    // Wind: slow wave plus gusts at a pattern position that drifts with the shared wind offset.
    float yaw = r3 * 6.2831853;
    vec2 faceXz = vec2(sin(yaw), cos(yaw));
    vec2 pattern = params.cameraWorld.xy + eye.xz + params.wind1.yz;
    vec2 windDir = params.wind0.xy;
    float speedFactor = 1.0 - exp(-0.25 * params.wind0.z);
    float wave = 0.5 + 0.5 * sin(dot(pattern, windDir) * (6.2831853 / max(params.wind2.z, 1.0)));
    float gust = params.wind1.x * GrassValueNoise(pattern / max(params.wind2.w, 1.0));
    float windAngle = 0.6 * params.wind1.w * speedFactor * (0.25 + 0.5 * wave + 0.9 * gust);

    // Rest lean (plus outward tuft fountain lean) and wind push set the tip angle and bend direction.
    vec2 bend = faceXz * lean + outward * (0.25 * lean * clumpStr) + windDir * windAngle;
    if (isWeed) {
        bend *= 1.6;
    }
    float bendLength = length(bend);
    float extraDroop = isDry ? 0.25 : 0.0;
    float angle = min(bendLength + extraDroop, params.bladeB.w);
    vec2 bendDir = bendLength > 1e-4 ? bend / bendLength : faceXz;

    // Tip flutter: fast and small; the vertex shader scales it by t^2.
    float phase = r5 * 43.9823;
    float flutterTime = params.wind0.w * params.wind2.x;
    float flutterA = sin(flutterTime + phase + dot(pattern, vec2(0.9, 0.7)));
    float flutterB = sin(flutterTime * 1.37 + phase * 1.7);
    float flutterAmp = params.wind2.y * height * (0.04 + 0.12 * speedFactor * (0.5 + gust));

    float r6 = GrassUnit(GrassHash2(hb, 6u));
    vec3 worldRoot = vec3(params.cameraWorld.x + eye.x, params.camRel.y + eye.y, params.cameraWorld.y + eye.z);
    float sunVis = GrassSunVisibility(worldRoot, normal, r6);

    uvec3 rgb = uvec3(clamp(SampleTileColor(pg) * 255.0 + 0.5, vec3(0.0), vec3(255.0)));
    float meadowHue = abs(fract(nz * 2.1 + 0.15) * 2.0 - 1.0);
    float hueVal = clamp(0.45 * patchDry + 0.30 * meadowHue + 0.45 * cTint - 0.10, 0.0, 1.0);
    uint rnd4 = uint(clamp(r5 * 15.0 + 0.5, 0.0, 15.0));
    uint patch4 = uint(clamp(hueVal * float(kGrassPatchMax) + 0.5, 0.0, float(kGrassPatchMax)));
    if (isFlower) {
        patch4 = kGrassKindFlower;
    } else if (isDry) {
        patch4 = kGrassKindDry;
    } else if (isWeed) {
        patch4 = kGrassKindWeed;
    }
    result.root = eye;
    result.heightWidth = packHalf2x16(vec2(height, width));
    result.frame = packSnorm4x8(vec4(faceXz.x, faceXz.y, bendDir.x, bendDir.y));
    result.ground = packUnorm4x8(vec4(normal.x * 0.5 + 0.5, normal.z * 0.5 + 0.5, sin(angle), sunVis));
    result.flutter = packHalf2x16(vec2(flutterA * flutterAmp, flutterB * 0.6 * flutterAmp));
    result.colorRnd = (rgb.x << 24u) | (rgb.y << 16u) | (rgb.z << 8u) | (rnd4 << 4u) | patch4;
    return kRejectNone;
}

void main()
{
    uint lid = gl_LocalInvocationID.x;
    int dim = max(params.grid.z, 1);
    uint slices = max(uint(params.extra.w), 1u);
    uint chunkId = gl_WorkGroupID.x / slices;
    uint slice = gl_WorkGroupID.x % slices;
    if (chunkId >= uint(dim * dim)) {
        return;
    }
    bool collect = HasFlag(kGrassFlagStats);
    bool counter = collect && lid == 0u && slice == 0u; // The chunk-level counters count once per chunk.
    ivec2 cell = ivec2(int(chunkId) % dim, int(chunkId) / dim);
    float cs = params.camRel.w;
    if (counter) {
        atomicAdd(stats.words[kStatChunksInGrid], 1u);
    }

    // 1. Horizontal distance: far chunks leave before any tile read.
    vec2 lo2 = vec2(cell) * cs - params.camRel.xz;
    vec2 nearXz = max(max(lo2, -(lo2 + cs)), vec2(0.0));
    if (length(nearXz) >= params.lodDist.z) {
        if (counter) { atomicAdd(stats.words[kStatChunksCulledDistance], 1u); }
        return;
    }

    // Groups past the chunk's candidates have nothing to do (the horizontal distance gives a density that is never too low).
    if (slice * 256u >= CandidateCount(GrassDensityAt(length(nearXz)))) {
        return;
    }

    // 2. Tile coverage.
    int n = int(params.tile.w);
    float ts = params.tile.z;
    vec2 gridLo = vec2(cell) * cs;
    vec2 q0 = (gridLo - params.tile.xy) / ts;
    vec2 q1 = (gridLo + cs - params.tile.xy) / ts;
    if (n < 2 || q1.x < 0.0 || q1.y < 0.0 || q0.x > float(n - 1) || q0.y > float(n - 1)) {
        if (counter) { atomicAdd(stats.words[kStatChunksCulledNoData], 1u); }
        return;
    }

    // 3. Height range of the chunk from the tile (and the highest dry texel).
    int x0 = clamp(int(floor(q0.x)), 0, n - 1);
    int x1 = clamp(int(ceil(q1.x)), 0, n - 1);
    int z0 = clamp(int(floor(q0.y)), 0, n - 1);
    int z1 = clamp(int(ceil(q1.y)), 0, n - 1);
    int countX = x1 - x0 + 1;
    int total = countX * (z1 - z0 + 1);
    float mn = 1e30;
    float mx = -1e30;
    float land = -1e30;
    for (int k = int(lid); k < total; k += 64) {
        uvec2 t = heightTile.texels[(z0 + k / countX) * n + x0 + k % countX];
        float th = uintBitsToFloat(t.x);
        mn = min(mn, th);
        mx = max(mx, th);
        land = (t.y & 0x01000000u) == 0u ? max(land, th) : land;
    }
    sMin[lid] = mn;
    sMax[lid] = mx;
    sLand[lid] = land;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lid < stride) {
            sMin[lid] = min(sMin[lid], sMin[lid + stride]);
            sMax[lid] = max(sMax[lid], sMax[lid + stride]);
            sLand[lid] = max(sLand[lid], sLand[lid + stride]);
        }
        barrier();
    }
    float hMin = sMin[0];
    float hMax = sMax[0];
    float hLand = sLand[0];

    // 4. Water: no dry texel above the waterline means no grass here.
    if (hLand <= params.water.x + params.water.y) {
        if (counter) { atomicAdd(stats.words[kStatChunksCulledWater], 1u); }
        return;
    }

    // 5. 3D distance and LOD of the chunk (its nearest point). Blades pick their own LOD below.
    float maxBladeHeight = params.blade.x * (1.0 + params.blade.w) * mix(1.15, 1.25, clamp(params.variety.x / 0.6, 0.0, 1.0));
    vec3 boxMin = vec3(lo2.x, hMin - params.camRel.y, lo2.y);
    vec3 boxMax = vec3(lo2.x + cs, hMax + maxBladeHeight - params.camRel.y, lo2.y + cs);
    float dist = length(max(max(boxMin, -boxMax), vec3(0.0)));
    if (dist >= params.lodDist.z) {
        if (counter) { atomicAdd(stats.words[kStatChunksCulledDistance], 1u); }
        return;
    }
    uint lodMin = dist < params.lodDist.x ? 0u : (dist < params.lodDist.y ? 1u : 2u);
    float chunkDensity = GrassDensityAt(dist);

    // 6. Frustum (further padded when casting shadows) and Hi-Z with the box padded for blade lean, wind and jitter/clump shift.
    float shiftPad = min(params.variety2.z * 1.1, 0.85) + 0.30 * params.variety.x;
    float pad = 0.9 * maxBladeHeight + shiftPad;
    vec3 padMin = boxMin - vec3(pad, shiftPad, pad);
    vec3 padMax = boxMax + vec3(pad, shiftPad, pad);
    float shadowPad = max(params.groundAmbient.w, 0.0);
    if (BoxOutsideFrustum(padMin - vec3(shadowPad), padMax + vec3(shadowPad))) {
        if (counter) { atomicAdd(stats.words[kStatChunksCulledFrustum], 1u); }
        return;
    }
    if (HasFlag(kGrassFlagHiz) && BoxOccluded(padMin, padMax)) {
        if (counter) { atomicAdd(stats.words[kStatChunksCulledHiz], 1u); }
        return;
    }
    if (counter) {
        atomicAdd(stats.words[kStatChunksLod0 + lodMin], 1u);
    }

    // 7. Candidates of this chunk. The seed uses the world chunk index, so placement is stable while the grid scrolls.
    ivec2 worldChunk = params.grid.xy + cell;
    gChunkLoGrid = gridLo;
    gChunkWorldLo = vec2(worldChunk) * cs;
    gSeed = GrassHash3(uint(worldChunk.x), uint(worldChunk.y), params.misc.y);
    gOffX = GrassPcg(gSeed ^ 0xA511E9B3u);
    gOffY = GrassPcg(gSeed ^ 0x63D83595u);

    uint candidates = CandidateCount(chunkDensity);
    uint rejected[6] = uint[6](0u, 0u, 0u, 0u, 0u, 0u);
    uint accepted[3] = uint[3](0u, 0u, 0u);

    // 256 candidates per round (4 per thread); one slot reservation per LOD per round.
    for (uint base = slice * 256u; base < candidates; base += 256u * slices) {
        if (lid < 3u) {
            sCount[lid] = 0u;
        }
        barrier();

        uint lodOf[4];
        uint localSlot[4];
        GrassInstance made[4];
        for (uint j = 0u; j < 4u; ++j) {
            lodOf[j] = 3u;
            localSlot[j] = 0u;
            made[j] = GrassInstance(vec3(0.0), 0u, 0u, 0u, 0u, 0u);
            uint idx = base + lid + 64u * j;
            if (idx < candidates) {
                uint lod;
                GrassInstance blade;
                uint why = EvalBlade(idx, lod, blade);
                rejected[why] += 1u;
                if (why == kRejectNone) {
                    lodOf[j] = lod;
                    made[j] = blade;
                    localSlot[j] = atomicAdd(sCount[lod], 1u);
                    accepted[lod] += 1u;
                }
            }
        }
        barrier();

        if (lid < 3u) {
            uint wanted = sCount[lid];
            uint slot = 0u;
            if (wanted > 0u) {
                slot = atomicAdd(stats.words[kStatSlot0 + lid], wanted);
                uint cap = params.instanceCap[lid];
                uint granted = slot >= cap ? 0u : min(wanted, cap - slot);
                if (granted > 0u) {
                    atomicAdd(commands.values[lid * 4u + 1u], granted);
                    atomicAdd(commands.values[(lid + kGrassLodCount) * 4u + 1u], granted);
                }
                if (granted < wanted) {
                    atomicAdd(stats.words[kStatDropped0 + lid], wanted - granted);
                }
            }
            sBase[lid] = slot;
        }
        barrier();

        for (uint j = 0u; j < 4u; ++j) {
            uint lod = lodOf[j];
            if (lod < 3u) {
                uint slot = sBase[lod] + localSlot[j];
                if (slot < params.instanceCap[lod]) {
                    instances.items[params.instanceBase[lod] + slot] = made[j];
                }
            }
        }
    }

    if (collect) {
        // rejected[0] counts accepted blades; the rest are the reasons.
        atomicAdd(stats.words[kStatCandidates], rejected[0] + rejected[1] + rejected[2] + rejected[3] + rejected[4] + rejected[5]);
        atomicAdd(stats.words[kStatAccepted0], accepted[0]);
        atomicAdd(stats.words[kStatAccepted1], accepted[1]);
        atomicAdd(stats.words[kStatAccepted2], accepted[2]);
        atomicAdd(stats.words[kStatRejectNoData], rejected[1]);
        atomicAdd(stats.words[kStatRejectLod], rejected[2]);
        atomicAdd(stats.words[kStatRejectWater], rejected[3]);
        atomicAdd(stats.words[kStatRejectSlope], rejected[4]);
        atomicAdd(stats.words[kStatRejectNoise], rejected[5]);
    }
}
