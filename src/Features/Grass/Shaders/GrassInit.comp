#version 450

// Per frame, before the cull: zero the stats words and reset the six indirect draw commands (3 colour + 3 shadow).
#include "GrassCommon.glsl"

layout(local_size_x = 64) in;

layout(std430, binding = 1) writeonly buffer GrassCommandsBlock {
    uint values[];
} commands;

layout(std430, binding = 2) writeonly buffer GrassStatsBlock {
    uint words[];
} stats;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i < kGrassStatsWords) {
        stats.words[i] = 0u;
    }
    if (i < kGrassLodCount) {
        uint vertexCount = kGrassVertsList2;
        if (i == 0u) {
            vertexCount = uint(params.look.w) * 6u;
        } else if (i == 1u) {
            vertexCount = kGrassVertsList1;
        }
        uint colorBase = i * 4u;
        commands.values[colorBase + 0u] = vertexCount;
        commands.values[colorBase + 1u] = 0u;
        commands.values[colorBase + 2u] = 0u;
        commands.values[colorBase + 3u] = 0u;

        uint shadowBase = (i + kGrassLodCount) * 4u;
        commands.values[shadowBase + 0u] = kGrassVertsList2;
        commands.values[shadowBase + 1u] = 0u;
        commands.values[shadowBase + 2u] = 0u;
        commands.values[shadowBase + 3u] = 0u;
    }
}
