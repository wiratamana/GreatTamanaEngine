#version 450

// Parity fixture: writes a row-major float buffer into a single-channel float image.
layout(local_size_x = 8, local_size_y = 8) in;

layout(std430, binding = 0) readonly buffer SourceBlock {
    float values[];
} source;

layout(binding = 1, r32f) uniform writeonly image2D target;

layout(push_constant) uniform PushBlock {
    uint width;
    uint height;
} pc;

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    if (p.x >= pc.width || p.y >= pc.height) {
        return;
    }
    imageStore(target, ivec2(p), vec4(source.values[p.y * pc.width + p.x]));
}
