#version 450

// Buffer binding fixture: a read-only input, a write-only output and a read-write counter.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer InputBlock {
    uint values[];
} inputData;

layout(std430, set = 0, binding = 1) writeonly buffer OutputBlock {
    uint values[];
} outputData;

layout(std430, set = 0, binding = 2) buffer CounterBlock {
    uint value;
} counter;

layout(push_constant) uniform PushBlock {
    uint count;
} pc;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) {
        return;
    }
    outputData.values[i] = inputData.values[i] * 2u;
    atomicAdd(counter.value, 1u);
}
